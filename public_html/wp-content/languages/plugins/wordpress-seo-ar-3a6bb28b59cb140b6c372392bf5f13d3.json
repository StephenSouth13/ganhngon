u062c \u0645\u0639\u0631\u0641\u062a\u0647 \u062d\u0648\u0644 SEO."],"(Opens in a new browser tab)":["(\u064a\u0641\u062a\u062d \u0641\u064a \u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u0645\u062a\u0635\u0641\u062d \u062c\u062f\u064a\u062f\u0629)"],"24\/7 support":["\u062f\u0639\u0645 \u0639\u0644\u0649 \u0645\u062f\u0627\u0631 \u0627\u0644\u0633\u0627\u0639\u0629 24\/7"],"Close":["\u0625\u063a\u0644\u0627\u0642"]}},"comment":{"reference":"js\/dist\/support.js"}}