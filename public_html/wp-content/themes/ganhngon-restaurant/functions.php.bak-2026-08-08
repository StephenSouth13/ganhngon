function gn_render_social_row($with_label = true, $size = 22) {
    $socials = gn_social_icons($size);
    echo '<div class="gn-social-row">';
    foreach ($socials as $key => $s) {
        if (empty($s['href'])) continue; // bỏ qua kênh chưa tạo (href rỗng)
        $target = (in_array($key, ['facebook','instagram','telegram','tiktok','youtube'])) ? ' target="_blank" rel="noopener"' : '';
        $extra = ($key === 'wechat') ? ' data-wechat-id="' . esc_attr(gn_wechat_id()) . '" onclick="gnWechatPopup(event)"' : '';
        echo '<a href="' . esc_url($s['href']) . '" class="gn-social-icon gn-social-' . $key . '" aria-label="' . esc_attr($s['label']) . '" title="' . esc_attr($s['label']) . '"' . $target . $extra . '>';
        echo $s['svg'];
        if ($with_label) echo '<span class="gn-social-label">' . esc_html($s['label']) . '</span>';
        echo '</a>';
    }
    // AI Concierge
    echo '<a href="' . esc_url(home_url('/ai-tu-van/')) . '" class="gn-social-icon gn-social-ai" aria-label="AI Concierge" title="AI Concierge">';
    echo '<svg width="'.$size.'" height="'.$size.'" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a1 1 0 0 1 1 1v1h3a3 3 0 0 1 3 3v2a2 2 0 0 1 0 4v2a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-2a2 2 0 0 1 0-4V7a3 3 0 0 1 3-3h3V3a1 1 0 0 1 1-1zM9 10a1.25 1.25 0 1 0 0 2.5A1.25 1.25 0 0 0 9 10zm6 0a1.25 1.25 0 1 0 0 2.5A1.25 1.25 0 0 0 15 10zm-6 5a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H9z"/></svg>';
    if ($with_label) echo '<span class="gn-social-label">AI Bot</span>';
    echo '</a>';
    echo '</div>';
}

