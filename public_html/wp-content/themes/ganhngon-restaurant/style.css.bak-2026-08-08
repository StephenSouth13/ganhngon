/*
Theme Name: Ganh Ngon Restaurant
Theme URI: https://ganhngon.com
Author: GANH NGON
Description: Restaurant theme — Vietnamese fine dining; warm brown, gold, cream palette; built for Gánh Ngon Phú Quốc.
Version: 2.0.0
Text Domain: ganhngon-restaurant
*/
:root{
  --gn-primary:#2C1810; --gn-primary-soft:#4A2E1E;
  --gn-accent:#D4AF37; --gn-accent-hover:#B8941F;
  --gn-bg:#F5F1E8; --gn-card:#FFFFFF;
  --gn-text:#1A1A1A; --gn-text-soft:#5A5A5A;
  --gn-text-on-dark:#FFFFFF; --gn-border:#E8DFCB;
  --gn-shadow:0 8px 24px rgba(44,24,16,.08);
  --gn-font-display:'Playfair Display',Georgia,serif;
  --gn-font-body:'Open Sans','Helvetica Neue',Arial,sans-serif;
  --gn-radius:8px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--gn-bg);color:var(--gn-text);font-family:var(--gn-font-body);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,h5,h6{font-family:var(--gn-font-display);color:var(--gn-primary);margin:0 0 .6em;line-height:1.2;font-weight:600;letter-spacing:-.01em}
h1{font-size:clamp(2.2rem,5vw,3.6rem)} h2{font-size:clamp(1.8rem,3.5vw,2.6rem)} h3{font-size:clamp(1.3rem,2.5vw,1.7rem)}
p{margin:0 0 1em}
a{color:var(--gn-accent);text-decoration:none;transition:color .2s}
a:hover{color:var(--gn-accent-hover)}
img{max-width:100%;height:auto;display:block}
.gn-container{max-width:1200px;margin:0 auto;padding:0 24px}
.gn-header{background:rgba(44,24,16,.95);backdrop-filter:saturate(140%) blur(8px);color:var(--gn-text-on-dark);position:sticky;top:0;z-index:50;padding:14px 0;border-bottom:1px solid rgba(212,175,55,.2)}
.gn-header .gn-container{display:flex;align-items:center;justify-content:space-between;gap:20px}
.gn-logo{font-family:var(--gn-font-display);font-size:1.6rem;font-weight:700;color:var(--gn-accent);letter-spacing:.04em}
.gn-logo .sub{font-family:var(--gn-font-body);font-size:.7rem;font-weight:400;color:var(--gn-bg);letter-spacing:.2em;text-transform:uppercase;display:block;margin-top:-4px}
.gn-nav{display:flex;gap:22px;flex-wrap:wrap}
.gn-nav a{color:var(--gn-text-on-dark);font-size:.92rem;font-weight:500;letter-spacing:.02em;position:relative;padding:6px 0}
.gn-nav a:hover{color:var(--gn-accent)}
.gn-nav a.active{color:var(--gn-accent)}
.gn-nav a.active::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:2px;background:var(--gn-accent)}
.gn-cta-btn{display:inline-block;background:var(--gn-accent);color:var(--gn-primary)!important;padding:12px 26px;border-radius:var(--gn-radius);font-weight:600;font-size:.95rem;letter-spacing:.04em;text-transform:uppercase;border:none;cursor:pointer;transition:transform .2s,box-shadow .2s,background .2s}
.gn-cta-btn:hover{background:var(--gn-accent-hover);color:var(--gn-primary)!important;transform:translateY(-1px);box-shadow:0 6px 16px rgba(212,175,55,.3)}
.gn-cta-btn.ghost{background:transparent;color:var(--gn-accent)!important;border:1.5px solid var(--gn-accent)}
.gn-cta-btn.ghost:hover{background:var(--gn-accent);color:var(--gn-primary)!important}
.gn-hero{position:relative;min-height:80vh;display:flex;align-items:center;background:linear-gradient(rgba(44,24,16,.7),rgba(44,24,16,.85)),url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920') center/cover no-repeat;color:var(--gn-text-on-dark);text-align:center;padding:60px 0}
.gn-hero h1{color:var(--gn-text-on-dark);margin-bottom:18px}
.gn-hero .eyebrow{color:var(--gn-accent);text-transform:uppercase;letter-spacing:.3em;font-size:.85rem;margin-bottom:18px}
.gn-hero p.lead{font-size:1.15rem;max-width:720px;margin:0 auto 32px;opacity:.92}
.gn-hero .gn-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.gn-section{padding:80px 0}
.gn-section.alt{background:#FFFFFF}
.gn-section h2{text-align:center;margin-bottom:14px}
.gn-section .section-eyebrow{text-align:center;color:var(--gn-accent);text-transform:uppercase;letter-spacing:.3em;font-size:.8rem;margin-bottom:14px;font-weight:600}
.gn-section .section-intro{text-align:center;max-width:680px;margin:0 auto 48px;color:var(--gn-text-soft)}
.gn-menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px}
.gn-menu-card{background:var(--gn-card);border-radius:var(--gn-radius);overflow:hidden;box-shadow:var(--gn-shadow);transition:transform .3s}
.gn-menu-card:hover{transform:translateY(-6px)}
.gn-menu-card img{width:100%;height:200px;object-fit:cover}
.gn-menu-card .body{padding:20px}
.gn-menu-card h3{margin-bottom:8px;font-size:1.2rem}
.gn-menu-card .desc{font-size:.92rem;color:var(--gn-text-soft);margin:0 0 14px}
.gn-menu-card .gn-cta-btn{font-size:.82rem;padding:9px 18px}
.gn-vip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.gn-vip-card{background:var(--gn-card);border-radius:var(--gn-radius);overflow:hidden;box-shadow:var(--gn-shadow);transition:transform .3s;border-top:3px solid var(--gn-accent)}
.gn-vip-card:hover{transform:translateY(-6px)}
.gn-vip-card img{width:100%;height:200px;object-fit:cover}
.gn-vip-card .body{padding:22px}
.gn-vip-card h3{margin-bottom:6px;font-size:1.25rem}
.gn-vip-card .vip-meta{color:var(--gn-accent);font-weight:600;font-size:.9rem;margin-bottom:10px}
.gn-vip-card .desc{font-size:.9rem;color:var(--gn-text-soft);margin:0 0 14px}
.gn-vip-card ul{margin:0 0 16px;padding-left:18px;font-size:.88rem;color:var(--gn-text-soft)}
.gn-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.gn-gallery .item{aspect-ratio:1;overflow:hidden;border-radius:var(--gn-radius);position:relative}
.gn-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.gn-gallery .item:hover img{transform:scale(1.08)}
.gn-testimonials{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.gn-test-card{background:var(--gn-card);padding:30px;border-radius:var(--gn-radius);box-shadow:var(--gn-shadow);position:relative}
.gn-test-card::before{content:'\201C';position:absolute;top:-10px;left:18px;font-size:5rem;color:var(--gn-accent);font-family:var(--gn-font-display);line-height:1}
.gn-test-card .stars{color:var(--gn-accent);margin-bottom:10px}
.gn-test-card p{font-style:italic;color:var(--gn-text-soft);margin-bottom:18px}
.gn-test-card .author{font-weight:600;color:var(--gn-primary);font-size:.95rem}
.gn-test-card .author .role{display:block;font-weight:400;color:var(--gn-text-soft);font-size:.85rem;font-style:normal}
.gn-reservation{background:linear-gradient(rgba(44,24,16,.88),rgba(44,24,16,.92)),url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920') center/cover;color:var(--gn-text-on-dark);text-align:center}
.gn-reservation h2{color:var(--gn-text-on-dark)}
.gn-reservation .section-intro{color:rgba(255,255,255,.85)}
.gn-reservation .reservation-form{max-width:760px;margin:0 auto;background:rgba(255,255,255,.08);backdrop-filter:blur(10px);padding:34px;border-radius:var(--gn-radius);border:1px solid rgba(212,175,55,.3)}
.gn-form-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:14px}
.gn-form-row input,.gn-form-row select,.gn-form-row textarea{background:rgba(255,255,255,.95);border:none;border-radius:var(--gn-radius);padding:14px 16px;font-size:1rem;font-family:inherit;color:var(--gn-text)}
.gn-about{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
@media (max-width:768px){.gn-about{grid-template-columns:1fr}}
.gn-about img{border-radius:var(--gn-radius);box-shadow:var(--gn-shadow)}
.gn-about .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:26px}
.gn-about .stats .stat{text-align:center}
.gn-about .stats .stat strong{font-family:var(--gn-font-display);color:var(--gn-accent);font-size:2.2rem;display:block;line-height:1}
.gn-about .stats .stat span{font-size:.84rem;color:var(--gn-text-soft);text-transform:uppercase;letter-spacing:.1em}
.gn-footer{background:var(--gn-primary);color:var(--gn-text-on-dark);padding:60px 0 28px;border-top:3px solid var(--gn-accent)}
.gn-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
@media (max-width:768px){.gn-footer-grid{grid-template-columns:1fr 1fr}}
.gn-footer h4{color:var(--gn-accent);font-size:1.05rem;margin-bottom:18px}
.gn-footer a{color:rgba(255,255,255,.8);display:block;margin-bottom:8px;font-size:.92rem}
.gn-footer a:hover{color:var(--gn-accent)}
.gn-footer-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:42px;padding-top:24px;text-align:center;font-size:.85rem;color:rgba(255,255,255,.6)}
.gn-page-hero{padding:110px 0 70px;text-align:center;background:linear-gradient(180deg,var(--gn-bg) 0%,rgba(245,241,232,.6) 100%);border-bottom:1px solid var(--gn-border)}
.gn-page-hero h1{margin-bottom:12px}
.gn-page-hero .crumb{color:var(--gn-text-soft);font-size:.9rem;text-transform:uppercase;letter-spacing:.2em}
.gn-content{padding:50px 0}
.gn-content article{background:#fff;padding:42px;border-radius:var(--gn-radius);box-shadow:var(--gn-shadow);max-width:900px;margin:0 auto}
.gn-content article table{width:100%;border-collapse:collapse;margin:14px 0}
.gn-content article table td{padding:10px;border-bottom:1px solid var(--gn-border)}

/* Sticky mobile bar */
.gn-sticky-mobile{position:fixed;left:0;right:0;bottom:0;background:rgba(44,24,16,.97);display:none;justify-content:space-around;padding:10px 0;z-index:100;border-top:2px solid var(--gn-accent);backdrop-filter:blur(8px)}
.gn-sticky-item{display:flex;flex-direction:column;align-items:center;color:var(--gn-text-on-dark)!important;font-size:.7rem;gap:2px;padding:4px 6px;text-decoration:none;flex:1}
.gn-sticky-item span:first-child{font-size:1.3rem}
.gn-sticky-cta{color:var(--gn-accent)!important}
@media (max-width:860px){
  .gn-nav{display:none}
  .gn-hero{min-height:68vh;padding:40px 0}
  .gn-sticky-mobile{display:flex}
  body{padding-bottom:62px}
}

/* Menu category list (no prices) */
.gn-menu-cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin:24px 0}
.gn-menu-cat{background:#fff;padding:24px;border-radius:var(--gn-radius);box-shadow:var(--gn-shadow);text-align:center;transition:transform .3s}
.gn-menu-cat:hover{transform:translateY(-4px)}
.gn-menu-cat .icon{font-size:2.4rem;margin-bottom:10px}
.gn-menu-cat h3{font-size:1.15rem;margin-bottom:8px}
.gn-menu-cat p{font-size:.88rem;color:var(--gn-text-soft);margin-bottom:14px}
.gn-menu-cat a{color:var(--gn-accent);font-weight:600;font-size:.88rem}

/* Tag/badge */
.gn-badge{display:inline-block;background:var(--gn-accent);color:var(--gn-primary);padding:3px 10px;border-radius:999px;font-size:.75rem;font-weight:600;letter-spacing:.05em}
/* Quick booking strip on homepage */
.gn-quick-booking{background:linear-gradient(135deg,#2C1810 0%,#4A2E1E 100%);padding:30px 0;border-bottom:3px solid var(--gn-accent)}
.gn-quick-form{display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap}
.gn-quick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;flex:1}
.gn-quick-grid label{display:flex;flex-direction:column;font-size:.78rem;color:rgba(255,255,255,.85);font-weight:500;text-transform:uppercase;letter-spacing:.05em}
.gn-quick-grid input,.gn-quick-grid select{background:rgba(255,255,255,.97);border:none;border-radius:6px;padding:11px 12px;font-size:.93rem;color:var(--gn-text);margin-top:5px;font-family:inherit}
.gn-quick-booking .gn-cta-btn{padding:13px 28px;white-space:nowrap}
@media (max-width:760px){.gn-quick-form{flex-direction:column;align-items:stretch}.gn-quick-booking .gn-cta-btn{width:100%}}

/* Per-room VIP cards with image */
.gn-vip-room-card{background:#fff;border-radius:8px;overflow:hidden;box-shadow:var(--gn-shadow);border-top:3px solid var(--gn-accent);transition:transform .3s}
.gn-vip-room-card:hover{transform:translateY(-6px)}
.gn-vip-room-card .room-img{width:100%;height:200px;object-fit:cover}
.gn-vip-room-card .room-body{padding:22px}
.gn-vip-room-card h3{margin:0 0 4px;font-size:1.25rem}
.gn-vip-room-card .room-meta{color:var(--gn-accent);font-weight:600;font-size:.9rem;margin-bottom:10px}
.gn-vip-room-card .room-status{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px}
.gn-vip-room-card .room-status.available{background:#E8F5E9;color:#2E7D32}
.gn-vip-room-card .room-status.limited{background:#FFF3E0;color:#E65100}
.gn-vip-room-card .room-desc{font-size:.9rem;color:var(--gn-text-soft);margin:0 0 14px}
.gn-vip-room-card ul{margin:0 0 14px;padding-left:18px;font-size:.85rem;color:var(--gn-text-soft);line-height:1.7}

/* FAQ details/summary styling */
.gn-faq-list details[open] summary span:last-child{transform:rotate(45deg)}
.gn-faq-list details summary span:last-child{transition:transform .2s}
.gn-faq-list summary::-webkit-details-marker{display:none}
/* ============ v2.2 — Social + Footer redesign ============ */

/* Social row */
.gn-social-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.gn-social-icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:rgba(212,175,55,.12);color:var(--gn-accent)!important;transition:all .2s;text-decoration:none}
.gn-social-icon:hover{background:var(--gn-accent);color:var(--gn-primary)!important;transform:translateY(-2px);box-shadow:0 4px 12px rgba(212,175,55,.3)}
.gn-social-icon svg{flex-shrink:0}
.gn-social-icon .gn-social-label{display:none}
.gn-social-zalo:hover{background:#0068FF;color:#fff!important}
.gn-social-whatsapp:hover{background:#25D366;color:#fff!important}
.gn-social-facebook:hover{background:#1877F2;color:#fff!important}
.gn-social-instagram:hover{background:linear-gradient(135deg,#833AB4,#FD1D1D,#FCB045);color:#fff!important}
.gn-social-telegram:hover{background:#0088CC;color:#fff!important}
.gn-social-wechat:hover{background:#1AAD19;color:#fff!important}
.gn-social-ai:hover{background:#D4AF37;color:var(--gn-primary)!important}

/* WeChat modal */
.gn-wechat-modal{position:fixed;inset:0;background:rgba(44,24,16,.85);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px}
.gn-wechat-modal[hidden]{display:none!important}
.gn-wechat-content{background:#fff;padding:36px;border-radius:12px;max-width:340px;width:100%;text-align:center;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.gn-wechat-close{position:absolute;top:10px;right:14px;background:none;border:none;font-size:28px;cursor:pointer;color:#5A5A5A;line-height:1}
.gn-wechat-content h3{margin:0 0 12px;color:var(--gn-primary)}

/* Footer redesign */
.gn-footer{background:linear-gradient(180deg,var(--gn-primary) 0%,#1a0e07 100%);color:var(--gn-text-on-dark);padding:0 0 24px;border-top:3px solid var(--gn-accent);margin-top:60px}
.gn-footer-top{background:rgba(212,175,55,.08);padding:50px 0;border-bottom:1px solid rgba(212,175,55,.15);text-align:center}
.gn-footer-cta h3{color:var(--gn-text-on-dark);font-size:clamp(1.4rem,3vw,2rem);margin:0 0 8px}
.gn-footer-cta p{color:rgba(255,255,255,.85);max-width:600px;margin:0 auto 24px;font-style:italic}
.gn-footer-cta-buttons{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.gn-footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1.1fr 1.2fr;gap:50px;padding:54px 0 32px}
@media (max-width:980px){.gn-footer-grid{grid-template-columns:1fr 1fr;gap:36px}}
@media (max-width:560px){.gn-footer-grid{grid-template-columns:1fr;gap:30px}}
.gn-footer-brand .gn-logo{color:var(--gn-accent);font-family:var(--gn-font-display);font-size:1.7rem;font-weight:700;display:block;letter-spacing:.04em}
.gn-footer-brand .gn-logo .sub{display:block;font-size:.72rem;font-family:var(--gn-font-body);font-weight:400;color:var(--gn-bg);letter-spacing:.18em;text-transform:uppercase;margin-top:-2px}
.gn-footer h4{color:var(--gn-accent);font-size:1rem;margin:0 0 16px;font-weight:600;text-transform:uppercase;letter-spacing:.08em}
.gn-footer a{color:rgba(255,255,255,.82);display:block;margin-bottom:10px;font-size:.92rem;transition:color .2s}
.gn-footer a:hover{color:var(--gn-accent)}
.gn-footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:22px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.85rem;color:rgba(255,255,255,.6)}
.gn-footer-langs{font-size:.85rem}

/* Khach doan layout v2 */
.gn-kd-hero{background:linear-gradient(rgba(44,24,16,.85),rgba(44,24,16,.92)),url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920') center/cover no-repeat;color:#fff;padding:100px 0 80px;text-align:center}
.gn-kd-hero h1{color:#fff;margin-bottom:16px}
.gn-kd-hero p{font-size:1.1rem;opacity:.92;max-width:780px;margin:0 auto 28px}
.gn-kd-hero-meta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:18px;font-size:.9rem}
.gn-kd-hero-meta div{background:rgba(212,175,55,.15);padding:8px 18px;border-radius:99px;border:1px solid rgba(212,175,55,.3)}
.gn-kd-tabs{display:flex;gap:0;justify-content:center;border-bottom:2px solid var(--gn-border);margin-bottom:0;flex-wrap:wrap;background:#fff;position:sticky;top:62px;z-index:30}
.gn-kd-tabs a{padding:14px 22px;color:var(--gn-text);font-weight:600;font-size:.92rem;border-bottom:3px solid transparent;text-decoration:none;transition:all .2s;letter-spacing:.02em}
.gn-kd-tabs a:hover{color:var(--gn-accent)}
.gn-kd-tabs a.active,.gn-kd-tabs a:target{color:var(--gn-accent);border-bottom-color:var(--gn-accent)}

.gn-kd-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin:28px 0}
.gn-kd-svc{background:#fff;padding:24px;border-radius:10px;box-shadow:var(--gn-shadow);transition:transform .2s,box-shadow .2s;text-decoration:none;color:inherit;display:flex;flex-direction:column;border-top:3px solid var(--gn-accent)}
.gn-kd-svc:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(44,24,16,.12)}
.gn-kd-svc .icon{font-size:2.2rem;margin-bottom:10px}
.gn-kd-svc h3{font-size:1.1rem;margin:0 0 8px;color:var(--gn-primary)}
.gn-kd-svc p{color:var(--gn-text-soft);font-size:.88rem;margin:0 0 14px;flex:1}
.gn-kd-svc .gn-kd-svc-meta{font-size:.8rem;color:var(--gn-accent);font-weight:600;text-transform:uppercase;letter-spacing:.05em}

/* VIP rooms inside khach-doan */
.gn-kd-vip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin:24px 0}
.gn-kd-vip-card{background:#fff;border-radius:10px;overflow:hidden;box-shadow:var(--gn-shadow);transition:transform .25s;border-top:3px solid var(--gn-accent)}
.gn-kd-vip-card:hover{transform:translateY(-5px)}
.gn-kd-vip-card .img{width:100%;height:170px;object-fit:cover;display:block}
.gn-kd-vip-card .body{padding:18px 20px}
.gn-kd-vip-card h4{margin:0 0 4px;font-size:1.1rem;color:var(--gn-primary)}
.gn-kd-vip-card .cap{color:var(--gn-accent);font-weight:600;font-size:.85rem;margin-bottom:6px}
.gn-kd-vip-card .desc{font-size:.86rem;color:var(--gn-text-soft);margin:0 0 12px;min-height:42px}
.gn-kd-vip-card .room-status{display:inline-block;padding:3px 10px;border-radius:99px;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px}
.gn-kd-vip-card .room-status.available{background:#E8F5E9;color:#2E7D32}
.gn-kd-vip-card .room-status.limited{background:#FFF3E0;color:#E65100}
.gn-kd-vip-card .gn-cta-btn{font-size:.8rem;padding:8px 16px;width:100%;text-align:center}

/* Lead form khach doan */
.gn-kd-lead{background:linear-gradient(135deg,var(--gn-primary) 0%,#3a1f12 100%);color:#fff;padding:60px 0;margin-top:40px;border-radius:0}
.gn-kd-lead h2{color:#fff;text-align:center;margin-bottom:8px}
.gn-kd-lead .section-intro{color:rgba(255,255,255,.85);text-align:center;max-width:680px;margin:0 auto 32px}
.gn-kd-lead-form{max-width:820px;margin:0 auto;background:rgba(255,255,255,.04);backdrop-filter:blur(10px);padding:32px;border-radius:12px;border:1px solid rgba(212,175,55,.25)}
.gn-kd-lead-form label{display:block;color:rgba(255,255,255,.9);font-size:.85rem;font-weight:500;margin-bottom:0}
.gn-kd-lead-form input,.gn-kd-lead-form select,.gn-kd-lead-form textarea{background:rgba(255,255,255,.95);border:none;border-radius:6px;padding:12px 14px;font-size:.93rem;color:var(--gn-text);width:100%;font-family:inherit;margin-top:6px}
.gn-kd-lead-form .gn-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.gn-kd-lead-form .gn-form-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px}
@media (max-width:640px){.gn-kd-lead-form .gn-form-grid,.gn-kd-lead-form .gn-form-grid-3{grid-template-columns:1fr}}
.gn-kd-lead-form .check-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:14px}
.gn-kd-lead-form .check-row label{background:rgba(255,255,255,.08);padding:10px 12px;border-radius:6px;cursor:pointer;font-size:.85rem;display:flex;align-items:center;gap:6px;color:#fff}
.gn-kd-lead-form .check-row label input{width:auto;margin:0}
.gn-kd-lead-form button{background:var(--gn-accent);color:var(--gn-primary);border:none;border-radius:8px;padding:14px 32px;font-weight:700;font-size:1rem;cursor:pointer;display:block;margin:18px auto 0;min-width:240px;text-transform:uppercase;letter-spacing:.05em;transition:all .2s}
.gn-kd-lead-form button:hover{background:var(--gn-accent-hover);transform:translateY(-1px);box-shadow:0 8px 20px rgba(212,175,55,.4)}

/* Process steps khach doan */
.gn-kd-process{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px;margin:24px 0;counter-reset:step}
.gn-kd-process .step{background:#fff;padding:22px 18px;border-radius:10px;box-shadow:var(--gn-shadow);position:relative;text-align:center}
.gn-kd-process .step::before{counter-increment:step;content:counter(step);position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--gn-accent);color:var(--gn-primary);width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1rem}
.gn-kd-process .step h4{font-size:.92rem;margin:14px 0 6px;color:var(--gn-primary)}
.gn-kd-process .step p{font-size:.8rem;color:var(--gn-text-soft);margin:0}

/* v2.3 — additional social hovers */
.gn-social-youtube:hover{background:#FF0000;color:#fff!important}
.gn-social-tiktok:hover{background:#000000;color:#fff!important}
.gn-social-twitter_x:hover{background:#000000;color:#fff!important}

/* v2.4 — Affiliate program */
.gn-aff-hero{background:linear-gradient(rgba(44,24,16,.88),rgba(44,24,16,.94)),url('https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=1920') center/cover;color:#fff;padding:90px 0 70px;text-align:center}
.gn-aff-hero h1{color:#fff}
.gn-aff-eyebrow{color:#D4AF37;text-transform:uppercase;letter-spacing:.3em;font-size:.85rem;margin-bottom:14px;font-weight:600}
.gn-aff-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:780px;margin:30px auto 0;padding:24px;background:rgba(212,175,55,.1);border-radius:10px;border:1px solid rgba(212,175,55,.25)}
@media(max-width:640px){.gn-aff-stats{grid-template-columns:repeat(2,1fr)}}
.gn-aff-stats div{text-align:center}
.gn-aff-stats div strong{display:block;font-family:var(--gn-font-display);font-size:2.2rem;color:#D4AF37;line-height:1}
.gn-aff-stats div span{display:block;font-size:.78rem;color:rgba(255,255,255,.8);margin-top:6px;text-transform:uppercase;letter-spacing:.05em}
.gn-aff-portal{padding:50px 0;min-height:60vh}

/* v2.5 — Du lịch PQ footer hub */
.gn-footer-dlpq{background:rgba(212,175,55,.05);padding:46px 0;border-top:1px solid rgba(212,175,55,.15);border-bottom:1px solid rgba(212,175,55,.15)}
.gn-footer-dlpq h3{color:#fff;font-size:1.5rem}
.gn-dlpq-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
.gn-dlpq-card{background:rgba(255,255,255,.04);border:1px solid rgba(212,175,55,.18);border-radius:8px;padding:18px 16px;text-align:center;text-decoration:none;color:#fff!important;transition:all .25s;display:flex;flex-direction:column;align-items:center;gap:4px}
.gn-dlpq-card:hover{background:rgba(212,175,55,.12);border-color:#D4AF37;transform:translateY(-3px)}
.gn-dlpq-icon{font-size:2rem;margin-bottom:4px}
.gn-dlpq-card strong{color:#D4AF37;font-size:.92rem;letter-spacing:.02em}
.gn-dlpq-card span{color:rgba(255,255,255,.7);font-size:.75rem;margin-top:2px}
.gn-dlpq-card-all{background:rgba(212,175,55,.15);border-color:#D4AF37}

/* Du lịch hub page */
.gn-dlpq-hero{background:linear-gradient(rgba(44,24,16,.85),rgba(44,24,16,.92)),url('https://images.unsplash.com/photo-1546484959-f9a381d1330d?w=1920') center/cover;padding:90px 0 70px;color:#fff}
.gn-dlpq-hero h1{color:#fff}

/* v2.6 — Language switcher */
.gn-header-right{display:flex;align-items:center;gap:14px}
.gn-lang-switch{position:relative}
.gn-lang-current{background:rgba(212,175,55,.12);color:var(--gn-text-on-dark);border:1px solid rgba(212,175,55,.3);border-radius:6px;padding:8px 12px;font-size:.85rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:4px;transition:all .2s}
.gn-lang-current:hover{background:rgba(212,175,55,.25)}
.gn-lang-item{display:block;padding:11px 16px;color:var(--gn-text)!important;font-size:.9rem;text-decoration:none;transition:background .15s}
.gn-lang-item:hover{background:var(--gn-bg)}
.gn-lang-item.active{background:rgba(212,175,55,.15);color:var(--gn-primary)!important;font-weight:600}
@media (max-width:860px){.gn-header-right .gn-cta-btn{display:none}.gn-lang-current{padding:7px 10px;font-size:.8rem}}
/* RTL support for Arabic */
html[lang="ar"] body,html[dir="rtl"] body{direction:rtl;text-align:right}
html[lang="ar"] .gn-lang-dropdown{left:0;right:auto}

/* v2.7 — Language switcher CLEAN DROPDOWN (override v2.6) */
.gn-header-right{display:flex;align-items:center;gap:12px}
.gn-lang-switch{position:relative}
.gn-lang-current{display:inline-flex;align-items:center;gap:6px;background:rgba(212,175,55,.12);color:#fff;border:1px solid rgba(212,175,55,.35);border-radius:8px;padding:8px 12px;font-size:.85rem;font-weight:600;cursor:pointer;line-height:1;transition:all .2s}
.gn-lang-current:hover{background:rgba(212,175,55,.25)}
.gn-lang-current .flag{font-size:1.1rem}
.gn-lang-current .caret{font-size:.6rem;opacity:.8;transition:transform .2s}
.gn-lang-switch.open .gn-lang-current .caret{transform:rotate(180deg)}
.gn-lang-switch.open .gn-lang-current{background:rgba(212,175,55,.3)}
/* dropdown — HIDDEN by default */
ul.gn-lang-dropdown{display:none;position:absolute;top:calc(100% + 8px);right:0;margin:0;padding:6px;list-style:none;background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(44,24,16,.22);min-width:175px;z-index:200}
.gn-lang-switch.open ul.gn-lang-dropdown{display:block;animation:gnLangIn .18s ease}
@keyframes gnLangIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
ul.gn-lang-dropdown li{margin:0;padding:0}
ul.gn-lang-dropdown a{display:flex;align-items:center;gap:10px;padding:10px 14px;color:#2C1810!important;font-size:.92rem;text-decoration:none;border-radius:6px;transition:background .15s}
ul.gn-lang-dropdown a .flag{font-size:1.15rem}
ul.gn-lang-dropdown a:hover{background:#F5F1E8}
ul.gn-lang-dropdown a.active{background:rgba(212,175,55,.18);font-weight:700;color:#2C1810!important}
@media (max-width:860px){.gn-header-right .gn-cta-btn{display:none}.gn-lang-current{padding:7px 9px;font-size:.8rem}}
/* RTL for Arabic */
html[dir="rtl"] body,body.rtl{direction:rtl;text-align:right}
html[dir="rtl"] ul.gn-lang-dropdown,body.rtl ul.gn-lang-dropdown{right:auto;left:0}
html[dir="rtl"] .gn-section .section-intro,html[dir="rtl"] .gn-hero{text-align:center}

/* v2.8 — Center social row + icon render safety + footer cleanup */
.gn-footer-brand .gn-social-row{justify-content:flex-start}
.gn-social-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.gn-social-icon{flex:0 0 auto}
.gn-social-icon svg{width:20px;height:20px;display:block;fill:currentColor}
/* dropdown z-index safety so it appears above everything */
.gn-lang-switch{position:relative;z-index:300}
ul.gn-lang-dropdown{z-index:400}

/* ============================================================
   v3.0 FINAL OVERRIDE — wins over any stale appended cruft
   ============================================================ */
/* Social icons: force perfect centering inside the circle */
.gn-social-row{display:flex !important;flex-wrap:wrap;gap:10px;align-items:center}
.gn-social-icon{display:inline-flex !important;align-items:center !important;justify-content:center !important;width:44px !important;height:44px !important;border-radius:50% !important;line-height:0 !important;padding:0 !important;flex:0 0 auto}
.gn-social-icon svg{width:20px !important;height:20px !important;display:block !important;margin:0 !important;flex-shrink:0}
.gn-social-icon .gn-social-label{display:none !important}

/* Language dropdown: single source of truth — hidden unless .open */
ul.gn-lang-dropdown{display:none !important;opacity:1 !important;visibility:visible !important;transform:none !important;position:absolute;top:calc(100% + 8px);right:0;margin:0;padding:6px;list-style:none;background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(44,24,16,.22);min-width:185px;z-index:600}
.gn-lang-switch.open ul.gn-lang-dropdown{display:block !important}
ul.gn-lang-dropdown li{margin:0 !important;padding:0 !important;list-style:none !important;display:block !important}
ul.gn-lang-dropdown a{display:flex !important;align-items:center;gap:10px;padding:10px 14px !important;color:#2C1810 !important;font-size:.92rem;text-decoration:none;border-radius:6px;white-space:nowrap}
ul.gn-lang-dropdown a:hover{background:#F5F1E8 !important}
ul.gn-lang-dropdown a.active{background:rgba(212,175,55,.18) !important;font-weight:700}
.gn-lang-switch{position:relative;z-index:500}

/* ============================================================
   Floating chat launcher (multi-channel concierge)
   ============================================================ */
.gn-chat-fab{position:fixed;right:20px;bottom:20px;z-index:9998;width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;background:linear-gradient(135deg,#D4AF37,#b8932e);color:#2C1810;box-shadow:0 6px 24px rgba(0,0,0,.28);display:flex;align-items:center;justify-content:center;transition:transform .2s,box-shadow .2s}
.gn-chat-fab:hover{transform:scale(1.06);box-shadow:0 8px 30px rgba(212,175,55,.45)}
.gn-chat-fab svg{width:28px;height:28px;display:block}
.gn-chat-fab .gn-chat-badge{position:absolute;top:-3px;right:-3px;width:16px;height:16px;border-radius:50%;background:#e23b3b;border:2px solid #fff}
.gn-chat-panel{position:fixed;right:20px;bottom:90px;z-index:9999;width:300px;max-width:calc(100vw - 32px);background:#fff;border-radius:16px;box-shadow:0 16px 48px rgba(0,0,0,.3);overflow:hidden;display:none;animation:gnChatIn .22s ease}
.gn-chat-panel.open{display:block}
@keyframes gnChatIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.gn-chat-head{background:linear-gradient(135deg,#2C1810,#43281a);color:#fff;padding:16px 18px}
.gn-chat-head strong{display:block;font-size:1rem;font-family:Georgia,serif;color:#D4AF37}
.gn-chat-head span{font-size:.78rem;opacity:.8}
.gn-chat-body{padding:10px}
.gn-chat-opt{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;text-decoration:none;color:#2C1810;transition:background .15s}
.gn-chat-opt:hover{background:#F5F1E8}
.gn-chat-opt .gn-chat-ico{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:0 0 auto;color:#fff}
.gn-chat-opt .gn-chat-ico svg{width:20px;height:20px;display:block;fill:currentColor}
.gn-chat-opt b{display:block;font-size:.9rem}
.gn-chat-opt small{color:#7a6a5a;font-size:.74rem}
.gn-chat-foot{padding:10px 16px;border-top:1px solid #eee;font-size:.72rem;color:#9a8a7a;text-align:center}
html[dir="rtl"] .gn-chat-fab,html[dir="rtl"] .gn-chat-panel{right:auto;left:20px}
@media(max-width:860px){.gn-chat-fab{bottom:74px}.gn-chat-panel{bottom:144px}}

/* ============================================================
   v3.1 — AI chat thread inside floating panel
   ============================================================ */
.gn-chat-panel{width:340px}
.gn-chat-log{padding:14px;height:300px;overflow-y:auto;background:#F7F3EC;display:flex;flex-direction:column;gap:10px}
.gn-msg{max-width:84%;padding:9px 13px;border-radius:14px;font-size:.9rem;line-height:1.45;white-space:pre-wrap;word-wrap:break-word}
.gn-msg-bot{align-self:flex-start;background:#fff;color:#2C1810;border-bottom-left-radius:4px;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.gn-msg-user{align-self:flex-end;background:#2C1810;color:#fff;border-bottom-right-radius:4px}
.gn-typing{opacity:.6;font-style:italic}
.gn-chat-input{display:flex;gap:8px;padding:10px;border-top:1px solid #eee;background:#fff}
.gn-chat-input input{flex:1;min-width:0;border:1px solid #E8DFCB;border-radius:22px;padding:10px 15px;font-size:.9rem;font-family:inherit;outline:none}
.gn-chat-input input:focus{border-color:#D4AF37}
.gn-chat-input button{flex:0 0 auto;width:42px;height:42px;border:none;border-radius:50%;background:#D4AF37;color:#2C1810;cursor:pointer;display:flex;align-items:center;justify-content:center}
.gn-chat-input button:hover{background:#b8932e}
.gn-chat-input button svg{width:20px;height:20px}
.gn-chat-channels{display:flex;align-items:center;gap:7px;padding:9px 12px;border-top:1px solid #eee;background:#fff;flex-wrap:wrap}
.gn-chat-ch-label{font-size:.74rem;color:#9a8a7a;margin-right:2px}
.gn-chat-channels a{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.gn-chat-channels a svg{width:17px;height:17px;display:block}
@media(max-width:480px){.gn-chat-panel{width:calc(100vw - 24px);right:12px}.gn-chat-log{height:46vh}}
