      <section class="gnp-hero">
        <span class="gnp-rule"></span>
        <p class="gnp-eyebrow">Voucher Gánh Ngon</p>
        <h2>Mua trước, trả khi đến</h2>
        <p class="gnp-lead">Chọn mệnh giá, điền email. Voucher gửi ngay về email ở trạng thái giữ chỗ —
          đến nhà hàng trả tiền tại quầy là dùng được. Không mất phí nếu đổi ý.</p>
      </section>

      <?php if ($p): ?>
      <section class="gnp-sec" style="padding-bottom:0">
        <div class="gnp-rules" style="background:#F6EBD2">Bạn vào từ mã đối tác
          <b><?php echo esc_html($p->ref_code); ?> · <?php echo esc_html($p->contact ?: $p->company); ?></b>.
          Đơn này sẽ được ghi nhận cho người giới thiệu.</div>
      </section>
      <?php endif; ?>

      <section class="gnp-sec">
        <div class="gnp-head"><span class="gnp-rule"></span><p class="gnp-eyebrow">Chọn mệnh giá</p>
          <h3>Mua càng lớn càng lợi</h3></div>
        <form class="gnp-form" id="gnVoucherForm" style="max-width:620px;margin-inline:auto">
          <?php $gn_tiers = []; foreach (gn_voucher_tiers() as $gn_f => $gn_g) $gn_tiers[] = [$gn_f, $gn_g]; foreach ($gn_tiers as $i => $o): ?>
            <label style="flex-direction:row;align-items:center;gap:12px;border:1px solid var(--gn-border);
                          border-radius:12px;padding:14px 16px;cursor:pointer">
              <input type="radio" name="face" value="<?php echo $o[0]; ?>" data-price="<?php echo $o[1]; ?>"
                     <?php echo $i === 1 ? 'checked' : ''; ?> style="min-height:auto;width:auto">
              <span style="flex:1"><b style="font-size:17px"><?php echo gn_money($o[0]); ?></b><br>
                <small style="color:var(--gn-text-soft)">trả <?php echo gn_money($o[1]); ?> ·
                  lợi <?php echo gn_money($o[0] - $o[1]); ?></small></span>
            </label>
          <?php endforeach; ?>

          <label>Họ và tên *<input name="buyer_name" required placeholder="Nguyễn Thu Hà"></label>
          <label>Email nhận voucher *<input name="buyer_email" type="email" required placeholder="ban@email.com"></label>
          <label>Số điện thoại / Zalo<input name="buyer_phone" type="tel" inputmode="tel" placeholder="09xx xxx xxx"></label>
          <button type="submit" class="gnp-btn gnp-btn--gold gnp-btn--block">Nhận voucher giữ chỗ</button>
          <p class="gnp-fine">Chưa mất tiền lúc này. Voucher gửi về email ở trạng thái <b>CHƯA THANH TOÁN</b>,
            giữ chỗ 7 ngày. Đến nhà hàng trả tiền tại quầy là dùng được ngay.</p>
          <div id="gnVoucherOut" style="display:none"></div>
        </form>
      </section>
    </div>
    <script>
    (function(){
      var f=document.getElementById('gnVoucherForm');
      if(!f) return;
      f.addEventListener('submit',function(e){
        e.preventDefault();
        var sel=f.querySelector('input[name=face]:checked');
        var btn=f.querySelector('button[type=submit]');
        btn.disabled=true; btn.textContent='Đang gửi…';
        var d=new URLSearchParams({
          face_value:sel.value, price:sel.dataset.price,
          buyer_name:f.buyer_name.value, buyer_email:f.buyer_email.value, buyer_phone:f.buyer_phone.value
        });
        fetch('<?php echo esc_url(admin_url('admin-ajax.php')); ?>?action=gn_voucher_buy',
          {method:'POST',credentials:'include',
           headers:{'Content-Type':'application/x-www-form-urlencoded'},body:d.toString()})
        .then(function(r){return r.json()})
        .then(function(j){
          var o=document.getElementById('gnVoucherOut'); o.style.display='block';
          if(j.success){
            o.className='gnp-rules';
            o.innerHTML='<b>Xong.</b> Mã voucher <b>'+j.data.ma+'</b>. '+j.data.message+
              '<br>Giữ chỗ đến hết ngày '+j.data.giu_den+'.';
            btn.style.display='none';
          } else {
            o.className='gnp-rules'; o.style.background='#FBE9E7'; o.style.borderColor='#B42318';
            o.textContent=(j.data&&j.data.message)||'Không gửi được, gọi 0979 232 233 giúp.';
            btn.disabled=false; btn.textContent='Thử lại';
          }
        })
        .catch(function(){ btn.disabled=false; btn.textContent='Thử lại'; });
      });
    })();
    </script><?php
    return ob_get_clean();
}

/* gn_voucher_view_html() nay nằm ở cuối file — bản đầy đủ, hiện người mua,
   đối tác giới thiệu, ngày mua, giá trị, tiền nạp thêm, số dư, hạn dùng,
   lịch sử giao dịch và VietQR. Không khai báo lại ở đây. */

/** Gắn hai trang vào nội dung theo đường dẫn. */
add_filter('the_content', function ($content) {
    if (is_admin() || !in_the_loop() || !is_main_query() || !is_page()) return $content;
    $slug = get_post_field('post_name', get_queried_object_id());
    if ($slug === 'cong-doi-tac') return gn_portal_html();
    if ($slug === 'voucher')      return gn_voucher_page_html();
    if (function_exists('gn_is_advisor_page') && gn_is_advisor_page()) return gn_advisor_page_html();
    return $content;
}, 6);

function gn_is_advisor_page() {
    if (!is_page()) return false;
    $slug = (string) get_post_field('post_name', get_queried_object_id());
    return $slug === 'ai-tu-van' || strpos($slug, 'ai-tu-van') === 0;
}

function gn_advisor_page_html() {
    $lang = gn_cur_lang();
    $hello = gn_advisor_reply('xin chao', $lang);
    $chips = [
        'vi' => ['Giờ mở cửa', 'Chỉ đường', 'Đặt bàn hôm nay', 'Lẩu gà sầu riêng', 'Giá bao nhiêu?', 'Phòng VIP'],
        'en' => ['Opening hours', 'Directions', 'Book a table today', 'Durian chicken hotpot', 'How much does it cost?', 'VIP room'],
        'zh' => ['营业时间', '怎么走', '今天订桌', '榴莲鸡火锅', '多少钱', 'VIP包厢'],
        'ko' => ['영업시간', '오시는 길', '오늘 예약', '두리안 닭 샤브샤브', '가격', 'VIP룸'],
        'ru' => ['Часы работы', 'Как добраться', 'Стол на сегодня', 'Хотпот с дурианом', 'Сколько стоит', 'VIP'],
        'ar' => ['ساعات العمل', 'كيف أصل', 'طاولة اليوم', 'حلة الدجاج بالدوريان', 'كم السعر', 'VIP'],
    ];
    $ask = $chips[$lang] ?? $chips['en'];
    ob_start(); ?>
    <div class="gn-advisor">
      <p class="section-eyebrow" style="text-align:left"><?php echo esc_html(gn_t('sig_kicker')); ?></p>
      <h1><?php echo esc_html(gn_t('adv_title')); ?></h1>
      <p><?php echo esc_html($hello); ?></p>
      <div class="gn-advisor-chips" id="gnAdvisorChips">
        <?php foreach ($ask as $q): ?>
          <button type="button" data-q="<?php echo esc_attr($q); ?>"><?php echo esc_html($q); ?></button>
        <?php endforeach; ?>
      </div>
      <div class="gn-advisor-log" id="gnAdvisorLog" aria-live="polite"></div>
      <form id="gnAdvisorForm" class="gn-form-row" style="margin-top:12px">
        <input type="text" id="gnAdvisorText" required placeholder="<?php echo esc_attr(gn_t('adv_link')); ?>" aria-label="<?php echo esc_attr(gn_t('adv_link')); ?>">
        <button class="gn-cta-btn" type="submit"><?php echo esc_html(gn_t('qb_submit')); ?></button>
      </form>
      <p><a class="gn-cta-btn" href="<?php echo esc_url(home_url('/#gn-book-today')); ?>"><?php echo esc_html(gn_t('hero_cta1')); ?></a>
         <a class="gn-cta-btn ghost" href="<?php echo esc_url(gn_maps_url()); ?>"><?php echo esc_html(gn_t('loc_maps')); ?></a></p>
    </div>
    <script>
    (function(){
      var log=document.getElementById('gnAdvisorLog');
      var form=document.getElementById('gnAdvisorForm');
      var input=document.getElementById('gnAdvisorText');
      function say(text){var p=document.createElement('p');p.textContent=text;log.appendChild(p);log.scrollTop=log.scrollHeight;}
      function ask(msg){
        say(msg);
        var fd=new FormData();
        fd.append('action','gn_ai_chat');
        fd.append('nonce','<?php echo esc_js(wp_create_nonce('gn_ai')); ?>');
        fd.append('lang','<?php echo esc_js($lang); ?>');
        fd.append('message',msg);
        fetch('<?php echo esc_url(admin_url('admin-ajax.php')); ?>',{method:'POST',body:fd,credentials:'same-origin'})
          .then(function(r){return r.json();})
          .then(function(j){say((j&&j.data&&j.data.reply)?j.data.reply:'0979 232 233');})
          .catch(function(){say('0979 232 233');});
      }
      form.addEventListener('submit',function(e){e.preventDefault();var v=input.value.trim();if(!v)return;input.value='';ask(v);});
      document.getElementById('gnAdvisorChips').addEventListener('click',function(e){
        var b=e.target.closest('button'); if(!b) return; ask(b.getAttribute('data-q'));
      });
    })();
    </script>
    <?php
    return ob_get_clean();
}

