        ],
        [
            'name' => 'gn_voucher_ton',
            'description' => 'Tổng voucher đang lưu hành (nợ phải trả, KHÔNG phải doanh thu) và voucher giữ chỗ khách chưa trả tiền.',
            'inputSchema' => ['type' => 'object', 'properties' => []],
        ],
        [
            'name' => 'gn_luot_quet',
            'description' => 'Lượt quét mã QR theo đối tác và theo vật phẩm in (standee, thẻ bỏ túi, poster, sticker, QR số). Dùng để biết vật phẩm nào ra khách.',
            'inputSchema' => ['type' => 'object', 'properties' => [
                'tu_ngay' => $ngay, 'den_ngay' => $ngay,
                'ma_doi_tac' => ['type' => 'string'],
            ]],
        ],

        /* ── GHI NHẸ ───────────────────────────────────────────────────── */
        [
            'name' => 'gn_tao_doi_tac',
            'description' => 'GHI DỮ LIỆU. Tạo hồ sơ đối tác mới ở trạng thái active, sinh mã GN-Pxxx và token cổng theo dõi.',
            'inputSchema' => ['type' => 'object', 'required' => ['ten', 'dien_thoai', 'idempotency_key'], 'properties' => [
                'ten' => ['type' => 'string'],
                'dien_thoai' => ['type' => 'string'],
                'email' => ['type' => 'string'],
                'loai' => ['type' => 'string', 'description' => 'huong-dan-vien | cong-ty-du-lich | khach-san | tai-xe | kol | hiep-hoi | khac'],
                'khu_vuc' => ['type' => 'string'],
                'idempotency_key' => $idem,
            ]],
        ],
        [
            'name' => 'gn_duyet_doi_tac',
            'description' => 'GHI DỮ LIỆU. Chuyển đối tác từ pending sang active. Chưa duyệt thì mã QR của họ không gán được đơn.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma_doi_tac', 'idempotency_key'], 'properties' => [
                'ma_doi_tac' => ['type' => 'string'],
                'idempotency_key' => $idem,
            ]],
        ],
        [
            'name' => 'gn_gui_lai_link_cong',
            'description' => 'GHI DỮ LIỆU. Gửi lại email chứa link cổng theo dõi doanh số cho đối tác. Gửi email thật, không rút lại được.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma_doi_tac', 'idempotency_key'], 'properties' => [
                'ma_doi_tac' => ['type' => 'string'],
                'cap_token_moi' => ['type' => 'boolean', 'description' => 'true thì cấp token mới, link cũ hết hiệu lực ngay.'],
                'idempotency_key' => $idem,
            ]],
        ],

        /* ── ĐỤNG TIỀN — để risk_level NULL hoặc L3, BẮT BUỘC người duyệt ── */
        [
            'name' => 'gn_chot_doanh_so',
            'description' => 'ĐỤNG TIỀN — CẦN NGƯỜI DUYỆT. Ghi doanh số thực thu cho một đơn sau khi khách ăn xong. Quyết định hoa hồng phải trả cho đối tác. Nhập số tiền khách THỰC TRẢ sau giảm giá, không phải giá niêm yết.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma_don', 'doanh_so', 'idempotency_key'], 'properties' => [
                'ma_don' => ['type' => 'string'],
                'doanh_so' => ['type' => 'integer', 'description' => 'Số nguyên đồng.'],
                'idempotency_key' => $idem,
            ]],
        ],
        [
            'name' => 'gn_thu_tien_voucher',
            'description' => 'ĐỤNG TIỀN — CẦN NGƯỜI DUYỆT. Đánh dấu voucher giữ chỗ đã thanh toán, nạp số dư thật và ghi doanh số cho đối tác giới thiệu. Không thu hồi được.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma', 'idempotency_key'], 'properties' => [
                'ma' => ['type' => 'string'],
                'idempotency_key' => $idem,
            ]],
        ],
        [
            'name' => 'gn_tru_voucher',
            'description' => 'ĐỤNG TIỀN — CẦN NGƯỜI DUYỆT. Trừ tiền từ số dư voucher vào hoá đơn. Tiêu tiền của khách.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma', 'so_tien', 'idempotency_key'], 'properties' => [
                'ma' => ['type' => 'string'],
                'so_tien' => ['type' => 'integer', 'description' => 'Số nguyên đồng, phải lớn hơn 0.'],
                'idempotency_key' => $idem,
            ]],
        ],
        [
            'name' => 'gn_tam_dung_doi_tac',
            'description' => 'ĐỤNG TIỀN — CẦN NGƯỜI DUYỆT. Tạm dừng đối tác. Mã QR đã in và phát ra ngoài đời sẽ ngừng gán đơn ngay lập tức.',
            'inputSchema' => ['type' => 'object', 'required' => ['ma_doi_tac', 'idempotency_key'], 'properties' => [
                'ma_doi_tac' => ['type' => 'string'],
                'idempotency_key' => $idem,
            ]],
        ],
    ];
}

/* ═══════════════════════════════════════════════════════════════════════════
   THỰC THI TOOL
   ═══════════════════════════════════════════════════════════════════════════ */

function gn_mcp_goi_tool($ten, $args) {
    global $wpdb;
    if (!gn_mcp_san_sang()) {
        return ['loi' => 'Theme ganhngon-restaurant chưa nạp lớp thương mại. Kiểm tra functions.php.'];
    }
    $args = is_array($args) ? $args : [];
    $tz   = GN_MCP_TZ;
    $B = gn_mcp_tbl('bookings'); $P = gn_mcp_tbl('partners');
    $V = gn_mcp_tbl('vouchers'); $X = gn_mcp_tbl('voucher_txn'); $S = gn_mcp_tbl('scans');
    $DA_DEN = "('served','checked_in','completed')";

    switch ($ten) {

    /* ── ĐỌC ── */
    case 'gn_doanh_thu': {
        $tu  = gn_mcp_ngay($args['tu_ngay'] ?? '');
        $den = gn_mcp_ngay($args['den_ngay'] ?? '', $tu);
        $r = $wpdb->get_row($wpdb->prepare(
            "SELECT COALESCE(SUM(revenue),0) tong,
                    COALESCE(SUM(CASE WHEN partner_id IS NOT NULL THEN revenue END),0) qua_doi_tac,
                    COUNT(*) so_don
             FROM {$B} WHERE served_on BETWEEN %s AND %s AND booking_status IN {$DA_DEN}", $tu, $den));
        $vou = gn_mcp_vnd($wpdb->get_var($wpdb->prepare(
            "SELECT COALESCE(SUM(amount),0) FROM {$X}
             WHERE happened_on BETWEEN %s AND %s AND kind IN ('pay','topup')", $tu, $den)));
        $tong = gn_mcp_vnd($r->tong); $dt = gn_mcp_vnd($r->qua_doi_tac);
        return [
            'tu_ngay' => $tu, 'den_ngay' => $den, 'tz' => $tz,
            'doanh_thu_dat_ban' => $tong,
            'khach_tu_dat' => $tong - $dt,
            'qua_doi_tac' => $dt,
            'voucher_khach_tra' => $vou,
            'so_don' => (int) $r->so_don,
            'ghi_chu' => 'Chỉ tính đơn khách đã đến và đã thanh toán. Voucher tính vào ngày khách trả tiền.',
        ];
    }

    case 'gn_don_dat_ban': {
        $tu  = gn_mcp_ngay($args['tu_ngay'] ?? '');
        $den = gn_mcp_ngay($args['den_ngay'] ?? '', $tu);
        $gh  = min(200, max(1, (int) ($args['gioi_han'] ?? 50)));
        $sql = "SELECT booking_code, booking_date, customer_name, customer_phone, guests,
                       guest_type, booking_status, ref_code, revenue, served_on
                FROM {$B} WHERE booking_date BETWEEN %s AND %s";
        $p = [$tu, $den];
        if (!empty($args['trang_thai'])) { $sql .= " AND booking_status = %s"; $p[] = sanitize_text_field($args['trang_thai']); }
        if (!empty($args['ma_doi_tac'])) { $sql .= " AND ref_code = %s"; $p[] = strtoupper(sanitize_text_field($args['ma_doi_tac'])); }
        $sql .= " ORDER BY booking_date DESC, id DESC LIMIT " . $gh;
        $rows = $wpdb->get_results($wpdb->prepare($sql, $p));
        return ['tz' => $tz, 'so_dong' => count($rows), 'don' => array_map(function ($b) {
            return [
                'ma_don' => $b->booking_code, 'ngay' => $b->booking_date,
                'khach' => $b->customer_name, 'dien_thoai' => $b->customer_phone,
                'so_khach' => (int) $b->guests, 'cho_ngoi' => $b->guest_type,
                'trang_thai' => $b->booking_status,
                'ma_doi_tac' => $b->ref_code ?: null,
                'doanh_so' => gn_mcp_vnd($b->revenue),
                'ngay_phuc_vu' => $b->served_on,
            ];
        }, $rows)];
    }

    case 'gn_don_cho_chot': {
        $gh = min(200, max(1, (int) ($args['gioi_han'] ?? 50)));
        $rows = $wpdb->get_results(
            "SELECT booking_code, booking_date, customer_name, customer_phone, guests, ref_code
             FROM {$B}
             WHERE (revenue IS NULL OR revenue = 0)
               AND booking_status NOT IN ('cancelled','no_show')
             ORDER BY booking_date ASC, id ASC LIMIT " . $gh);
        return [
            'tz' => $tz, 'so_dong' => count($rows),
            'ghi_chu' => 'Chưa chốt doanh số thì hoa hồng đối tác vẫn bằng 0.',
            'don' => array_map(function ($b) {
                return ['ma_don' => $b->booking_code, 'ngay' => $b->booking_date,
                        'khach' => $b->customer_name, 'dien_thoai' => $b->customer_phone,
                        'so_khach' => (int) $b->guests, 'ma_doi_tac' => $b->ref_code ?: null];
            }, $rows),
        ];
    }

    case 'gn_doi_tac': {
        $ky = preg_match('/^\d{4}-\d{2}$/', (string) ($args['ky'] ?? '')) ? $args['ky'] : substr(gn_mcp_today(), 0, 7);
        $sql = "SELECT * FROM {$P}";
        $p = [];
        if (!empty($args['trang_thai'])) { $sql .= " WHERE status = %s"; $p[] = sanitize_text_field($args['trang_thai']); }
        $sql .= " ORDER BY id DESC";
        $rows = $p ? $wpdb->get_results($wpdb->prepare($sql, $p)) : $wpdb->get_results($sql);
        $out = [];
        foreach ($rows as $r) {
            $k = gn_partner_period($r->id, $ky);
            $out[] = [
                'ma' => $r->ref_code, 'ten' => $r->contact ?: $r->company,
                'loai' => $r->type, 'khu_vuc' => $r->area, 'trang_thai' => $r->status,
                'doanh_so_ky' => gn_mcp_vnd($k['doanh_so']),
                'hoa_hong' => gn_mcp_vnd($k['hoa_hong']),
                'thuong_2pt' => gn_mcp_vnd($k['thuong_2pt']),
                'phai_tra' => gn_mcp_vnd($k['phai_tra']),
                'dat_moc_thuong' => (bool) $k['dat_moc_thuong'],
            ];
        }
        return ['ky' => $ky, 'tz' => $tz, 'so_doi_tac' => count($out), 'doi_tac' => $out];
    }

    case 'gn_hoa_hong_ky': {
        $ma = strtoupper(sanitize_text_field($args['ma_doi_tac'] ?? ''));
        $ky = preg_match('/^\d{4}-\d{2}$/', (string) ($args['ky'] ?? '')) ? $args['ky'] : substr(gn_mcp_today(), 0, 7);
        $r = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$P} WHERE ref_code = %s", $ma));
        if (!$r) { return ['loi' => 'Không tìm thấy đối tác ' . $ma]; }
        $k = gn_partner_period($r->id, $ky);
        return [
            'ma' => $r->ref_code, 'ten' => $r->contact ?: $r->company, 'ky' => $ky, 'tz' => $tz,
            'doanh_so' => gn_mcp_vnd($k['doanh_so']),
            'hoa_hong_luy_tien' => gn_mcp_vnd($k['hoa_hong']),
            'thuong_2pt' => gn_mcp_vnd($k['thuong_2pt']),
            'dat_moc_thuong' => (bool) $k['dat_moc_thuong'],
            'con_thieu_de_dat_thuong' => gn_mcp_vnd($k['con_thieu']),
            'phai_tra' => gn_mcp_vnd($k['phai_tra']),
            'ty_le_thuc_phan_tram' => $k['ty_le_thuc'],
            'so_ngay_co_doanh_so' => (int) $k['so_ngay'],
            'theo_ngay' => array_map(function ($d) {
                return ['ngay' => $d['ngay'], 'doanh_so' => gn_mcp_vnd($d['doanh_so']), 'hoa_hong' => gn_mcp_vnd($d['hoa_hong'])];
            }, $k['theo_ngay']),
        ];
    }

    case 'gn_tinh_hoa_hong': {
        $ds = gn_mcp_vnd($args['doanh_so'] ?? 0);
        $bac = gn_commission_breakdown($ds);
        $hh = gn_mcp_vnd(gn_commission_for_day($ds));
        return [
            'doanh_so' => $ds, 'hoa_hong' => $hh,
            'ty_le_thuc_phan_tram' => $ds > 0 ? round($hh / $ds * 100, 2) : 0,
            'cac_bac' => array_map(function ($b) {
                return ['tu' => gn_mcp_vnd($b['tu']), 'den' => $b['den'] === null ? null : gn_mcp_vnd($b['den']),
                        'ty_le' => $b['ty_le'], 'doanh_so' => gn_mcp_vnd($b['doanh_so']), 'hoa_hong' => gn_mcp_vnd($b['hoa_hong'])];
            }, $bac),
            'ghi_chu' => 'Đây là máy tính duy nhất. WCC không được tự tính lại theo công thức khác.',
        ];
    }

    case 'gn_voucher': {
        $ma = strtoupper(sanitize_text_field($args['ma'] ?? ''));
        $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$V} WHERE code = %s", $ma));
        if (!$v) { return ['loi' => 'Không tìm thấy voucher ' . $ma]; }
        $txn = $wpdb->get_results($wpdb->prepare("SELECT kind, amount, happened_on, note FROM {$X} WHERE voucher_id = %d ORDER BY id", $v->id));
        return [
            'ma' => $v->code, 'trang_thai' => $v->status, 'tz' => $tz,
            'menh_gia' => gn_mcp_vnd($v->face_value),
            'gia_ban' => gn_mcp_vnd($v->price),
            'so_du' => gn_mcp_vnd($v->balance),
            'nguoi_mua' => $v->buyer_name,
            'ma_doi_tac' => $v->ref_code ?: null,
            'giu_den' => $v->hold_until, 'han_dung' => $v->expires_on, 'ngay_tra_tien' => $v->paid_on,
            'giao_dich' => array_map(function ($t) {
                return ['loai' => $t->kind, 'so_tien' => gn_mcp_vnd($t->amount), 'ngay' => $t->happened_on, 'ghi_chu' => $t->note];
            }, $txn),
        ];
    }

    case 'gn_voucher_ton': {
        return [
            'tz' => $tz,
            'luu_hanh' => gn_mcp_vnd($wpdb->get_var("SELECT COALESCE(SUM(balance),0) FROM {$V} WHERE status = 'paid'")),
            'giu_cho_chua_tra' => gn_mcp_vnd($wpdb->get_var("SELECT COALESCE(SUM(price),0) FROM {$V} WHERE status = 'unpaid'")),
            'ghi_chu' => 'Voucher lưu hành là NỢ PHẢI TRẢ, không phải doanh thu. Ghi thành doanh thu vào ngày khách dùng.',
        ];
    }

    case 'gn_luot_quet': {
        $tu  = gn_mcp_ngay($args['tu_ngay'] ?? '');
        $den = gn_mcp_ngay($args['den_ngay'] ?? '', $tu);
        $sql = "SELECT p.ref_code, s.medium, s.target, COUNT(*) so_luot
                FROM {$S} s JOIN {$P} p ON p.id = s.partner_id
                WHERE s.scanned_on BETWEEN %s AND %s";
        $pr = [$tu, $den];
        if (!empty($args['ma_doi_tac'])) { $sql .= " AND p.ref_code = %s"; $pr[] = strtoupper(sanitize_text_field($args['ma_doi_tac'])); }
        $sql .= " GROUP BY p.ref_code, s.medium, s.target ORDER BY so_luot DESC LIMIT 200";
        $rows = $wpdb->get_results($wpdb->prepare($sql, $pr));
        return ['tu_ngay' => $tu, 'den_ngay' => $den, 'tz' => $tz,
                'luot_quet' => array_map(function ($r) {
                    return ['ma_doi_tac' => $r->ref_code, 'vat_pham' => $r->medium,
                            'dich' => $r->target, 'so_luot' => (int) $r->so_luot];
                }, $rows)];
    }

    /* ── GHI NHẸ ── */
    case 'gn_tao_doi_tac': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }

        $ten = sanitize_text_field($args['ten'] ?? '');
        $dt  = sanitize_text_field($args['dien_thoai'] ?? '');
        if ($ten === '' || $dt === '') { return ['loi' => 'Thiếu tên hoặc số điện thoại']; }
        if ($wpdb->get_var($wpdb->prepare("SELECT id FROM {$P} WHERE phone = %s", $dt))) {
            return ['loi' => 'Số điện thoại này đã có đối tác'];
        }
        $max = (int) $wpdb->get_var("SELECT COALESCE(MAX(CAST(SUBSTRING(ref_code, 5) AS UNSIGNED)),0) FROM {$P} WHERE ref_code LIKE 'GN-P%'");
        $ref = sprintf('GN-P%03d', max(1, $max + 1));
        $tok = wp_generate_password(32, false, false);
        $wpdb->insert($P, [
            'company' => $ten, 'contact' => $ten,
            'email' => sanitize_email($args['email'] ?? ''), 'phone' => $dt,
            'type' => sanitize_text_field($args['loai'] ?? 'khac'),
            'ref_code' => $ref, 'status' => 'active', 'portal_token' => $tok,
            'area' => sanitize_text_field($args['khu_vuc'] ?? ''),
        ]);
        if (!$wpdb->insert_id) { return ['loi' => 'Không lưu được hồ sơ']; }
        return gn_mcp_idem_ghi($key, [
            'ma' => $ref, 'trang_thai' => 'active',
            'link_qr' => home_url('/p/' . $ref),
            'link_cong' => home_url('/cong-doi-tac/?t=' . $tok),
        ]);
    }

    case 'gn_duyet_doi_tac': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        $ma = strtoupper(sanitize_text_field($args['ma_doi_tac'] ?? ''));
        $n = $wpdb->update($P, ['status' => 'active'], ['ref_code' => $ma]);
        if ($n === false || $n === 0) { return ['loi' => 'Không tìm thấy đối tác ' . $ma . ' hoặc đã active']; }
        return gn_mcp_idem_ghi($key, ['ma' => $ma, 'trang_thai' => 'active']);
    }

    case 'gn_gui_lai_link_cong': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        $ma = strtoupper(sanitize_text_field($args['ma_doi_tac'] ?? ''));
        $r = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$P} WHERE ref_code = %s", $ma));
        if (!$r) { return ['loi' => 'Không tìm thấy đối tác ' . $ma]; }
        if (!$r->email) { return ['loi' => 'Đối tác ' . $ma . ' chưa có email']; }
        $tok = $r->portal_token;
        if (!empty($args['cap_token_moi']) || !$tok) {
            $tok = wp_generate_password(32, false, false);
            $wpdb->update($P, ['portal_token' => $tok], ['id' => $r->id]);
        }
        $link = home_url('/cong-doi-tac/?t=' . $tok);
        @wp_mail($r->email, 'Link cổng theo dõi doanh số — ' . $ma,
            "Chào " . ($r->contact ?: $r->company) . ",\n\nLink cổng theo dõi doanh số riêng của bạn:\n$link\n\n"
          . "Giữ link này riêng — ai có link là xem được số liệu của bạn.\n\n— Gánh Ngon Phú Quốc",
            ['Content-Type: text/plain; charset=UTF-8']);
        return gn_mcp_idem_ghi($key, ['ma' => $ma, 'da_gui_toi' => $r->email, 'token_moi' => !empty($args['cap_token_moi'])]);
    }

    /* ── ĐỤNG TIỀN ── */
    case 'gn_chot_doanh_so': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        $ma = sanitize_text_field($args['ma_don'] ?? '');
        $ds = gn_mcp_vnd($args['doanh_so'] ?? 0);
        if ($ds < 0) { return ['loi' => 'Doanh số không được âm']; }
        $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$B} WHERE booking_code = %s", $ma));
        if (!$b) { return ['loi' => 'Không tìm thấy đơn ' . $ma]; }
        $hom_nay = gn_mcp_today();
        $wpdb->update($B, ['revenue' => $ds, 'served_on' => $hom_nay,
                           'booking_status' => 'served', 'payment_status' => 'paid'], ['id' => $b->id]);
        $ngay_dt = 0; $hh = 0;
        if ($b->partner_id) {
            $ngay_dt = gn_mcp_vnd($wpdb->get_var($wpdb->prepare(
                "SELECT COALESCE(SUM(revenue),0) FROM {$B}
                 WHERE partner_id = %d AND served_on = %s AND booking_status IN {$DA_DEN}",
                $b->partner_id, $hom_nay)));
            $hh = gn_mcp_vnd(gn_commission_for_day($ngay_dt));
        }
        return gn_mcp_idem_ghi($key, [
            'ma_don' => $ma, 'doanh_so_don' => $ds, 'ngay_phuc_vu' => $hom_nay, 'tz' => $tz,
            'ma_doi_tac' => $b->ref_code ?: null,
            'doanh_so_ngay_cua_doi_tac' => $ngay_dt,
            'hoa_hong_ngay_cua_doi_tac' => $hh,
        ]);
    }

    case 'gn_thu_tien_voucher': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        $ma = strtoupper(sanitize_text_field($args['ma'] ?? ''));
        $v = $wpdb->get_row($wpdb->prepare("SELECT id, price FROM {$V} WHERE code = %s", $ma));
        if (!$v) { return ['loi' => 'Không tìm thấy voucher ' . $ma]; }
        if (!function_exists('gn_voucher_mark_paid')) { return ['loi' => 'Theme chưa nạp gn_voucher_mark_paid']; }
        if (!gn_voucher_mark_paid($v->id)) { return ['loi' => 'Voucher không ở trạng thái chờ thanh toán']; }
        return gn_mcp_idem_ghi($key, ['ma' => $ma, 'da_thu' => gn_mcp_vnd($v->price), 'trang_thai' => 'paid', 'tz' => $tz]);
    }

    case 'gn_tru_voucher': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        if (!function_exists('gn_voucher_redeem')) { return ['loi' => 'Theme chưa nạp gn_voucher_redeem']; }
        $r = gn_voucher_redeem(strtoupper(sanitize_text_field($args['ma'] ?? '')), gn_mcp_vnd($args['so_tien'] ?? 0));
        if (empty($r['ok'])) { return ['loi' => $r['msg'] ?? 'Không trừ được']; }
        return gn_mcp_idem_ghi($key, ['da_dung' => gn_mcp_vnd($r['da_dung']), 'con_lai' => gn_mcp_vnd($r['con_lai']), 'tz' => $tz]);
    }

    case 'gn_tam_dung_doi_tac': {
        $key = (string) ($args['idempotency_key'] ?? '');
        if ($key === '') { return ['loi' => 'Thiếu idempotency_key']; }
        $cu = gn_mcp_idem_doc($key); if ($cu) { return $cu + ['tu_bo_nho_chong_trung' => true]; }
        $ma = strtoupper(sanitize_text_field($args['ma_doi_tac'] ?? ''));
        $n = $wpdb->update($P, ['status' => 'paused'], ['ref_code' => $ma]);
        if ($n === false || $n === 0) { return ['loi' => 'Không tìm thấy đối tác ' . $ma . ' hoặc đã tạm dừng']; }
        return gn_mcp_idem_ghi($key, ['ma' => $ma, 'trang_thai' => 'paused',
            'canh_bao' => 'Mã QR đã in và phát ra ngoài đời ngừng gán đơn ngay lập tức.']);
    }

    }
    return ['loi' => 'Không có tool tên ' . $ten];
}

/* ═══════════════════════════════════════════════════════════════════════════
   GIAO THỨC MCP — JSON-RPC 2.0 qua HTTP POST
   ═══════════════════════════════════════════════════════════════════════════ */

function gn_mcp_ket_qua($id, $result) {
    return ['jsonrpc' => '2.0', 'id' => $id, 'result' => $result];
}
function gn_mcp_loi($id, $code, $message) {
    return ['jsonrpc' => '2.0', 'id' => $id, 'error' => ['code' => $code, 'message' => $message]];
}

add_action('rest_api_init', function () {
    register_rest_route(GN_MCP_NS, '/rpc', [
        'methods'  => 'POST',
        'callback' => 'gn_mcp_xu_ly',
        // Token trong header Authorization. WCC lưu ở McpServer.headers (đã mã hoá).
        'permission_callback' => function (WP_REST_Request $req) {
            $token = gn_wcc_token();
            if ($token === '') {
                return new WP_Error('gn_mcp_chua_bat', 'Kết nối WCC chưa bật. Vào wp-admin → Gánh Ngon → Kết nối WCC → Bật.', ['status' => 503]);
            }
            $h = (string) $req->get_header('authorization');
            if (stripos($h, 'Bearer ') !== 0) {
                return new WP_Error('gn_mcp_thieu_token', 'Thiếu header Authorization: Bearer', ['status' => 401]);
            }
            // hash_equals: so sánh thời gian cố định, không để lộ token qua kênh thời gian
            if (!hash_equals($token, trim(substr($h, 7)))) {
                return new WP_Error('gn_mcp_token_sai', 'Token không đúng', ['status' => 401]);
            }
            return true;
        },
    ]);
});

function gn_mcp_xu_ly(WP_REST_Request $req) {
    $body = $req->get_json_params();
    if (!is_array($body)) { return new WP_REST_Response(gn_mcp_loi(null, -32700, 'JSON hỏng'), 200); }

    // Hỗ trợ gọi theo lô: WCC có thể gửi mảng nhiều lệnh trong một lượt.
    $la_lo = isset($body[0]) && is_array($body[0]);
    $cac_lenh = $la_lo ? $body : [$body];
    $tra = [];

    foreach ($cac_lenh as $lenh) {
        $id  = $lenh['id'] ?? null;
        $pt  = (string) ($lenh['method'] ?? '');
        $ps  = isset($lenh['params']) && is_array($lenh['params']) ? $lenh['params'] : [];

        switch ($pt) {
        case 'initialize':
            $tra[] = gn_mcp_ket_qua($id, [
                'protocolVersion' => isset($ps['protocolVersion']) ? (string) $ps['protocolVersion'] : GN_MCP_PROTO,
                'capabilities' => ['tools' => ['listChanged' => false]],
                'serverInfo' => ['name' => 'ganhngon-mcp', 'version' => '1.0.0'],
                'instructions' =>
                    "Số liệu nhà hàng Gánh Ngon Phú Quốc.\n"
                  . "Mọi số tiền là SỐ NGUYÊN ĐỒNG. Mọi ngày là YYYY-MM-DD theo giờ Việt Nam (Asia/Ho_Chi_Minh).\n"
                  . "Hoa hồng đối tác luỹ tiến theo doanh số TỪNG NGÀY: 0-5tr 10%, 5-10tr 12%, trên 10tr 15%; "
                  . "cộng 2% tổng doanh số tháng nếu tháng đạt 100 triệu. gn_tinh_hoa_hong là máy tính DUY NHẤT, đừng tự tính lại.\n"
                  . "Bốn tool gn_chot_doanh_so, gn_thu_tien_voucher, gn_tru_voucher, gn_tam_dung_doi_tac đụng tiền thật "
                  . "và cần người duyệt. Mọi tool ghi đều bắt buộc idempotency_key.",
            ]);
            break;

        case 'notifications/initialized':
            break;   // thông báo, không trả lời

        case 'ping':
            $tra[] = gn_mcp_ket_qua($id, new stdClass());
            break;

        case 'tools/list':
            $tra[] = gn_mcp_ket_qua($id, ['tools' => gn_mcp_tools()]);
            break;

        case 'tools/call': {
            $ten  = (string) ($ps['name'] ?? '');
            $args = isset($ps['arguments']) && is_array($ps['arguments']) ? $ps['arguments'] : [];
            $hop_le = false;
            foreach (gn_mcp_tools() as $t) { if ($t['name'] === $ten) { $hop_le = true; break; } }
            if (!$hop_le) { $tra[] = gn_mcp_loi($id, -32602, 'Không có tool tên ' . $ten); break; }

            try {
                $kq = gn_mcp_goi_tool($ten, $args);
            } catch (\Throwable $e) {
                // Lỗi trả về trong result với isError, KHÔNG ném lỗi giao thức —
                // để AI đọc được nguyên nhân thay vì chỉ thấy "gọi hỏng".
                $kq = ['loi' => 'Lỗi khi chạy tool: ' . $e->getMessage()];
            }
            $co_loi = isset($kq['loi']);
            $tra[] = gn_mcp_ket_qua($id, [
                'content' => [['type' => 'text', 'text' => wp_json_encode($kq, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT)]],
                'isError' => $co_loi,
            ]);
            break;
        }

        default:
            $tra[] = gn_mcp_loi($id, -32601, 'Không hỗ trợ method ' . $pt);
        }
    }

    if (!$tra) { return new WP_REST_Response(null, 204); }   // toàn thông báo
    return new WP_REST_Response($la_lo ? $tra : $tra[0], 200);
}

/* ═══════════════════════════════════════════════════════════════════════════
   MÀN KIỂM TRA TRONG WP-ADMIN
   ═══════════════════════════════════════════════════════════════════════════ */


/* ═══════════════════════════════════════════════════════════════════════════
   ĐẨY SỰ KIỆN SANG WCC (webhook một chiều)
   --------------------------------------------------------------------------
   Không bao giờ nằm trong luồng phục vụ khách: có chuyện thì ghi hàng đợi rồi
   trả trang ngay, một tiến trình nền đẩy sau. Khách đặt bàn xong phải thấy "đã
   nhận" kể cả khi WCC đang tắt.
   ═══════════════════════════════════════════════════════════════════════════ */

const GN_WCC_QUEUE = 'gn_wcc_queue';
const GN_WCC_CRON  = 'gn_wcc_retry';
const GN_WCC_MAX   = 100;

function gn_wcc_webhook() { return trim((string) get_option('gn_wcc_webhook', '')); }
function gn_wcc_bat()     { return get_option('gn_wcc_enabled', '0') === '1'; }

/** Bắn một sự kiện. UUID chống trùng để WCC bỏ qua bản gửi lại. */
function gn_wcc_event($loai, array $data) {
    if (!gn_wcc_bat()) return;
    $payload = [
        'su_kien'    => $loai,
        'su_kien_id' => wp_generate_uuid4(),
        'tz'         => 'Asia/Ho_Chi_Minh',
        'site'       => home_url(),
        'gui_luc'    => (new DateTime('now', new DateTimeZone('Asia/Ho_Chi_Minh')))->format('c'),
        'du_lieu'    => $data,
    ];
    gn_wcc_gui($payload, true);
}

function gn_wcc_gui(array $payload, $lan_dau = true) {
    $url = gn_wcc_webhook();
    if ($url === '') return false;
    $token = gn_wcc_token();
    $res = wp_remote_post($url, [
        'timeout'  => 8,
        'blocking' => true,
        'headers'  => [
            'Content-Type'  => 'application/json; charset=utf-8',
            'Authorization' => $token !== '' ? 'Bearer ' . $token : '',
        ],
        'body' => wp_json_encode($payload, JSON_UNESCAPED_UNICODE),
    ]);
    if (is_wp_error($res)) { if ($lan_dau) gn_wcc_xep_hang($payload); return false; }
    $ma = (int) wp_remote_retrieve_response_code($res);
    if ($ma >= 200 && $ma < 300) return true;
    if ($lan_dau && ($ma >= 500 || $ma === 429)) gn_wcc_xep_hang($payload);
    return false;
}

function gn_wcc_xep_hang(array $payload) {
    $q = get_option(GN_WCC_QUEUE, []);
    if (!is_array($q)) $q = [];
    if (count($q) >= GN_WCC_MAX) array_shift($q);
    $q[] = $payload;
    update_option(GN_WCC_QUEUE, $q, false);
    if (!wp_next_scheduled(GN_WCC_CRON)) wp_schedule_single_event(time() + 300, GN_WCC_CRON);
}

add_action(GN_WCC_CRON, function () {
    $q = get_option(GN_WCC_QUEUE, []);
    if (!is_array($q) || !$q) return;
    $con = [];
    foreach ($q as $p) if (!gn_wcc_gui($p, false)) $con[] = $p;
    update_option(GN_WCC_QUEUE, $con, false);
    if ($con && !wp_next_scheduled(GN_WCC_CRON)) wp_schedule_single_event(time() + 900, GN_WCC_CRON);
});

/* ── Móc 8 sự kiện vào các hành động đã có sẵn trong theme ── */

add_action('gn_booking_created', function ($booking_id, $code, $ref) {
    global $wpdb;
    $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . " WHERE id = %d", $booking_id));
    if (!$b) return;
    gn_wcc_event('dat_ban.tao', [
        'ma_don' => $b->booking_code, 'khach' => $b->customer_name, 'dien_thoai' => $b->customer_phone,
        'email' => $b->customer_email, 'ngay' => $b->booking_date, 'so_khach' => (int) $b->guests,
        'cho_ngoi' => $b->guest_type, 'ghi_chu' => $b->notes, 'ma_doi_tac' => $b->ref_code ?: null,
    ]);
    if ((int) $b->guests >= 10) {
        gn_wcc_event('doan.lon', ['ma_don' => $b->booking_code, 'so_khach' => (int) $b->guests,
            'ngay' => $b->booking_date, 'ghi_chu' => $b->notes]);
    }
}, 20, 3);

add_action('gn_booking_settled', function ($booking_id, $revenue, $ref_code, $day_revenue) {
    global $wpdb;
    $b = $wpdb->get_row($wpdb->prepare("SELECT booking_code, served_on FROM " . gn_tbl('bookings') . " WHERE id = %d", $booking_id));
    gn_wcc_event('dat_ban.chot', [
        'ma_don' => $b ? $b->booking_code : null, 'doanh_so' => (int) round($revenue),
        'ngay_phuc_vu' => $b ? $b->served_on : null, 'ma_doi_tac' => $ref_code ?: null,
        'doanh_so_ngay_doi_tac' => (int) round($day_revenue),
        'hoa_hong_ngay' => $ref_code ? (int) gn_commission_for_day($day_revenue) : 0,
    ]);
}, 20, 4);

add_action('gn_partner_registered', function ($ref, $name, $phone, $type) {
    gn_wcc_event('doi_tac.dang_ky', ['ma' => $ref, 'ten' => $name, 'dien_thoai' => $phone, 'loai' => $type]);
}, 20, 4);

add_action('gn_voucher_issued', function ($voucher_id) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if ($v) gn_wcc_event('voucher.phat_hanh', ['ma' => $v->code, 'menh_gia' => (int) round($v->face_value),
        'gia' => (int) round($v->price), 'ma_doi_tac' => $v->ref_code ?: null, 'giu_den' => $v->hold_until]);
}, 20, 1);

add_action('gn_voucher_paid', function ($voucher_id) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if ($v) gn_wcc_event('voucher.thanh_toan', ['ma' => $v->code, 'da_thu' => (int) round($v->price),
        'ma_doi_tac' => $v->ref_code ?: null]);
}, 20, 1);

add_action('gn_voucher_redeemed', function ($voucher_id, $used, $left) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT code, ref_code FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if ($v) gn_wcc_event('voucher.su_dung', ['ma' => $v->code, 'da_dung' => (int) round($used),
        'con_lai' => (int) round($left), 'ma_doi_tac' => $v->ref_code ?: null]);
}, 20, 3);

/* ═══════════════════════════════════════════════════════════════════════════
   TRANG KẾT NỐI WCC — một nút bật/tắt
   ═══════════════════════════════════════════════════════════════════════════ */

add_action('admin_menu', function () {
    add_submenu_page('gn-home', 'Kết nối WCC', 'Kết nối WCC', 'manage_options', 'gn-wcc', 'gn_wcc_admin');
}, 20);

function gn_wcc_admin() {
    if (!current_user_can('manage_options')) wp_die('Không có quyền');

    if (isset($_POST['gn_wcc_act']) && check_admin_referer('gn_wcc')) {
        $act = sanitize_text_field($_POST['gn_wcc_act']);
        if ($act === 'bat') {
            if (get_option('gn_wcc_token', '') === '' && !defined('GN_MCP_TOKEN')) {
                update_option('gn_wcc_token', 'wcc_' . wp_generate_password(40, false, false), false);
            }
            update_option('gn_wcc_webhook', esc_url_raw($_POST['webhook'] ?? ''), false);
            update_option('gn_wcc_enabled', '1', false);
            echo '<div class="notice notice-success"><p>Đã bật kết nối WCC.</p></div>';
        } elseif ($act === 'tat') {
            update_option('gn_wcc_enabled', '0', false);
            echo '<div class="notice notice-warning"><p>Đã tắt kết nối. Token và cấu hình vẫn giữ, bật lại là chạy.</p></div>';
        } elseif ($act === 'token_moi') {
            update_option('gn_wcc_token', 'wcc_' . wp_generate_password(40, false, false), false);
            echo '<div class="notice notice-success"><p>Đã cấp token mới. Cập nhật lại bên WCC — token cũ hết hiệu lực.</p></div>';
        } elseif ($act === 'thu') {
            $old = get_option('gn_wcc_enabled', '0');
            update_option('gn_wcc_enabled', '1', false);
            $ok = gn_wcc_gui(['su_kien' => 'ket_noi.thu', 'su_kien_id' => wp_generate_uuid4(),
                'site' => home_url(), 'du_lieu' => ['thong_diep' => 'Ganh Ngon gui thu']], false);
            update_option('gn_wcc_enabled', $old, false);
            echo $ok
                ? '<div class="notice notice-success"><p>WCC nhận được. Webhook thông.</p></div>'
                : '<div class="notice notice-error"><p>WCC chưa nhận được — kiểm tra lại URL webhook và token bên WCC.</p></div>';
        }
    }

    $bat = gn_wcc_bat();
    $token = gn_wcc_token();
    $webhook = gn_wcc_webhook();
    $mcp_url = rest_url(GN_MCP_NS . '/rpc');
    $con_hang = count((array) get_option(GN_WCC_QUEUE, []));
    $tools = gn_mcp_tools();
    ?>
    <div class="wrap" style="max-width:1000px">
      <h1>Kết nối Work Command Center</h1>
      <p style="font-size:14px;color:#50575e">Nối hai chiều: Gánh Ngon đẩy sự kiện (đặt bàn, voucher, hoa hồng)
        sang WCC, và WCC gọi ngược vào để đọc số liệu lẫn ra lệnh — mọi lệnh đụng tiền đều qua người duyệt bên WCC.</p>

      <div class="card" style="max-width:none;padding:20px 24px">
        <h2 style="margin-top:0">Trạng thái:
          <?php echo $bat ? '<span style="color:#1E7A4C">● ĐANG BẬT</span>' : '<span style="color:#B45309">○ ĐANG TẮT</span>'; ?>
        </h2>
        <form method="post"><?php wp_nonce_field('gn_wcc'); ?>
          <table class="form-table">
            <tr><th>URL webhook của WCC</th>
              <td><input type="url" name="webhook" value="<?php echo esc_attr($webhook); ?>"
                    class="large-text" placeholder="https://wcc.../api/webhooks/&lt;token&gt;/">
                <p class="description">Lấy từ WCC: Cài đặt → Kết nối MCP / API → nguồn webhook. Nơi Gánh Ngon đẩy sự kiện tới.</p></td></tr>
          </table>
          <?php if (!$bat): ?>
            <button class="button button-primary button-hero" name="gn_wcc_act" value="bat">Bật kết nối</button>
          <?php else: ?>
            <button class="button button-primary" name="gn_wcc_act" value="bat">Lưu URL</button>
            <button class="button" name="gn_wcc_act" value="thu">Gửi thử sang WCC</button>
            <button class="button" name="gn_wcc_act" value="tat"
              onclick="return confirm('Tắt kết nối? Sự kiện sẽ ngừng đẩy sang WCC.')">Tắt kết nối</button>
          <?php endif; ?>
        </form>
      </div>

      <?php if ($token !== ''): ?>
      <div class="card" style="max-width:none;padding:20px 24px">
        <h2 style="margin-top:0">Khai vào WCC để nó gọi ngược lại</h2>
        <p>Bên WCC: Cài đặt → Kết nối MCP / API → thêm máy chủ MCP với đúng ba dòng sau:</p>
        <table class="widefat striped" style="max-width:760px">
          <tbody>
            <tr><th style="width:150px">transport</th><td><code>http</code></td></tr>
            <tr><th>url</th><td><code><?php echo esc_html($mcp_url); ?></code></td></tr>
            <tr><th>headers</th><td><code>{"Authorization": "Bearer <?php echo esc_html($token); ?>"}</code></td></tr>
          </tbody>
        </table>
        <p style="margin-top:12px">
          <?php if (!defined('GN_MCP_TOKEN')): ?>
          <form method="post" style="display:inline"><?php wp_nonce_field('gn_wcc'); ?>
            <button class="button" name="gn_wcc_act" value="token_moi"
              onclick="return confirm('Cấp token mới? Phải cập nhật lại bên WCC, token cũ hết hiệu lực ngay.')">Cấp token mới</button>
          </form>
          <?php else: ?>
          <span class="description">Token đang lấy từ hằng số GN_MCP_TOKEN trong wp-config.php.</span>
          <?php endif; ?>
        </p>
      </div>
      <?php endif; ?>

      <div class="card" style="max-width:none;padding:20px 24px">
        <h2 style="margin-top:0"><?php echo count($tools); ?> việc WCC làm được với Gánh Ngon</h2>
        <?php if ($con_hang > 0): ?>
          <div class="notice notice-warning inline"><p><b><?php echo $con_hang; ?> sự kiện</b> đang chờ đẩy lại
            (WCC vừa bận hoặc chưa cấu hình đúng). Hệ thống tự thử lại, không mất.</p></div>
        <?php endif; ?>
        <table class="widefat striped">
          <thead><tr><th style="width:210px">Việc</th><th>Mô tả</th><th style="width:130px">Mức duyệt</th></tr></thead>
          <tbody>
          <?php foreach ($tools as $t):
            $tien = strpos($t['description'], 'ĐỤNG TIỀN') === 0;
            $ghi  = strpos($t['description'], 'GHI DỮ LIỆU') === 0; ?>
            <tr>
              <td><code><?php echo esc_html($t['name']); ?></code></td>
              <td><?php echo esc_html($t['description']); ?></td>
              <td><?php echo $tien ? '<b style="color:#B42318">Cần người duyệt</b>'
                    : ($ghi ? '<span style="color:#B45309">Nhắc rồi chạy</span>'
                            : '<span style="color:#1E7A4C">Tự động</span>'); ?></td>
            </tr>
          <?php endforeach; ?>
          </tbody>
        </table>
        <div class="notice notice-info inline" style="margin-top:14px"><p>
          Bốn việc đụng tiền khi WCC dò thấy sẽ mặc định <b>bị chặn</b> cho tới khi người vận hành WCC gán mức —
          đó là ý đồ "AI làm, người duyệt". Không có việc xoá đối tác qua WCC; xoá chỉ làm tay ở đây.</p></div>
      </div>
    </div>
    <?php
}

