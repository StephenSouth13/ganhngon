add_action('gn_booking_settled', function ($booking_id, $revenue) {
    global $wpdb;
    $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . " WHERE id=%d", $booking_id));
    if (!$b) return;
    $dich_vu = 'Dùng bữa tại nhà hàng · ' . (int) $b->guests . ' khách';
    $ngay = date('d/m/Y', strtotime($b->served_on ?: current_time('Y-m-d')));
    gn_send_customer_invoice([
        'email'      => $b->customer_email,
        'ten_khach'  => $b->customer_name ?: 'Quý khách',
        'ma_don'     => $b->booking_code,
        'dich_vu'    => $dich_vu,
        'ngay'       => $ngay,
        'tong'       => gn_money($revenue),
        'ma_hoa_don' => gn_invoice_no('GNB', $b->id),
        'link'       => home_url('/dat-ban/?ma=' . rawurlencode($b->booking_code)),
    ]);
    gn_partner_notice_for($b->partner_id, $revenue, [
        'ma_don'    => $b->booking_code,
        'ten_khach' => $b->customer_name ?: 'Khách lẻ',
        'dich_vu'   => $dich_vu,
        'ngay'      => $ngay,
    ]);
}, 10, 2);

