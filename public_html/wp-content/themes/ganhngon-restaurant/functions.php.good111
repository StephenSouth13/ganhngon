/**
 * Thay toàn bộ nội dung trang /doi-tac/ bằng bản dựng lại ở trên.
 * Nội dung cũ vẫn nằm nguyên trong database — xoá filter này là nó hiện lại.
 */
function gn_replace_partner_page($content) {
    if (is_admin() || !in_the_loop() || !is_main_query()) return $content;
    if (!is_page()) return $content;
    $slug = get_post_field('post_name', get_queried_object_id());
    if ($slug !== 'doi-tac') return $content;
    return gn_partner_page_html();
}
add_filter('the_content', 'gn_replace_partner_page', 5);

/* --------------------------------------------------------------------------
   Tiêu đề SEO và meta description của /doi-tac/ đang ghi "Hoa Hồng 10–25%",
   lấy từ Yoast trong wp-admin. Con số đó thuộc hệ 4 hạng cũ, giờ sai.
   Công thức hiện tại: luỹ tiến theo ngày 10 / 12 / 15% + thưởng 2% theo tháng.
   Sửa qua filter để không phải vào wp-admin. Muốn đổi lại: xoá khối này rồi
   sửa thẳng trong Yoast.
   -------------------------------------------------------------------------- */

function gn_is_partner_page() {
    if (is_admin() || !is_page()) return false;
    return get_post_field('post_name', get_queried_object_id()) === 'doi-tac';
}

function gn_partner_seo_title($title) {
    return gn_is_partner_page()
        ? 'Đối tác Gánh Ngon — hoa hồng luỹ tiến 10 · 12 · 15% mỗi ngày'
        : $title;
}
function gn_partner_seo_desc($desc) {
    return gn_is_partner_page()
        ? 'Nhận mã QR riêng, khách quét là hoa hồng về bạn. Luỹ tiến theo doanh số từng ngày: 10% · 12% · 15%, thêm 2% khi tháng đạt 100 triệu. Chuyển khoản ngày 5, có bảng kê từng đơn.'
        : $desc;
}

add_filter('wpseo_title',            'gn_partner_seo_title', 20);
add_filter('wpseo_opengraph_title',  'gn_partner_seo_title', 20);
add_filter('wpseo_twitter_title',    'gn_partner_seo_title', 20);
add_filter('pre_get_document_title', 'gn_partner_seo_title', 20);
add_filter('wpseo_metadesc',           'gn_partner_seo_desc', 25);
add_filter('wpseo_opengraph_desc',     'gn_partner_seo_desc', 20);
add_filter('wpseo_twitter_description','gn_partner_seo_desc', 20);

/**
 * page.php in sẵn một khối hero có <h1> tiêu đề. Trang đối tác đã có hero riêng
 * nên hai tiêu đề lớn chồng nhau. Gắn class để CSS ẩn hero mặc định đi.
 */
function gn_partner_body_class($classes) {
    if (gn_is_partner_page()) $classes[] = 'gn-partner-page';
    return $classes;
}
add_filter('body_class', 'gn_partner_body_class');

// JSON-LD của Yoast đi đường riêng, không qua wpseo_title — phải sửa thêm ở đây
function gn_partner_schema_webpage($data) {
    if (!gn_is_partner_page()) return $data;
    if (isset($data['name']))        $data['name']        = gn_partner_seo_title('');
    if (isset($data['description'])) $data['description'] = gn_partner_seo_desc('');
    return $data;
}
add_filter('wpseo_schema_webpage', 'gn_partner_schema_webpage', 20);

/**
 * Gánh Ngon — lớp thương mại: gán mã đối tác, hoa hồng luỹ tiến, voucher.
 *
 * Bổ sung cho sao-booking-engine, không thay thế. Ba lỗ hổng của bản gốc:
 *   1. partner_login() chỉ trả lỗi -> hồ sơ đăng ký đối tác bị vứt đi
 *   2. create_booking() không đọc ref_code -> không có dữ liệu tính hoa hồng
 *   3. sao_bookings không có cột đối tác lẫn doanh số thực thu
 *
 * Hoa hồng: luỹ tiến theo DOANH SỐ TỪNG NGÀY của mỗi đối tác
 *   0 – 5.000.000đ    : 10%
 *   5.000.000 – 10tr  : 12%
 *   trên 10.000.000đ  : 15%
 * Cộng 2% tổng doanh số tháng nếu luỹ kế tháng đạt từ 100.000.000đ.
 *
 * @package ganhngon
 */



define('GN_COMMERCE_VERSION', '1.1.0');
define('GN_REF_COOKIE', 'gn_ref');
define('GN_REF_DAYS', 30);

function gn_tbl($name) { global $wpdb; return $wpdb->prefix . 'sao_' . $name; }

/* ==========================================================================
   1. LƯỢC ĐỒ
   ========================================================================== */

function gn_column_exists($table, $column) {
    global $wpdb;
    $found = $wpdb->get_var($wpdb->prepare(
        "SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS
         WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = %s AND COLUMN_NAME = %s",
        $table, $column
    ));
    return !empty($found);
}

function gn_commerce_migrate() {
    global $wpdb;
    $charset = $wpdb->get_charset_collate();
    $bookings = gn_tbl('bookings');
    $partners = gn_tbl('partners');

    // --- cột gán đối tác cho từng đơn: bản gốc hoàn toàn không có ---
    $add = [
        'partner_id' => "ALTER TABLE {$bookings} ADD COLUMN partner_id INT NULL DEFAULT NULL",
        'ref_code'   => "ALTER TABLE {$bookings} ADD COLUMN ref_code VARCHAR(50) NULL DEFAULT NULL",
        'revenue'    => "ALTER TABLE {$bookings} ADD COLUMN revenue DECIMAL(12,2) NOT NULL DEFAULT 0",
        'served_on'  => "ALTER TABLE {$bookings} ADD COLUMN served_on DATE NULL DEFAULT NULL",
    ];
    foreach ($add as $col => $sql) {
        if (!gn_column_exists($bookings, $col)) $wpdb->query($sql);
    }
    if (!gn_column_exists($bookings, 'qr_scanned_at')) {
        $wpdb->query("ALTER TABLE {$bookings} ADD COLUMN qr_scanned_at DATETIME NULL DEFAULT NULL");
    }
    foreach ([
        'same_day'       => "ALTER TABLE {$bookings} ADD COLUMN same_day TINYINT(1) NOT NULL DEFAULT 0",
        'signature_dish' => "ALTER TABLE {$bookings} ADD COLUMN signature_dish TINYINT(1) NOT NULL DEFAULT 0",
        'lead_class'     => "ALTER TABLE {$bookings} ADD COLUMN lead_class VARCHAR(20) NULL DEFAULT NULL",
    ] as $col => $sql) {
        if (!gn_column_exists($bookings, $col)) $wpdb->query($sql);
    }
    $wpdb->query("ALTER TABLE {$bookings} ADD INDEX gn_partner_day (partner_id, served_on)");
    $wpdb->query("ALTER TABLE {$bookings} ADD INDEX gn_same_day (booking_date, same_day)");

    // --- đối tác: token cổng riêng + thông tin trả tiền ---
    foreach ([
        'portal_token' => "ALTER TABLE {$partners} ADD COLUMN portal_token VARCHAR(64) NULL DEFAULT NULL",
        'area'         => "ALTER TABLE {$partners} ADD COLUMN area VARCHAR(255) NULL DEFAULT NULL",
        'social_link'  => "ALTER TABLE {$partners} ADD COLUMN social_link VARCHAR(255) NULL DEFAULT NULL",
        'intro'        => "ALTER TABLE {$partners} ADD COLUMN intro TEXT NULL",
        'bank_info'    => "ALTER TABLE {$partners} ADD COLUMN bank_info VARCHAR(255) NULL DEFAULT NULL",
        'role'         => "ALTER TABLE {$partners} ADD COLUMN role VARCHAR(20) NOT NULL DEFAULT 'partner'",
    ] as $col => $sql) {
        if (!gn_column_exists($partners, $col)) $wpdb->query($sql);
    }
    $wpdb->query("ALTER TABLE {$partners} ADD INDEX gn_role_status (role, status)");
    if (gn_column_exists($partners, 'role')) {
        $wpdb->query("UPDATE {$partners} SET role='kol' WHERE type IN ('kol','blogger') AND role IN ('','partner')");
        $wpdb->query("UPDATE {$partners} SET role='koc' WHERE type='koc' AND role IN ('','partner')");
        $wpdb->query("UPDATE {$partners} SET role='affiliate' WHERE type IN ('affiliate','ctv','cong-tac-vien') AND role IN ('','partner')");
    }

    require_once ABSPATH . 'wp-admin/includes/upgrade.php';

    dbDelta("CREATE TABLE " . gn_tbl('scans') . " (
        id INT AUTO_INCREMENT PRIMARY KEY,
        partner_id INT NOT NULL,
        medium VARCHAR(30) NOT NULL DEFAULT 'digital',
        target VARCHAR(30) NOT NULL DEFAULT 'dat-ban',
        ua_hash CHAR(32) NULL,
        scanned_on DATE NOT NULL,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        KEY partner_day (partner_id, scanned_on)
    ) $charset");

    dbDelta("CREATE TABLE " . gn_tbl('vouchers') . " (
        id INT AUTO_INCREMENT PRIMARY KEY,
        code VARCHAR(24) NOT NULL,
        partner_id INT NULL DEFAULT NULL,
        ref_code VARCHAR(50) NULL DEFAULT NULL,
        face_value DECIMAL(12,2) NOT NULL DEFAULT 0,
        price DECIMAL(12,2) NOT NULL DEFAULT 0,
        balance DECIMAL(12,2) NOT NULL DEFAULT 0,
        status VARCHAR(20) NOT NULL DEFAULT 'unpaid',
        buyer_name VARCHAR(255) NULL,
        buyer_phone VARCHAR(50) NULL,
        buyer_email VARCHAR(255) NULL,
        hold_until DATE NULL,
        expires_on DATE NULL,
        paid_on DATE NULL,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        UNIQUE KEY code (code),
        KEY partner_paid (partner_id, paid_on),
        KEY status_idx (status)
    ) $charset");

    dbDelta("CREATE TABLE " . gn_tbl('voucher_txn') . " (
        id INT AUTO_INCREMENT PRIMARY KEY,
        voucher_id INT NOT NULL,
        kind VARCHAR(20) NOT NULL,
        amount DECIMAL(12,2) NOT NULL DEFAULT 0,
        partner_id INT NULL DEFAULT NULL,
        note VARCHAR(255) NULL,
        happened_on DATE NOT NULL,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        KEY voucher (voucher_id),
        KEY partner_day (partner_id, happened_on)
    ) $charset");

    update_option('gn_commerce_version', GN_COMMERCE_VERSION);
}

add_action('init', function () {
    if (get_option('gn_commerce_version') !== GN_COMMERCE_VERSION) {
        gn_commerce_migrate();
        flush_rewrite_rules();
    }
}, 5);

/* ==========================================================================
   2. MÁY TÍNH HOA HỒNG
   ========================================================================== */

/**
 * Hoa hồng của MỘT ngày, luỹ tiến theo bậc.
 * Ví dụ 12.850.000đ = 5tr×10% + 5tr×12% + 2,85tr×15% = 1.527.500đ
 */
function gn_commission_for_day($revenue) {
    $revenue = max(0, (float) $revenue);
    $b1 = min($revenue, 5000000);
    $b2 = min(max($revenue - 5000000, 0), 5000000);
    $b3 = max($revenue - 10000000, 0);
    return round($b1 * 0.10 + $b2 * 0.12 + $b3 * 0.15);
}

function gn_commission_breakdown($revenue) {
    $revenue = max(0, (float) $revenue);
    $b1 = min($revenue, 5000000);
    $b2 = min(max($revenue - 5000000, 0), 5000000);
    $b3 = max($revenue - 10000000, 0);
    return [
        ['tu' => 0,        'den' => 5000000,  'ty_le' => 10, 'doanh_so' => $b1, 'hoa_hong' => round($b1 * 0.10)],
        ['tu' => 5000000,  'den' => 10000000, 'ty_le' => 12, 'doanh_so' => $b2, 'hoa_hong' => round($b2 * 0.12)],
        ['tu' => 10000000, 'den' => null,     'ty_le' => 15, 'doanh_so' => $b3, 'hoa_hong' => round($b3 * 0.15)],
    ];
}

define('GN_BONUS_THRESHOLD', 100000000);
define('GN_BONUS_RATE', 0.02);

/** Doanh số hợp lệ theo từng ngày của một đối tác trong tháng YYYY-MM. */
function gn_partner_daily_revenue($partner_id, $ym) {
    global $wpdb;
    $from = $ym . '-01';
    $to   = date('Y-m-t', strtotime($from));
    $days = [];

    // đặt bàn: chỉ tính khi khách ĐÃ ĐẾN và đã thanh toán
    $rows = $wpdb->get_results($wpdb->prepare(
        "SELECT served_on AS d, SUM(revenue) AS amt FROM " . gn_tbl('bookings') . "
         WHERE partner_id = %d AND served_on BETWEEN %s AND %s
           AND booking_status IN ('served','checked_in','completed')
         GROUP BY served_on", $partner_id, $from, $to));
    foreach ($rows as $r) $days[$r->d] = ($days[$r->d] ?? 0) + (float) $r->amt;

    // voucher: tính vào ngày khách TRẢ TIỀN, gồm cả tiền nạp thêm
    $rows = $wpdb->get_results($wpdb->prepare(
        "SELECT happened_on AS d, SUM(amount) AS amt FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id = %d AND happened_on BETWEEN %s AND %s
           AND kind IN ('pay','topup')
         GROUP BY happened_on", $partner_id, $from, $to));
    foreach ($rows as $r) $days[$r->d] = ($days[$r->d] ?? 0) + (float) $r->amt;

    // voucher hoàn tiền trong 7 ngày: trừ lại đúng ngày hoàn
    $rows = $wpdb->get_results($wpdb->prepare(
        "SELECT happened_on AS d, SUM(amount) AS amt FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id = %d AND happened_on BETWEEN %s AND %s AND kind = 'refund'
         GROUP BY happened_on", $partner_id, $from, $to));
    foreach ($rows as $r) $days[$r->d] = ($days[$r->d] ?? 0) - (float) $r->amt;

    ksort($days);
    return $days;
}

/** Tổng kết một kỳ: hoa hồng cộng từ từng ngày + thưởng 2% nếu tháng đạt mốc. */
function gn_partner_period($partner_id, $ym) {
    $days = gn_partner_daily_revenue($partner_id, $ym);
    $revenue = 0; $commission = 0; $detail = [];
    foreach ($days as $d => $amt) {
        $amt = max(0, $amt);
        $c = gn_commission_for_day($amt);
        $revenue += $amt; $commission += $c;
        $detail[] = ['ngay' => $d, 'doanh_so' => $amt, 'hoa_hong' => $c];
    }
    $bonus = $revenue >= GN_BONUS_THRESHOLD ? round($revenue * GN_BONUS_RATE) : 0;
    // Hoa hồng phẳng từ voucher lô (bán sỉ) — sổ riêng, cộng vào phải trả.
    $phang = function_exists('gn_batch_commission_period') ? gn_batch_commission_period($partner_id, $ym) : ['tong' => 0, 'lo' => 0, 'topup' => 0];
    $phai_tra = round($commission + $bonus + $phang['tong']);
    return [
        'ky'             => $ym,
        'doanh_so'       => round($revenue),
        'hoa_hong'       => round($commission),
        'thuong_2pt'     => $bonus,
        'hoa_hong_lo'    => round($phang['lo']),
        'hoa_hong_topup_lo' => round($phang['topup']),
        'hoa_hong_phang' => round($phang['tong']),
        'dat_moc_thuong' => $revenue >= GN_BONUS_THRESHOLD,
        'con_thieu'      => max(0, GN_BONUS_THRESHOLD - $revenue),
        'phai_tra'       => $phai_tra,
        'ty_le_thuc'     => $revenue > 0 ? round(($commission + $bonus) / $revenue * 100, 2) : 0,
        'so_ngay'        => count($detail),
        'theo_ngay'      => $detail,
    ];
}

/* ==========================================================================
   3. GÁN MÃ ĐỐI TÁC
   ========================================================================== */

function gn_partner_by_code($code) {
    global $wpdb;
    if (!$code) return null;
    return $wpdb->get_row($wpdb->prepare(
        "SELECT * FROM " . gn_tbl('partners') . " WHERE ref_code = %s AND status = 'active'",
        strtoupper(trim($code))));
}

/** Mã đối tác đang gán cho phiên này: ưu tiên tham số trên URL, sau đó cookie. */
function gn_current_ref() {
    if (!empty($_REQUEST['ref'])) return sanitize_text_field(wp_unslash($_REQUEST['ref']));
    if (!empty($_COOKIE[GN_REF_COOKIE])) return sanitize_text_field(wp_unslash($_COOKIE[GN_REF_COOKIE]));
    return '';
}

function gn_set_ref_cookie($code) {
    if (headers_sent()) return;
    setcookie(GN_REF_COOKIE, $code, [
        'expires'  => time() + GN_REF_DAYS * DAY_IN_SECONDS,
        'path'     => '/',
        'secure'   => is_ssl(),
        'httponly' => false,
        'samesite' => 'Lax',
    ]);
}

function gn_set_dish_cookie() {
    if (headers_sent()) return;
    setcookie('gn_mon', 'lau-ga-sau-rieng', [
        'expires'  => time() + GN_REF_DAYS * DAY_IN_SECONDS,
        'path'     => '/',
        'secure'   => is_ssl(),
        'httponly' => false,
        'samesite' => 'Lax',
    ]);
}

/** ?ref= on any URL, not only /p/CODE, so an agent link to the dish page still attributes. */
add_action('init', function () {
    if (is_admin()) return;
    if (!empty($_GET['ref'])) {
        $partner = gn_partner_by_code(sanitize_text_field(wp_unslash($_GET['ref'])));
        if ($partner) gn_set_ref_cookie($partner->ref_code);
    }
    $mon = isset($_GET['mon']) ? sanitize_text_field(wp_unslash($_GET['mon'])) : '';
    if ($mon === 'lau-ga' || $mon === 'lau-ga-sau-rieng') gn_set_dish_cookie();
}, 20);

/** /p/GN-P042 hoặc /p/GN-P042/voucher — ghi lượt quét rồi chuyển hướng. */
add_action('init', function () {
    add_rewrite_rule('^p/([A-Za-z0-9\-]+)/?([a-z\-]*)/?$', 'index.php?gn_ref_code=$matches[1]&gn_ref_target=$matches[2]', 'top');
}, 6);

add_filter('query_vars', function ($v) { $v[] = 'gn_ref_code'; $v[] = 'gn_ref_target'; return $v; });

add_action('template_redirect', function () {
    $code = get_query_var('gn_ref_code');
    if (!$code) return;
    $target = get_query_var('gn_ref_target') ?: 'dat-ban';
    $partner = gn_partner_by_code($code);

    if ($partner) {
        global $wpdb;
        gn_set_ref_cookie($partner->ref_code);
        if (in_array($target, ['lau-ga', 'mon'], true)) gn_set_dish_cookie();
        $wpdb->insert(gn_tbl('scans'), [
            'partner_id' => $partner->id,
            'medium'     => sanitize_text_field($_GET['m'] ?? 'digital'),
            'target'     => $target,
            'ua_hash'    => md5(($_SERVER['HTTP_USER_AGENT'] ?? '') . date('Y-m-d')),
            'scanned_on' => current_time('Y-m-d'),
        ]);
    }

    $map = [
        'dat-ban'  => '/dat-ban/',
        'voucher'  => '/voucher/',
        'thuc-don' => '/thuc-don/',
        'lau-ga'   => '/lau-ga-sau-rieng/',
        'mon'      => '/lau-ga-sau-rieng/',
        ''         => '/dat-ban/',
    ];
    wp_safe_redirect(home_url($map[$target] ?? '/dat-ban/'));
    exit;
});

/* ==========================================================================
   4. VOUCHER
   ========================================================================== */

function gn_voucher_code() {
    // bỏ O, 0, I, 1 để khách đọc qua điện thoại không nhầm
    $abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    $out = '';
    for ($i = 0; $i < 8; $i++) $out .= $abc[random_int(0, strlen($abc) - 1)];
    return 'GN-V-' . substr($out, 0, 4) . '-' . substr($out, 4, 4);
}

function gn_voucher_txn($voucher_id, $kind, $amount, $partner_id = null, $note = '') {
    global $wpdb;
    $wpdb->insert(gn_tbl('voucher_txn'), [
        'voucher_id'  => (int) $voucher_id,
        'kind'        => $kind,
        'amount'      => (float) $amount,
        'partner_id'  => $partner_id ? (int) $partner_id : null,
        'note'        => $note,
        'happened_on' => current_time('Y-m-d'),
    ]);
}

/** Phát hành voucher ở trạng thái CHƯA THANH TOÁN, giữ chỗ 7 ngày. */
function gn_voucher_issue($args) {
    global $wpdb;
    $partner = gn_partner_by_code(gn_current_ref());
    $code = gn_voucher_code();
    $face = (float) $args['face_value'];
    $price = (float) $args['price'];

    $wpdb->insert(gn_tbl('vouchers'), [
        'code'        => $code,
        'partner_id'  => $partner ? $partner->id : null,
        'ref_code'    => $partner ? $partner->ref_code : null,
        'face_value'  => $face,
        'price'       => $price,
        'balance'     => 0,                       // chưa trả tiền thì chưa có số dư
        'status'      => 'unpaid',
        'buyer_name'  => sanitize_text_field($args['buyer_name'] ?? ''),
        'buyer_phone' => sanitize_text_field($args['buyer_phone'] ?? ''),
        'buyer_email' => sanitize_email($args['buyer_email'] ?? ''),
        'hold_until'  => date('Y-m-d', strtotime('+7 days')),
        'expires_on'  => date('Y-m-d', strtotime('+12 months')),
    ]);
    $id = $wpdb->insert_id;
    gn_voucher_txn($id, 'issue', 0, $partner ? $partner->id : null, 'Giữ chỗ, chưa thanh toán');
    gn_voucher_send_email($id);
    do_action('gn_voucher_issued', $id);   // đẩy sang WCC
    return $id;
}

/** Khách trả tiền — tại quầy hoặc chuyển khoản. Đây mới là lúc tính doanh số. */
function gn_voucher_mark_paid($voucher_id, $amount = null) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if (!$v || $v->status !== 'unpaid') return false;
    $paid = $amount === null ? (float) $v->price : (float) $amount;

    $wpdb->update(gn_tbl('vouchers'), [
        'status'  => 'paid',
        'balance' => (float) $v->face_value,
        'paid_on' => current_time('Y-m-d'),
    ], ['id' => $voucher_id]);

    gn_voucher_txn($voucher_id, 'pay', $paid, $v->partner_id, 'Khách thanh toán');
    gn_voucher_send_email($voucher_id);
    do_action('gn_voucher_paid', $voucher_id, $paid);        // hoá đơn cho khách + báo hoa hồng đối tác
    return true;
}

/** Nạp thêm vào voucher đã trả tiền. Tiền nạp cũng tính doanh số cho đối tác. */
function gn_voucher_topup($voucher_id, $add_face, $paid_amount) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if (!$v || !in_array($v->status, ['paid'], true)) return false;
    $wpdb->update(gn_tbl('vouchers'), [
        'balance'    => (float) $v->balance + (float) $add_face,
        'face_value' => (float) $v->face_value + (float) $add_face,
        'expires_on' => date('Y-m-d', strtotime('+12 months')),
    ], ['id' => $voucher_id]);
    gn_voucher_txn($voucher_id, 'topup', $paid_amount, $v->partner_id, 'Nạp thêm');
    do_action('gn_voucher_topped_up', $voucher_id, $add_face, $paid_amount);
    return true;
}

/**
 * Nhân viên quét mã tại quầy, trừ vào hoá đơn.
 *
 * Hai chỗ bản trước sai, đều dẫn tới mất tiền:
 *   1. min($amount, $balance) không chặn dưới -> POST amount=-5000000 làm phép trừ
 *      thành phép cộng, voucher tự nạp thêm 5 triệu.
 *   2. Đọc rồi ghi giá trị tuyệt đối, không khoá -> hai máy quầy quét cùng lúc
 *      cùng đọc số dư cũ, cùng ghi 0, một voucher 2 triệu cấn được hai hoá đơn.
 * Giờ trừ bằng một câu UPDATE nguyên tử có điều kiện số dư trong WHERE.
 */
function gn_voucher_redeem($code, $amount) {
    global $wpdb;
    $amount = (float) $amount;
    if ($amount <= 0) return ['ok' => false, 'msg' => 'Số tiền trừ phải lớn hơn 0'];

    $t = gn_tbl('vouchers');
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$t} WHERE code = %s", $code));
    if (!$v) return ['ok' => false, 'msg' => 'Không tìm thấy voucher'];
    if ($v->status === 'unpaid') return ['ok' => false, 'msg' => 'Voucher CHƯA THANH TOÁN — thu ' . number_format($v->price) . 'đ trước khi dùng'];
    if ($v->status === 'used') return ['ok' => false, 'msg' => 'Voucher đã dùng hết'];
    if ($v->status === 'refunded') return ['ok' => false, 'msg' => 'Voucher đã hoàn tiền'];
    if ($v->expires_on && $v->expires_on < current_time('Y-m-d')) return ['ok' => false, 'msg' => 'Voucher hết hạn ' . $v->expires_on];

    $use = min($amount, (float) $v->balance);
    if ($use <= 0) return ['ok' => false, 'msg' => 'Voucher không còn số dư'];

    // Trừ nguyên tử: chỉ thành công khi số dư vẫn còn đủ tại đúng thời điểm ghi.
    $ok = $wpdb->query($wpdb->prepare(
        "UPDATE {$t}
            SET balance = balance - %f,
                status  = CASE WHEN balance - %f <= 0 THEN 'used' ELSE 'paid' END
          WHERE id = %d AND status = 'paid' AND balance >= %f",
        $use, $use, $v->id, $use));

    if ($ok !== 1) {
        return ['ok' => false, 'msg' => 'Số dư vừa thay đổi ở máy khác. Quét lại để lấy số mới.'];
    }

    $left = (float) $wpdb->get_var($wpdb->prepare("SELECT balance FROM {$t} WHERE id = %d", $v->id));
    gn_voucher_txn($v->id, 'redeem', $use, $v->partner_id, 'Trừ vào hoá đơn');
    do_action('gn_voucher_redeemed', $v->id, $use, $left);   // biên nhận cảm ơn cho khách
    return ['ok' => true, 'da_dung' => $use, 'con_lai' => $left];
}

function gn_qr_url($data, $size = 240) {
    return 'https://api.qrserver.com/v1/create-qr-code/?size=' . (int) $size . 'x' . (int) $size
         . '&margin=8&data=' . rawurlencode($data);
}

function gn_voucher_send_email($voucher_id) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if (!$v || empty($v->buyer_email)) return;

    $unpaid = ($v->status === 'unpaid');
    $qr = gn_qr_url(home_url('/voucher/?c=' . $v->code), 220);
    $money = fn($n) => number_format((float) $n, 0, ',', '.') . 'đ';

    // Thông tin theo dõi đầy đủ ngay trong email, để khách và nhân viên đối chiếu
    // không phải hỏi ai. Mã QR vẫn chỉ chứa link — số dư đổi theo thời gian.
    $partner = $v->partner_id
        ? $wpdb->get_row($wpdb->prepare("SELECT ref_code, contact, company FROM " . gn_tbl('partners') . " WHERE id = %d", $v->partner_id))
        : null;
    $topup = (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(amount),0) FROM " . gn_tbl('voucher_txn') . " WHERE voucher_id = %d AND kind = 'topup'", $voucher_id));
    $meta = [
        'Mã voucher'     => $v->code,
        'Người mua'      => $v->buyer_name ?: '—',
        'Ngày mua'       => date('d/m/Y H:i', strtotime($v->created_at)),
        'Mệnh giá'       => $money($v->face_value),
        'Giá đã trả'     => $money($v->price),
        'Số dư hiện tại' => $money($v->balance),
        'Hạn dùng'       => date('d/m/Y', strtotime($v->expires_on)),
    ];
    if ($topup > 0) $meta['Đã nạp thêm'] = $money($topup);
    if ($partner)   $meta['Đối tác giới thiệu'] = $partner->ref_code . ' · ' . ($partner->contact ?: $partner->company);
    if ($unpaid && $v->hold_until) $meta['Giữ chỗ đến'] = date('d/m/Y', strtotime($v->hold_until));

    $meta_rows = '';
    foreach ($meta as $mk => $mv) {
        $meta_rows .= '<tr><td style="padding:7px 0;border-bottom:1px solid #F0E7D8;font:400 13px/1.5 Arial,sans-serif;color:#6E5D4E;width:46%">'
                    . esc_html($mk) . '</td><td style="padding:7px 0;border-bottom:1px solid #F0E7D8;'
                    . 'font:600 13px/1.5 Arial,sans-serif;color:#1F1710">' . esc_html($mv) . '</td></tr>';
    }

    $vietqr_block = '';
    if ($unpaid && function_exists('gn_vietqr_url')) {
        $vietqr_block =
          '<div style="text-align:center;margin:22px 0 0;padding:20px;background:#FAF7F0;border-radius:10px">'
        . '<div style="font:600 10px/1.5 Arial,sans-serif;letter-spacing:.05em;color:#7A5A12;margin-bottom:10px">TRẢ TRƯỚC BẰNG VIETQR</div>'
        . '<img src="' . esc_url(gn_vietqr_url($v->price, 'GNV ' . $v->code)) . '" width="220" alt="VietQR"'
        . ' style="max-width:220px;background:#fff;border-radius:10px;padding:8px">'
        . '<div style="margin-top:10px;font:400 13px/1.8 Arial,sans-serif;color:#5A4B3E">'
        . '<b>' . esc_html(GN_BANK_NAME) . '</b> — ' . esc_html(GN_BANK_ACC) . '<br>'
        . esc_html(GN_BANK_OWNER) . '<br>Số tiền <b>' . $money($v->price) . '</b><br>'
        . 'Nội dung <b>GNV ' . esc_html($v->code) . '</b></div>'
        . '<div style="margin-top:8px;font:400 12px/1.6 Arial,sans-serif;color:#6E5D4E">'
        . 'Chuyển xong nhắn Zalo 0979 232 233 kèm mã voucher.</div></div>';
    }

    $subject = $unpaid
        ? 'Voucher Gánh Ngon đang giữ chỗ — trả ' . $money($v->price) . ' khi đến là dùng được'
        : 'Voucher Gánh Ngon của bạn đã sẵn sàng · ' . $v->code;

    $band = $unpaid
        ? '<tr><td style="background:#B45309;color:#fff;padding:12px 24px;font:700 13px/1.5 Arial,sans-serif;letter-spacing:.04em">CHƯA THANH TOÁN · TRẢ TẠI NHÀ HÀNG</td></tr>'
        : '<tr><td style="background:#1E7A4C;color:#fff;padding:12px 24px;font:700 13px/1.5 Arial,sans-serif;letter-spacing:.04em">ĐÃ THANH TOÁN ' . $money($v->price) . '</td></tr>';

    $intro = $unpaid
        ? 'Voucher đang được giữ chỗ đến hết ngày ' . date('d/m/Y', strtotime($v->hold_until)) . '. Chưa trả tiền thì chưa dùng được. Anh/chị có thể trả trước bằng VietQR, hoặc cứ đến nhà hàng rồi trả ' . $money($v->price) . ' tại quầy — nhân viên quét mã là voucher có hiệu lực ngay.'
        : 'Voucher dùng được ngay. Không cần in, chỉ cần đưa mã QR dưới đây cho nhân viên quét khi thanh toán.';

    $body = '<div style="background:#F0E9DC;padding:24px 12px">
      <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;width:100%;background:#fff;border-radius:12px;overflow:hidden">
        <tr><td style="background:#2C1810;padding:28px 24px;text-align:center">
          <div style="font:600 26px/1.2 Georgia,serif;letter-spacing:.05em;color:#D4AF37">GÁNH NGON</div>
          <div style="font:600 9px/1.4 Arial,sans-serif;letter-spacing:.08em;color:#C9B79E;margin-top:4px">ĐẶC SẢN VIỆT NAM · PHÚ QUỐC</div>
        </td></tr>
        ' . $band . '
        <tr><td style="padding:28px 24px;font:400 15px/1.7 Arial,sans-serif;color:#5A4B3E">
          <p style="margin:0 0 14px">Chào ' . esc_html($v->buyer_name ?: 'quý khách') . ',</p>
          <p style="margin:0 0 20px">' . esc_html($intro) . '</p>
          <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border:2px ' . ($unpaid ? 'dashed #B45309' : 'solid #D4AF37') . ';border-radius:12px;background:' . ($unpaid ? '#fff' : '#2C1810') . '">
            <tr>
              <td style="padding:20px">
                <div style="font:600 10px/1.5 Arial,sans-serif;letter-spacing:.05em;color:' . ($unpaid ? '#7A5A12' : '#C9B79E') . '">VOUCHER TIỀN MẶT</div>
                <div style="font:600 34px/1.15 Georgia,serif;color:' . ($unpaid ? '#1F1710' : '#fff') . ';margin:6px 0">' . $money($v->face_value) . '</div>
                ' . ($unpaid ? '<div style="font:700 15px/1.4 Arial,sans-serif;color:#B45309;margin-bottom:6px">Cần trả ' . $money($v->price) . '</div>' : '') . '
                <div style="font:600 12px/1.5 Arial,sans-serif;letter-spacing:.03em;color:' . ($unpaid ? '#7A5A12' : '#D4AF37') . '">' . esc_html($v->code) . '</div>
                <div style="font:400 12px/1.5 Arial,sans-serif;color:' . ($unpaid ? '#6E5D4E' : '#C9B79E') . ';margin-top:4px">Hạn dùng ' . date('d/m/Y', strtotime($v->expires_on)) . '</div>
              </td>
              <td style="padding:20px;text-align:right;width:130px">
                <img src="' . esc_url($qr) . '" width="110" height="110" alt="Mã QR voucher ' . esc_attr($v->code) . '" style="display:block;background:#fff;border-radius:8px;padding:6px">
              </td>
            </tr>
          </table>
          <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin-top:22px">
            <tr><td colspan="2" style="font:600 10px/1.5 Arial,sans-serif;letter-spacing:.05em;color:#7A5A12;padding-bottom:6px">THÔNG TIN VOUCHER</td></tr>
            ' . $meta_rows . '
          </table>
          ' . $vietqr_block . '
          <p style="margin:22px 0 0;font-size:14px">
            ' . ($unpaid
                ? 'Quá hạn giữ chỗ mà chưa trả thì voucher tự huỷ, không mất phí gì. Muốn giá trị lớn hơn thì nạp thêm trước khi trả — mức nạp càng cao càng lợi.'
                : 'Voucher dùng dần nhiều lần, còn dư thì giữ lại. Chưa dùng thì hoàn tiền 100% trong 7 ngày.') . '
          </p>
        </td></tr>
        <tr><td style="background:#1A0E07;padding:22px 24px;text-align:center;font:400 12px/1.7 Arial,sans-serif;color:#C9B79E">
          Gánh Ngon · 113 Trần Hưng Đạo, Dương Đông, Phú Quốc<br>
          0979 232 233 · Zalo · WhatsApp · contact@ganhngon.com
        </td></tr>
      </table></div>';

    @wp_mail($v->buyer_email, $subject, $body, ['Content-Type: text/html; charset=UTF-8']);
}

/* ==========================================================================
   5. ĐIỂM CUỐI AJAX
   ========================================================================== */

/**
 * Quyền cho mọi thao tác dính tiền.
 *
 * Bản trước neo vào 'edit_posts' — đó là quyền mặc định của vai Cộng tác viên,
 * thường cấp cho người viết blog hay agency SEO. Nghĩa là một cộng tác viên đọc
 * được toàn bộ doanh thu, xoá được đối tác, chốt được doanh số khống, đốt được
 * số dư voucher của khách. Giờ dùng quyền riêng gn_manage_commerce.
 */
define('GN_CAP', 'gn_manage_commerce');

function gn_require_staff() {
    if (!current_user_can(GN_CAP)) wp_send_json_error(['message' => 'Không có quyền'], 403);
}

/** Cấp quyền cho quản trị viên và tạo vai thu ngân dùng riêng ở quầy. */
function gn_setup_roles() {
    if (get_option('gn_roles_version') === '1') return;
    foreach (['administrator', 'editor'] as $r) {
        $role = get_role($r);
        if ($role && !$role->has_cap(GN_CAP)) $role->add_cap(GN_CAP);
    }
    if (!get_role('gn_thu_ngan')) {
        add_role('gn_thu_ngan', 'Thu ngân Gánh Ngon', [
            'read'  => true,
            GN_CAP  => true,
        ]);
    }
    update_option('gn_roles_version', '1');
}
add_action('init', 'gn_setup_roles', 4);

/** Kiểm chứng máy tính hoa hồng — công khai, chỉ đọc, không chạm dữ liệu. */
add_action('wp_ajax_nopriv_gn_commission_check', 'gn_ajax_commission_check');
add_action('wp_ajax_gn_commission_check', 'gn_ajax_commission_check');
function gn_ajax_commission_check() {
    $r = isset($_GET['revenue']) ? (float) $_GET['revenue'] : 12850000;
    wp_send_json_success([
        'doanh_so'  => $r,
        'cac_bac'   => gn_commission_breakdown($r),
        'hoa_hong'  => gn_commission_for_day($r),
        'ty_le_thuc'=> $r > 0 ? round(gn_commission_for_day($r) / $r * 100, 2) : 0,
        'phien_ban' => GN_COMMERCE_VERSION,
    ]);
}

/** Bảng điều khiển đối tác — mở bằng token trong link riêng, không cần mật khẩu. */
add_action('wp_ajax_nopriv_gn_partner_dash', 'gn_ajax_partner_dash');
add_action('wp_ajax_gn_partner_dash', 'gn_ajax_partner_dash');
function gn_ajax_partner_dash() {
    global $wpdb;
    $p = gn_partner_by_token($_GET['t'] ?? '');   // thoát ngay với 401 nếu token sai

    $ym = sanitize_text_field($_GET['ky'] ?? current_time('Y-m'));
    if (!preg_match('/^\d{4}-\d{2}$/', $ym)) $ym = current_time('Y-m');
    $today = current_time('Y-m-d');

    $scans = (int) $wpdb->get_var($wpdb->prepare(
        "SELECT COUNT(*) FROM " . gn_tbl('scans') . " WHERE partner_id = %d AND scanned_on = %s", $p->id, $today));
    $today_rev = (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . "
         WHERE partner_id = %d AND served_on = %s AND booking_status IN ('served','checked_in','completed')",
        $p->id, $today));
    $today_book = (int) $wpdb->get_var($wpdb->prepare(
        "SELECT COUNT(*) FROM " . gn_tbl('bookings') . " WHERE partner_id = %d AND served_on = %s", $p->id, $today));
    $today_vou = (int) $wpdb->get_var($wpdb->prepare(
        "SELECT COUNT(*) FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id = %d AND happened_on = %s AND kind IN ('pay','topup')", $p->id, $today));
    // doanh số voucher hôm nay cộng vào cùng bậc luỹ tiến với đặt bàn
    $today_rev += (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(amount),0) FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id = %d AND happened_on = %s AND kind IN ('pay','topup')", $p->id, $today));

    wp_send_json_success([
        'doi_tac'   => [
            'ma'         => $p->ref_code,
            'ten'        => $p->contact ?: $p->company,
            'loai'       => $p->type,
            'khu_vuc'    => $p->area,
            'trang_thai' => $p->status,
            'ngan_hang'  => $p->bank_info,
            'link_qr'    => home_url('/p/' . $p->ref_code),
            'anh_qr'     => gn_qr_url(home_url('/p/' . $p->ref_code), 320),
        ],
        'hom_nay'   => [
            'luot_quet' => $scans,
            'dat_ban'   => $today_book,
            'voucher'   => $today_vou,
            'doanh_so'  => round($today_rev),
            'hoa_hong'  => gn_commission_for_day($today_rev),
            'cac_bac'   => gn_commission_breakdown($today_rev),
        ],
        'ky_hien_tai'    => gn_partner_period($p->id, $ym),
        'bieu_do'        => gn_partner_chart($p->id, 30),
        'giao_dich'      => gn_partner_ledger($p->id, $ym),
        'ky_thanh_toan'  => gn_payout_status($p->id, $ym),
        'doi_soat'       => gn_partner_periods($p->id, 6),
        'moc_thuong'     => [
            'nguong'  => GN_BONUS_THRESHOLD,
            'ty_le'   => GN_BONUS_RATE * 100,
        ],
    ]);
}

/** Tra đối tác theo token cổng riêng. Token sai -> 401 và thoát, không lộ dữ liệu ai. */
function gn_partner_by_token($token) {
    global $wpdb;
    $token = sanitize_text_field($token);
    if (strlen($token) < 20) wp_send_json_error(['message' => 'Thiếu token'], 401);
    $p = $wpdb->get_row($wpdb->prepare(
        "SELECT * FROM " . gn_tbl('partners') . " WHERE portal_token = %s", $token));
    if (!$p) wp_send_json_error(['message' => 'Token không đúng'], 401);
    return $p;
}

/** Doanh số $days ngày gần nhất, đủ mọi ngày kể cả ngày không có đơn. */
function gn_partner_chart($partner_id, $days = 30) {
    $out = [];
    $seen = [];
    $ym_list = array_unique([date('Y-m', strtotime('-' . ($days - 1) . ' days', strtotime(current_time('Y-m-d')))), current_time('Y-m')]);
    foreach ($ym_list as $ym) {
        foreach (gn_partner_daily_revenue($partner_id, $ym) as $d => $amt) $seen[$d] = (float) $amt;
    }
    for ($i = $days - 1; $i >= 0; $i--) {
        $d = date('Y-m-d', strtotime("-$i days", strtotime(current_time('Y-m-d'))));
        $amt = max(0, $seen[$d] ?? 0);
        $out[] = ['ngay' => $d, 'doanh_so' => round($amt), 'hoa_hong' => gn_commission_for_day($amt)];
    }
    return $out;
}

/**
 * Sổ giao dịch của một kỳ: đặt bàn + voucher, kèm cột CỘNG DỒN TRONG NGÀY.
 * Cột cộng dồn cho đối tác thấy vì sao đơn sau lại được tỷ lệ cao hơn đơn trước.
 */
function gn_partner_ledger($partner_id, $ym) {
    global $wpdb;
    $from = $ym . '-01';
    $to   = date('Y-m-t', strtotime($from));
    $rows = [];

    $bk = $wpdb->get_results($wpdb->prepare(
        "SELECT booking_code AS ma, served_on AS ngay, revenue AS tien, customer_name AS ten, created_at
         FROM " . gn_tbl('bookings') . "
         WHERE partner_id = %d AND served_on BETWEEN %s AND %s
           AND booking_status IN ('served','checked_in','completed')",
        $partner_id, $from, $to));
    foreach ($bk as $r) {
        $rows[] = ['ngay' => $r->ngay, 'loai' => 'dat-ban', 'ma' => $r->ma,
                   'mo_ta' => 'Đặt bàn · ' . ($r->ten ?: 'khách lẻ'), 'tien' => (float) $r->tien];
    }

    $vt = $wpdb->get_results($wpdb->prepare(
        "SELECT t.kind, t.amount, t.happened_on, v.code
         FROM " . gn_tbl('voucher_txn') . " t
         LEFT JOIN " . gn_tbl('vouchers') . " v ON v.id = t.voucher_id
         WHERE t.partner_id = %d AND t.happened_on BETWEEN %s AND %s
           AND t.kind IN ('pay','topup','refund')",
        $partner_id, $from, $to));
    foreach ($vt as $r) {
        $sign = $r->kind === 'refund' ? -1 : 1;
        $label = ['pay' => 'Voucher · khách trả tiền', 'topup' => 'Voucher · nạp thêm', 'refund' => 'Voucher · hoàn tiền'];
        $rows[] = ['ngay' => $r->happened_on, 'loai' => 'voucher', 'ma' => $r->code,
                   'mo_ta' => $label[$r->kind], 'tien' => $sign * (float) $r->amount];
    }

    usort($rows, function ($a, $b) {
        return $a['ngay'] === $b['ngay'] ? 0 : ($a['ngay'] < $b['ngay'] ? -1 : 1);
    });

    // cộng dồn trong ngày + hoa hồng biên của chính giao dịch đó
    $run = []; $out = [];
    foreach ($rows as $r) {
        $truoc = $run[$r['ngay']] ?? 0;
        $sau   = max(0, $truoc + $r['tien']);
        $run[$r['ngay']] = $sau;
        $out[] = $r + [
            'cong_don_ngay' => round($sau),
            'hoa_hong'      => gn_commission_for_day($sau) - gn_commission_for_day($truoc),
        ];
    }
    return array_reverse($out);   // mới nhất lên đầu
}

/**
 * Lịch trả tiền của một kỳ. Chốt sổ ngày 1 tháng sau, đối soát 3 ngày,
 * chuyển khoản ngày 5. Trạng thái suy ra từ ngày, trừ khi chủ nhà hàng đã bấm
 * xác nhận đã chuyển — lúc đó lấy theo mốc đã lưu.
 */
function gn_payout_status($partner_id, $ym) {
    $paid_on = get_option('gn_payout_' . (int) $partner_id . '_' . $ym, '');
    $next    = date('Y-m-d', strtotime($ym . '-01 +1 month'));
    $chot    = $next;
    $het_ds  = date('Y-m-d', strtotime($next . ' +3 days'));
    $chuyen  = date('Y-m-d', strtotime($next . ' +4 days'));
    $today   = current_time('Y-m-d');

    if ($paid_on)               $tt = 'da_chuyen';
    elseif ($ym === current_time('Y-m')) $tt = 'dang_chay';
    elseif ($today < $het_ds)   $tt = 'dang_doi_soat';
    elseif ($today < $chuyen)   $tt = 'cho_chuyen';
    else                        $tt = 'qua_han';

    $nhan = [
        'dang_chay'     => 'Kỳ đang chạy',
        'dang_doi_soat' => 'Đang đối soát',
        'cho_chuyen'    => 'Chờ chuyển khoản',
        'da_chuyen'     => 'Đã chuyển khoản',
        'qua_han'       => 'Quá hạn chuyển — báo nhà hàng',
    ];
    return [
        'ky' => $ym, 'chot_so' => $chot, 'doi_soat_den' => $het_ds, 'chuyen_khoan' => $chuyen,
        'trang_thai' => $tt, 'nhan' => $nhan[$tt], 'da_chuyen_ngay' => $paid_on ?: null,
    ];
}

/** Danh sách $n kỳ gần nhất để đối chiếu. */
function gn_partner_periods($partner_id, $n = 6) {
    $out = [];
    for ($i = 0; $i < $n; $i++) {
        $ym = date('Y-m', strtotime(current_time('Y-m') . '-01 -' . $i . ' month'));
        $k = gn_partner_period($partner_id, $ym);
        unset($k['theo_ngay']);                       // bảng kỳ không cần chi tiết ngày
        $out[] = $k + ['thanh_toan' => gn_payout_status($partner_id, $ym)];
    }
    return $out;
}

/** Chi tiết một kỳ — bấm vào một dòng đối soát thì gọi cái này. */
add_action('wp_ajax_nopriv_gn_partner_period', 'gn_ajax_partner_period');
add_action('wp_ajax_gn_partner_period', 'gn_ajax_partner_period');
function gn_ajax_partner_period() {
    $p = gn_partner_by_token($_GET['t'] ?? '');
    $ym = sanitize_text_field($_GET['ky'] ?? current_time('Y-m'));
    if (!preg_match('/^\d{4}-\d{2}$/', $ym)) wp_send_json_error(['message' => 'Kỳ không hợp lệ']);
    wp_send_json_success([
        'ky_hien_tai'   => gn_partner_period($p->id, $ym),
        'giao_dich'     => gn_partner_ledger($p->id, $ym),
        'ky_thanh_toan' => gn_payout_status($p->id, $ym),
    ]);
}

/** Đối tác báo sai lệch số liệu — gửi mail cho nhà hàng, không sửa gì trong sổ. */
add_action('wp_ajax_nopriv_gn_partner_dispute', 'gn_ajax_partner_dispute');
add_action('wp_ajax_gn_partner_dispute', 'gn_ajax_partner_dispute');
function gn_ajax_partner_dispute() {
    $p = gn_partner_by_token($_POST['t'] ?? $_GET['t'] ?? '');
    $ym  = sanitize_text_field($_POST['ky'] ?? current_time('Y-m'));
    $msg = sanitize_textarea_field($_POST['noi_dung'] ?? '');
    if (mb_strlen($msg) < 10) wp_send_json_error(['message' => 'Mô tả sai lệch giúp rõ hơn — tối thiểu 10 ký tự']);
    $k = gn_partner_period($p->id, $ym);
    $to = get_option('admin_email');
    $body = "Đối tác {$p->ref_code} ({$p->contact}) báo sai lệch kỳ {$ym}.\n\n"
          . "Số hệ thống đang tính: doanh số " . number_format($k['doanh_so']) . "đ, "
          . "phải trả " . number_format($k['phai_tra']) . "đ.\n\n"
          . "Nội dung báo:\n{$msg}\n\n"
          . "Điện thoại: " . ($p->phone ?? '') . "\n";
    @wp_mail($to, "[Gánh Ngon] Đối tác {$p->ref_code} báo sai lệch kỳ {$ym}", $body);
    wp_send_json_success(['message' => 'Đã gửi. Nhà hàng liên hệ lại trong 24 giờ.']);
}

/** Bảng điều khiển chủ nhà hàng — gộp đơn trực tiếp và mọi đối tác. */
add_action('wp_ajax_gn_owner_dash', 'gn_ajax_owner_dash');
function gn_ajax_owner_dash() {
    gn_require_staff();
    global $wpdb;
    $ym = sanitize_text_field($_GET['ky'] ?? current_time('Y-m'));
    $from = $ym . '-01';
    $to   = date('Y-m-t', strtotime($from));
    $today = current_time('Y-m-d');

    $today_all = (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . " WHERE served_on = %s", $today));
    $today_partner = (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . " WHERE served_on = %s AND partner_id IS NOT NULL", $today));

    $partners = $wpdb->get_results("SELECT * FROM " . gn_tbl('partners') . " WHERE status = 'active'");
    $rows = []; $tong_ds = 0; $tong_tra = 0; $tong_thuong = 0; $so_dat_thuong = 0;
    foreach ($partners as $p) {
        $k = gn_partner_period($p->id, $ym);
        if ($k['doanh_so'] <= 0) continue;
        $tong_ds += $k['doanh_so']; $tong_tra += $k['phai_tra']; $tong_thuong += $k['thuong_2pt'];
        if ($k['dat_moc_thuong']) $so_dat_thuong++;
        $rows[] = [
            'ma' => $p->ref_code, 'ten' => $p->contact ?: $p->company, 'loai' => $p->type,
            'doanh_so' => $k['doanh_so'], 'hoa_hong' => $k['hoa_hong'],
            'thuong_2pt' => $k['thuong_2pt'], 'phai_tra' => $k['phai_tra'],
        ];
    }
    usort($rows, fn($a, $b) => $b['doanh_so'] <=> $a['doanh_so']);

    $vou = $wpdb->get_row($wpdb->prepare(
        "SELECT COALESCE(SUM(CASE WHEN kind='pay' THEN amount END),0) AS da_ban,
                COALESCE(SUM(CASE WHEN kind='topup' THEN amount END),0) AS nap_them,
                COALESCE(SUM(CASE WHEN kind='redeem' THEN amount END),0) AS da_dung
         FROM " . gn_tbl('voucher_txn') . " WHERE happened_on BETWEEN %s AND %s", $from, $to));
    $luu_hanh = (float) $wpdb->get_var("SELECT COALESCE(SUM(balance),0) FROM " . gn_tbl('vouchers') . " WHERE status = 'paid'");
    $giu_cho  = (float) $wpdb->get_var("SELECT COALESCE(SUM(price),0) FROM " . gn_tbl('vouchers') . " WHERE status = 'unpaid'");

    wp_send_json_success([
        'ky' => $ym,
        'hom_nay' => [
            'doanh_thu'   => round($today_all),
            'tu_doi_tac'  => round($today_partner),
            'khach_tu_dat'=> round($today_all - $today_partner),
        ],
        'doi_tac' => [
            'so_dang_hoat_dong' => count($rows),
            'doanh_so'   => $tong_ds,
            'phai_tra'   => $tong_tra,
            'thuong_2pt' => $tong_thuong,
            'so_dat_thuong' => $so_dat_thuong,
            'bang'       => $rows,
        ],
        'voucher' => [
            'da_ban'   => round((float) $vou->da_ban + (float) $vou->nap_them),
            'da_dung'  => round((float) $vou->da_dung),
            'luu_hanh' => round($luu_hanh),   // nợ phải trả, KHÔNG phải doanh thu
            'giu_cho_chua_tra' => round($giu_cho),
        ],
    ]);
}

/** Nhân viên quét mã voucher tại quầy. */
add_action('wp_ajax_gn_voucher_redeem', function () {
    gn_require_staff();
    check_ajax_referer('gn_counter', '_wpnonce');   // chặn CSRF: nhân viên mở link lạ là mất voucher khách
    $code = sanitize_text_field($_POST['code'] ?? '');
    $amount = (float) ($_POST['amount'] ?? 0);
    $r = gn_voucher_redeem($code, $amount);
    $r['ok'] ? wp_send_json_success($r) : wp_send_json_error(['message' => $r['msg']]);
});

/** Nhân viên thu tiền voucher giữ chỗ tại quầy. */
add_action('wp_ajax_gn_voucher_pay', function () {
    gn_require_staff();
    check_ajax_referer('gn_counter', '_wpnonce');
    global $wpdb;
    $code = sanitize_text_field($_POST['code'] ?? '');
    $v = $wpdb->get_row($wpdb->prepare("SELECT id FROM " . gn_tbl('vouchers') . " WHERE code = %s", $code));
    if (!$v) wp_send_json_error(['message' => 'Không tìm thấy voucher']);
    gn_voucher_mark_paid($v->id)
        ? wp_send_json_success(['message' => 'Đã ghi nhận thanh toán'])
        : wp_send_json_error(['message' => 'Voucher không ở trạng thái chờ thanh toán']);
});

/**
 * Bảng giá voucher — NGUỒN SỰ THẬT DUY NHẤT, đặt ở máy chủ.
 *
 * Bản trước nhận thẳng face_value và price từ POST nên ai cũng đúc được voucher
 * mệnh giá tuỳ ý với giá tuỳ ý:
 *   curl -d 'face_value=50000000&price=1000&buyer_email=...' .../admin-ajax.php?action=gn_voucher_buy
 * Nhân viên bấm "đã thu tiền" là nạp đủ 50 triệu vào số dư, vì màn quầy chỉ hiện
 * price. Giờ khách chỉ được chọn mệnh giá có trong bảng, giá do máy chủ quyết.
 */
function gn_voucher_tiers() {
    return apply_filters('gn_voucher_tiers', [
        500000  => 450000,
        1000000 => 880000,
        2000000 => 1700000,
        5000000 => 4200000,
    ]);
}

/** Khách mua voucher — phát hành ở trạng thái giữ chỗ, gửi email ngay. */
add_action('wp_ajax_nopriv_gn_voucher_buy', 'gn_ajax_voucher_buy');
add_action('wp_ajax_gn_voucher_buy', 'gn_ajax_voucher_buy');
function gn_ajax_voucher_buy() {
    $tiers = gn_voucher_tiers();
    $face  = (int) ($_POST['face_value'] ?? 0);
    $email = sanitize_email($_POST['buyer_email'] ?? '');
    if (!isset($tiers[$face])) wp_send_json_error(['message' => 'Mệnh giá không hợp lệ']);
    $price = (float) $tiers[$face];                 // KHÔNG lấy giá từ POST
    if (!is_email($email)) wp_send_json_error(['message' => 'Email không hợp lệ — voucher gửi về email này']);

    // chặn đúc hàng loạt: mỗi IP tối đa 5 voucher giữ chỗ trong 10 phút
    $key = 'gn_vbuy_' . md5(($_SERVER['REMOTE_ADDR'] ?? '') . date('YmdHi', floor(time() / 600) * 600));
    $hits = (int) get_transient($key);
    if ($hits >= 5) wp_send_json_error(['message' => 'Bạn vừa tạo nhiều voucher. Chờ ít phút hoặc gọi 0979 232 233.']);
    set_transient($key, $hits + 1, 10 * MINUTE_IN_SECONDS);

    $id = gn_voucher_issue([
        'face_value'  => $face,
        'price'       => $price,
        'buyer_name'  => $_POST['buyer_name'] ?? '',
        'buyer_phone' => $_POST['buyer_phone'] ?? '',
        'buyer_email' => $email,
    ]);
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT code, hold_until FROM " . gn_tbl('vouchers') . " WHERE id = %d", $id));
    wp_send_json_success([
        'ma'         => $v->code,
        'trang_thai' => 'unpaid',
        'giu_den'    => $v->hold_until,
        'message'    => 'Đã gửi voucher về email. Trả ' . number_format($price) . 'đ khi đến nhà hàng là dùng được.',
    ]);
}

/* ==========================================================================
   GN COMMERCE — THAY CALLBACK CỦA PLUGIN, KHÔNG SỬA FILE PLUGIN
   --------------------------------------------------------------------------
   Plugin sao-booking-engine đăng ký hai endpoint bằng phương thức của một
   đối tượng tạo trong hàm init(), không giữ tham chiếu ra ngoài. Ở đây quét
   $wp_filter để gỡ đúng hai callback đó rồi đăng ký bản của mình.

   Vì sao phải thay, chứ không bọc thêm:
     - partner_login() bản gốc chỉ chạy wp_send_json_error('Use WordPress login')
       nên MỌI hồ sơ đối tác gửi lên đều bị vứt đi, không lưu, không báo ai.
     - create_booking() bản gốc không đọc ref_code, và bảng sao_bookings không
       có cột nào gán đối tác -> không có dữ liệu nguồn để tính hoa hồng.
     - Cả hai đều kết thúc bằng wp_send_json rồi thoát, nên không thể chạy
       thêm code sau chúng. Buộc phải thay hẳn.

   Bản thay giữ nguyên mọi việc phụ của bản gốc: gửi mail cho sale và cskh,
   gửi Telegram nếu có, gửi xác nhận cho khách, tạo lead trong Zero BS CRM.

   HOÀN TÁC: xoá khối giữa BEGIN và END trong functions.php. Plugin trở lại
   nguyên trạng vì file plugin chưa hề bị sửa.
   ========================================================================== */

/** Gỡ callback của plugin theo tên phương thức, trả lại đối tượng gốc nếu cần. */
function gn_unhook_plugin_ajax($action, $method) {
    global $wp_filter;
    $obj = null;
    foreach (["wp_ajax_{$action}", "wp_ajax_nopriv_{$action}"] as $hook) {
        if (empty($wp_filter[$hook])) continue;
        foreach ($wp_filter[$hook]->callbacks as $prio => $cbs) {
            foreach ($cbs as $id => $cb) {
                $fn = $cb['function'];
                if (is_array($fn) && is_object($fn[0]) && isset($fn[1]) && $fn[1] === $method) {
                    $obj = $fn[0];
                    unset($wp_filter[$hook]->callbacks[$prio][$id]);
                }
            }
        }
    }
    return $obj;
}

add_action('init', function () {
    gn_unhook_plugin_ajax('sao_partner_login', 'partner_login');
    add_action('wp_ajax_sao_partner_login',        'gn_ajax_partner_register');
    add_action('wp_ajax_nopriv_sao_partner_login', 'gn_ajax_partner_register');

    gn_unhook_plugin_ajax('sao_create_booking', 'create_booking');
    add_action('wp_ajax_sao_create_booking',        'gn_ajax_create_booking');
    add_action('wp_ajax_nopriv_sao_create_booking', 'gn_ajax_create_booking');
}, 30);

/* --------------------------------------------------------------------------
   Đăng ký đối tác — bản gốc vứt hồ sơ đi
   -------------------------------------------------------------------------- */
function gn_ajax_partner_register() {
    global $wpdb;
    $t = gn_tbl('partners');

    $name  = sanitize_text_field($_POST['full_name'] ?? '');
    $phone = sanitize_text_field($_POST['phone'] ?? '');
    $email = sanitize_email($_POST['email'] ?? '');
    if ($name === '' || $phone === '') wp_send_json_error(['message' => 'Thiếu họ tên hoặc số điện thoại']);
    if ($email !== '' && !is_email($email)) wp_send_json_error(['message' => 'Email không hợp lệ']);

    $type   = sanitize_text_field($_POST['partner_type'] ?? 'khac');
    $area   = sanitize_text_field($_POST['area'] ?? '');
    $volume = sanitize_text_field($_POST['estimated_volume'] ?? '');
    $social = esc_url_raw($_POST['social_link'] ?? '');
    $intro  = sanitize_textarea_field($_POST['introduction'] ?? '');

    $existing = $wpdb->get_row($wpdb->prepare("SELECT * FROM {$t} WHERE phone = %s", $phone));
    if ($existing) {
        wp_send_json_success([
            'message'  => 'Số điện thoại này đã đăng ký. Mã đối tác của bạn là ' . $existing->ref_code . '.',
            'ref_code' => $existing->ref_code,
            'da_co'    => true,
        ]);
    }

    $token = wp_generate_password(32, false, false);
    $role  = gn_normalize_partner_role($type);
    $ref   = '';
    $inserted = false;
    for ($try = 0; $try < 5 && !$inserted; $try++) {
        $max = (int) $wpdb->get_var("SELECT COALESCE(MAX(CAST(SUBSTRING(ref_code, 5) AS UNSIGNED)), 0)
                                     FROM {$t} WHERE ref_code REGEXP '^GN-P[0-9]+$'");
        $ref = gn_format_ref_code($max + 1);
        $row = [
            'company' => $name, 'contact' => $name, 'email' => $email, 'phone' => $phone,
            'type' => $type, 'ref_code' => $ref, 'status' => 'pending', 'portal_token' => $token,
            'area' => $area, 'social_link' => $social,
            'intro' => trim($intro . ($volume ? ' | Khách dự kiến: ' . $volume : '')),
        ];
        if (gn_column_exists($t, 'role')) $row['role'] = $role;
        $inserted = (bool) $wpdb->insert($t, $row);
        if (!$inserted && stripos((string) $wpdb->last_error, 'Duplicate') === false) break;
    }
    if (!$inserted || !$wpdb->insert_id) wp_send_json_error(['message' => 'Không lưu được hồ sơ, gọi 0979 232 233 giúp']);
    do_action('gn_partner_registered', $ref, $name, $phone, $type);   // đẩy sang WCC

    $portal = home_url('/cong-doi-tac/?t=' . $token);
    @wp_mail(['sale@ganhngon.com', 'partner@ganhngon.com'],
        "Hồ sơ đối tác mới: $name ($ref)",
        "ĐỐI TÁC ĐĂNG KÝ MỚI\n\nMã: $ref\nTên: $name\nVai trò: $role\nLoại: $type\nSĐT/Zalo: $phone\nEmail: $email\n"
      . "Khu vực: $area\nKhách dự kiến: $volume\nLink: $social\n\nGiới thiệu: $intro\n\n"
      . "→ Vào wp-admin duyệt, đổi status sang active rồi gửi bộ vật phẩm in.",
        ['Content-Type: text/plain; charset=UTF-8']);

    if ($email !== '') {
        @wp_mail($email, "Gánh Ngon đã nhận hồ sơ đối tác của bạn — mã $ref",
            "Chào $name,\n\nGánh Ngon đã nhận hồ sơ. Mã đối tác dự kiến: $ref\n\n"
          . "Đội ngũ duyệt trong 24 giờ. Duyệt xong bạn nhận mã QR số dùng được ngay, "
          . "bộ vật phẩm in gửi tới trong 3–5 ngày.\n\n"
          . "Cổng theo dõi doanh số riêng của bạn: $portal\n"
          . "Sau khi duyệt, link bàn thường: " . home_url('/p/' . $ref) . "\n"
          . "Link món lẩu gà sầu riêng: " . home_url('/p/' . $ref . '/lau-ga') . "\n"
          . "Giữ link này riêng — ai có link là xem được số liệu của bạn.\n\n"
          . "Hoa hồng luỹ tiến theo doanh số từng ngày: 5 triệu đầu 10%, phần 5–10 triệu 12%, "
          . "phần vượt 10 triệu 15%. Tháng đạt 100 triệu được cộng thêm 2% tổng doanh số tháng.\n\n"
          . "Hotline/Zalo: 0979 232 233\n— Gánh Ngon Phú Quốc",
            ['Content-Type: text/plain; charset=UTF-8']);
    }
    if (function_exists('gn_send_telegram')) {
        gn_send_telegram("🤝 <b>ĐỐI TÁC MỚI</b> $ref\n👤 $name ($role / $type)\n📞 $phone\n📍 $area");
    }
    wp_send_json_success([
        'message'  => 'Đã nhận hồ sơ. Mã đối tác dự kiến: ' . $ref . '. Đội ngũ duyệt trong 24 giờ.',
        'ref_code' => $ref,
    ]);
}

/* --------------------------------------------------------------------------
   Tạo đơn đặt bàn — thêm gán đối tác và doanh số, giữ nguyên phần báo tin
   -------------------------------------------------------------------------- */
function gn_ajax_create_booking() {
    global $wpdb;
    $t = gn_tbl('bookings');

    $g = function ($keys, $default = '') {
        foreach ((array) $keys as $k) if (isset($_POST[$k]) && $_POST[$k] !== '') return $_POST[$k];
        return $default;
    };
    $code   = 'GN' . date('Ymd') . strtoupper(substr(md5(uniqid('', true)), 0, 4));
    $name   = sanitize_text_field($g(['customer_name', 'name']));
    $email  = sanitize_email($g(['customer_email', 'email']));
    $phone  = sanitize_text_field($g(['customer_phone', 'phone']));
    $date   = sanitize_text_field($g(['booking_date', 'date'], current_time('Y-m-d')));
    $time   = sanitize_text_field($g(['booking_time', 'time'], ''));
    $guests = (int) $g(['guests'], 1);
    $type   = sanitize_text_field($g(['space_type', 'type'], 'individual'));
    $need   = sanitize_text_field($g(['need'], ''));
    $note   = sanitize_textarea_field($g(['note', 'notes'], ''));
    $tags   = (isset($_POST['note_tags']) && is_array($_POST['note_tags']))
              ? implode(', ', array_map('sanitize_text_field', $_POST['note_tags'])) : '';

    if ($name === '' || $phone === '') wp_send_json_error(['message' => 'Thiếu tên hoặc số điện thoại']);

    // Chặn ngày ở SERVER, không tin ràng buộc min/max của trình duyệt. Ngày lấy
    // theo giờ Việt Nam. Đơn quá khứ hoặc quá xa lọt xuống database sẽ biến mất
    // khỏi màn quản trị (chỉ truy vấn hôm nay) dù khách vẫn nhận email xác nhận.
    if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) wp_send_json_error(['message' => 'Ngày không hợp lệ']);
    $hom_nay = (new DateTime('now', new DateTimeZone('Asia/Ho_Chi_Minh')))->format('Y-m-d');
    $toi_da  = (new DateTime('now', new DateTimeZone('Asia/Ho_Chi_Minh')))->modify('+1 year')->format('Y-m-d');
    if ($date < $hom_nay) wp_send_json_error(['message' => 'Không đặt bàn cho ngày đã qua']);
    if ($date > $toi_da)  wp_send_json_error(['message' => 'Chỉ đặt bàn trong vòng 12 tháng tới']);

    $notes_full = trim(($need ? "Nhu cầu: $need. " : '') . ($tags ? "Lưu ý: $tags. " : '') . $note);
    if ($time !== '') $notes_full = trim("Giờ: $time. " . $notes_full);
    $src = isset($_COOKIE['gn_src']) ? sanitize_text_field(wp_unslash($_COOKIE['gn_src'])) : '';
    if ($src !== '') $notes_full = trim($notes_full . ' [Nguồn: ' . $src . ']');
    $posted_src = sanitize_text_field($g(['source'], ''));
    if ($posted_src !== '') $notes_full = trim($notes_full . ' [Nguồn: ' . $posted_src . ']');

    $signature = !empty($_POST['signature_dish']) && (string) $_POST['signature_dish'] !== '0';
    if (!$signature && !empty($_COOKIE['gn_mon']) && $_COOKIE['gn_mon'] === 'lau-ga-sau-rieng') $signature = true;
    $cls = gn_classify_booking([
        'date'   => $date,
        'today'  => $hom_nay,
        'guests' => $guests,
        'space'  => $type,
    ]);
    if ($cls['staff_note'] !== '') $notes_full = trim($notes_full . ' [' . $cls['staff_note'] . ']');
    if ($signature) $notes_full = trim($notes_full . ' [Món: lẩu gà sầu riêng]');

    // [GN] Gán đơn về đối tác: ưu tiên ô nhập trên form, sau đó cookie gn_ref
    $ref = sanitize_text_field($g(['ref_code'], ''));
    if ($ref === '') $ref = gn_current_ref();
    $partner_id = null;
    if ($ref !== '') {
        $pt = gn_partner_by_code($ref);
        if ($pt) { $partner_id = (int) $pt->id; $ref = $pt->ref_code; } else { $ref = ''; }
    }

    $row = [
        'booking_code' => $code, 'customer_name' => $name, 'customer_email' => $email,
        'customer_phone' => $phone, 'booking_date' => $date, 'guests' => $guests,
        'guest_type' => $type, 'notes' => $notes_full,
        'booking_status' => 'pending', 'payment_status' => 'pending',
        'partner_id' => $partner_id, 'ref_code' => ($ref !== '' ? $ref : null),
        'revenue' => 0,   // doanh số thật do nhân viên chốt khi khách ăn xong
    ];
    if (gn_column_exists($t, 'same_day')) {
        $row['same_day'] = (int) $cls['same_day'];
        $row['signature_dish'] = $signature ? 1 : 0;
        $row['lead_class'] = $cls['lead_class'];
    }
    $wpdb->insert($t, $row);
    if (!$wpdb->insert_id) wp_send_json_error(['message' => 'Không lưu được đơn, gọi 0979 232 233 giúp']);
    do_action('gn_booking_created', $wpdb->insert_id, $code, $ref);   // đẩy sang WCC

    $partner_line = $ref !== '' ? "Đối tác giới thiệu: $ref\n" : '';
    @wp_mail(['sale@ganhngon.com', 'cskh@ganhngon.com'],
        "🍤 Đặt bàn mới #$code — $name ($guests khách)",
        "ĐẶT BÀN MỚI — Gánh Ngon Phú Quốc\n\nMã booking: $code\nKhách: $name\nSĐT/Zalo: $phone\n"
      . "Email: $email\nNgày: $date" . ($time ? " lúc $time" : '') . "\nSố khách: $guests\n"
      . "Không gian: $type\n$partner_line" . "Ghi chú: $notes_full\n\n"
      . "→ Vào wp-admin → Đặt bàn để xử lý. Liên hệ khách trong 2 phút.\n"
      . "→ Khách ăn xong nhớ chốt doanh số để tính hoa hồng cho đối tác.",
        ['Content-Type: text/plain; charset=UTF-8']);

    if (function_exists('gn_send_telegram')) {
        gn_send_telegram("🍤 <b>ĐẶT BÀN MỚI</b> #$code\n👤 $name\n📞 $phone\n"
            . "📅 $date " . ($time ?: '') . " · $guests khách\n🏠 $type · " . $cls['lead_class'] . "\n"
            . ($signature ? "🍲 Lẩu gà sầu riêng\n" : '')
            . ($ref !== '' ? "🤝 Đối tác $ref\n" : '')
            . ($notes_full ? "📝 $notes_full\n" : ''));
    }
    if ($email !== '') {
        @wp_mail($email, "Gánh Ngon đã nhận yêu cầu đặt bàn #$code",
            "Chào $name,\n\nGánh Ngon đã nhận yêu cầu đặt bàn (mã $code, ngày $date"
          . ($time ? " lúc $time" : '') . ", $guests khách). Nhân viên sẽ liên hệ xác nhận trong ít phút.\n\n"
          . "Hotline/Zalo: 0979 232 233\n— Gánh Ngon Phú Quốc",
            ['Content-Type: text/plain; charset=UTF-8']);
    }

    // lead sang Zero BS CRM, y như bản gốc, không bao giờ làm hỏng đơn
    if ($email || $phone) {
        global $zbs;
        if (isset($zbs) && is_object($zbs) && isset($zbs->DAL) && is_object($zbs->DAL)
            && method_exists($zbs->DAL->contacts, 'addUpdateContact')) {
            $parts = explode(' ', trim($name), 2);
            try {
                $zbs->DAL->contacts->addUpdateContact(['data' => [
                    'fname'   => $parts[0] !== '' ? $parts[0] : 'Khách',
                    'lname'   => $parts[1] ?? '',
                    'email'   => $email,
                    'maintel' => $phone,
                    'status'  => 'Lead',
                    'notes'   => "Đặt bàn $code. " . ($ref ? "Đối tác $ref. " : '') . $notes_full,
                ]]);
            } catch (\Throwable $e) { /* không bao giờ chặn đơn */ }
        }
    }

    $message = 'Đã nhận yêu cầu đặt bàn. Nhân viên xác nhận trong 2 phút.';
    if ($cls['lead_class'] === 'same_day') {
        $message = 'Đã nhận bàn thường hôm nay. Nhân viên gọi trong vài phút. Chưa xác nhận còn bàn trước cuộc gọi đó.';
    } elseif ($cls['lead_class'] === 'vip_lead') {
        $message = 'Đã nhận yêu cầu phòng VIP. Phòng riêng thường cần khoảng 24 giờ. Nếu cần ngồi hôm nay, nhà hàng giữ bàn thường và gọi lại.';
    } elseif ($cls['lead_class'] === 'group_lead') {
        $message = 'Đã nhận yêu cầu đoàn. Đoàn từ 20 khách nên báo trước 48–72 giờ. Nhà hàng gọi để chốt.';
    }
    if ($signature) $message .= ' Lẩu gà sầu riêng: báo bếp khoảng 1 tiếng trước giờ ngồi.';
    wp_send_json_success([
        'booking_id' => $wpdb->insert_id,
        'code'       => $code,
        'doi_tac'    => $ref ?: null,
        'same_day'   => (int) $cls['same_day'],
        'lead_class' => $cls['lead_class'],
        'signature'  => $signature ? 1 : 0,
        'message'    => $message,
    ]);
}

/* --------------------------------------------------------------------------
   Nhân viên chốt doanh số sau khi khách ăn xong — đây là lúc hoa hồng thành thật
   -------------------------------------------------------------------------- */
add_action('wp_ajax_gn_booking_settle', function () {
    gn_require_staff();
    check_ajax_referer('gn_counter', '_wpnonce');   // chặn CSRF: bịa doanh số cho đối tác bất kỳ
    global $wpdb;
    $code = sanitize_text_field($_POST['code'] ?? '');
    $rev  = (float) ($_POST['revenue'] ?? 0);
    if ($code === '' || $rev < 0) wp_send_json_error(['message' => 'Thiếu mã đơn hoặc doanh số']);
    $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . " WHERE booking_code = %s", $code));
    if (!$b) wp_send_json_error(['message' => 'Không tìm thấy đơn']);
    $wpdb->update(gn_tbl('bookings'), [
        'revenue'        => $rev,
        'served_on'      => current_time('Y-m-d'),
        'booking_status' => 'served',
        'payment_status' => 'paid',
    ], ['id' => $b->id]);
    do_action('gn_booking_settled', $b->id, $rev);   // hoá đơn cảm ơn + báo hoa hồng đối tác
    $day = 0;
    if ($b->partner_id) {
        $day = (float) $wpdb->get_var($wpdb->prepare(
            "SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . "
             WHERE partner_id = %d AND served_on = %s AND booking_status IN ('served','checked_in','completed')",
            $b->partner_id, current_time('Y-m-d')));
    }
    wp_send_json_success([
        'ma'              => $code,
        'doanh_so_don'    => $rev,
        'doi_tac'         => $b->ref_code,
        'doanh_so_ngay'   => $day,
        'hoa_hong_ngay'   => $b->partner_id ? gn_commission_for_day($day) : 0,
    ]);
});

/* GN COMMERCE — END */

/* ==========================================================================
   GN — MÀN QUẢN TRỊ + CỔNG ĐỐI TÁC + TRANG MUA VOUCHER
   --------------------------------------------------------------------------
   Bổ sung phần giao diện cho backend đã có. Ba mảnh:
     1. wp-admin → "Gánh Ngon": tổng quan doanh thu, quản lý đối tác, công cụ quầy
     2. /cong-doi-tac/?t=TOKEN — đối tác tự xem doanh số, không cần mật khẩu
     3. /voucher/ — khách mua voucher, ưu tiên màn hình điện thoại
   HOÀN TÁC: xoá khối giữa BEGIN và END trong functions.php.
   ========================================================================== */

function gn_money($n) { return number_format((float) $n, 0, ',', '.') . 'đ'; }

/* --------------------------------------------------------------------------
   1. wp-admin
   -------------------------------------------------------------------------- */
add_action('admin_menu', function () {
    add_menu_page('Gánh Ngon', 'Gánh Ngon', GN_CAP, 'gn-home', 'gn_admin_overview', 'dashicons-chart-area', 3);
    add_submenu_page('gn-home', 'Tổng quan doanh thu', 'Tổng quan', GN_CAP, 'gn-home', 'gn_admin_overview');
    add_submenu_page('gn-home', 'Đối tác & hoa hồng', 'Đối tác', GN_CAP, 'gn-partners', 'gn_admin_partners');
    add_submenu_page('gn-home', 'Công cụ tại quầy', 'Tại quầy', GN_CAP, 'gn-counter', 'gn_admin_counter');
});

function gn_admin_css() { ?>
<style>
.gnw{max-width:1200px}
.gnw h1{font-size:23px;margin:0 0 4px}
.gnw .sub{color:#646970;margin:0 0 18px}
.gnw .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-bottom:18px}
.gnw .kpi{background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:14px 16px}
.gnw .kpi.gold{background:#FBF6E7;border-color:#D4AF37}
.gnw .kpi b{display:block;font-size:24px;line-height:1.2;margin:4px 0 2px;color:#1F1710}
.gnw .kpi span{font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#7A5A12;font-weight:600}
.gnw .kpi small{color:#646970}
.gnw table.wp-list-table td,.gnw table.wp-list-table th{vertical-align:middle}
.gnw .tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600}
.gnw .ok{background:#E4F2EA;color:#1E7A4C}.gnw .wait{background:#FCEEDC;color:#B45309}
.gnw .off{background:#F0F0F1;color:#646970}.gnw .err{background:#FBE9E7;color:#B42318}
.gnw .card{background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:18px 20px;margin-bottom:16px}
.gnw .card h2{margin-top:0;font-size:15px}
.gnw .grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.gnw .note{background:#FBF6E7;border-left:4px solid #D4AF37;padding:10px 14px;margin:14px 0;font-size:13px}
.gnw form.inline{display:flex;gap:8px;flex-wrap:wrap;align-items:end}
.gnw label{display:block;font-size:12px;font-weight:600;margin-bottom:3px}
</style><?php }

/** Tổng quan — gộp đơn khách tự đặt và mọi đối tác. */
function gn_admin_overview() {
    if (!current_user_can(GN_CAP)) wp_die('Không có quyền');
    global $wpdb;
    gn_admin_css();
    $ym = isset($_GET['ky']) ? sanitize_text_field($_GET['ky']) : current_time('Y-m');
    $from = $ym . '-01'; $to = date('Y-m-t', strtotime($from)); $today = current_time('Y-m-d');

    $hn_all = (float) $wpdb->get_var($wpdb->prepare("SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . " WHERE served_on=%s", $today));
    $hn_dt  = (float) $wpdb->get_var($wpdb->prepare("SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . " WHERE served_on=%s AND partner_id IS NOT NULL", $today));
    $hn_don = (int) $wpdb->get_var($wpdb->prepare("SELECT COUNT(*) FROM " . gn_tbl('bookings') . " WHERE booking_date=%s", $today));
    $cho    = (int) $wpdb->get_var($wpdb->prepare("SELECT COUNT(*) FROM " . gn_tbl('bookings') . " WHERE booking_date=%s AND booking_status='pending'", $today));

    $act_ids = $wpdb->get_col($wpdb->prepare(
        "SELECT DISTINCT partner_id FROM " . gn_tbl('bookings') . "
         WHERE partner_id IS NOT NULL AND served_on BETWEEN %s AND %s
           AND booking_status IN ('served','checked_in','completed')", $from, $to));
    $vou_ids = $wpdb->get_col($wpdb->prepare(
        "SELECT DISTINCT partner_id FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id IS NOT NULL AND happened_on BETWEEN %s AND %s
           AND kind IN ('pay','topup','refund')", $from, $to));
    $act_ids = array_values(array_unique(array_filter(array_map('intval', array_merge((array) $act_ids, (array) $vou_ids)))));
    $ps = $act_ids
        ? $wpdb->get_results("SELECT * FROM " . gn_tbl('partners') . " WHERE status='active' AND id IN (" . implode(',', $act_ids) . ")")
        : [];
    $rows = []; $ds = 0; $tra = 0; $thuong = 0; $dat = 0;
    foreach ($ps as $p) {
        $k = gn_partner_period($p->id, $ym);
        if ($k['doanh_so'] <= 0) continue;
        $ds += $k['doanh_so']; $tra += $k['phai_tra']; $thuong += $k['thuong_2pt'];
        if ($k['dat_moc_thuong']) $dat++;
        $rows[] = ['p' => $p, 'k' => $k];
    }
    usort($rows, fn($a, $b) => $b['k']['doanh_so'] <=> $a['k']['doanh_so']);

    $v = $wpdb->get_row($wpdb->prepare(
        "SELECT COALESCE(SUM(CASE WHEN kind IN ('pay','topup') THEN amount END),0) ban,
                COALESCE(SUM(CASE WHEN kind='redeem' THEN amount END),0) dung
         FROM " . gn_tbl('voucher_txn') . " WHERE happened_on BETWEEN %s AND %s", $from, $to));
    $luu  = (float) $wpdb->get_var("SELECT COALESCE(SUM(balance),0) FROM " . gn_tbl('vouchers') . " WHERE status='paid'");
    $giu  = (float) $wpdb->get_var("SELECT COALESCE(SUM(price),0) FROM " . gn_tbl('vouchers') . " WHERE status='unpaid'");
    ?>
    <div class="wrap gnw">
      <h1>Tổng quan doanh thu</h1>
      <p class="sub">Kỳ <?php echo esc_html($ym); ?> · gộp đơn khách tự đặt và mọi đối tác ·
        <a href="?page=gn-home&ky=<?php echo esc_attr(date('Y-m', strtotime($from . ' -1 month'))); ?>">← kỳ trước</a></p>

      <div class="kpis">
        <div class="kpi gold"><span>Doanh thu hôm nay</span><b><?php echo gn_money($hn_all); ?></b>
          <small><?php echo $hn_don; ?> đơn · <?php echo $cho; ?> chờ đến</small></div>
        <div class="kpi"><span>Khách tự đặt</span><b><?php echo gn_money($hn_all - $hn_dt); ?></b>
          <small><?php echo $hn_all > 0 ? round(($hn_all - $hn_dt) / $hn_all * 100) : 0; ?>% hôm nay</small></div>
        <div class="kpi"><span>Qua đối tác</span><b><?php echo gn_money($hn_dt); ?></b>
          <small><?php echo $hn_all > 0 ? round($hn_dt / $hn_all * 100) : 0; ?>% hôm nay</small></div>
        <div class="kpi"><span>Doanh số đối tác kỳ này</span><b><?php echo gn_money($ds); ?></b>
          <small><?php echo count($rows); ?> đối tác có phát sinh</small></div>
        <div class="kpi gold"><span>Hoa hồng phải trả</span><b><?php echo gn_money($tra); ?></b>
          <small>gồm thưởng 2%: <?php echo gn_money($thuong); ?> · <?php echo $dat; ?> đối tác đạt mốc</small></div>
        <div class="kpi"><span>Voucher lưu hành</span><b><?php echo gn_money($luu); ?></b>
          <small>nợ phải trả, KHÔNG phải doanh thu</small></div>
      </div>

      <div class="note"><b>Ba con số phải tách bạch.</b>
        Doanh thu là tiền khách trả cho bữa ăn — voucher bán ra chưa dùng không phải doanh thu.
        Hoa hồng phải trả là chi phí bán hàng, ghi ngay trong kỳ phát sinh dù ngày 5 tháng sau mới chuyển.
        Voucher lưu hành <?php echo gn_money($luu); ?> là nợ phải trả; ghi thành doanh thu vào ngày khách dùng.
        Ngoài ra còn <?php echo gn_money($giu); ?> voucher giữ chỗ khách chưa trả tiền — chưa tính vào đâu cả.</div>

      <div class="card">
        <h2>Hoa hồng từng đối tác — kỳ <?php echo esc_html($ym); ?></h2>
        <table class="wp-list-table widefat striped">
          <thead><tr><th>Mã</th><th>Đối tác</th><th>Doanh số</th><th>Hoa hồng luỹ tiến</th>
            <th>Thưởng 2%</th><th>Phải trả</th><th>Tỷ lệ thực</th></tr></thead>
          <tbody>
          <?php if (!$rows): ?><tr><td colspan="7">Chưa có đối tác nào phát sinh doanh số trong kỳ.</td></tr><?php endif; ?>
          <?php foreach ($rows as $r): $k = $r['k']; ?>
            <tr>
              <td><code><?php echo esc_html($r['p']->ref_code); ?></code></td>
              <td><?php echo esc_html($r['p']->contact ?: $r['p']->company); ?></td>
              <td><?php echo gn_money($k['doanh_so']); ?></td>
              <td><?php echo gn_money($k['hoa_hong']); ?></td>
              <td><?php echo $k['thuong_2pt'] ? '<span class="tag ok">' . gn_money($k['thuong_2pt']) . '</span>'
                    : '<span class="tag off">còn ' . gn_money($k['con_thieu']) . '</span>'; ?></td>
              <td><b><?php echo gn_money($k['phai_tra']); ?></b></td>
              <td><?php echo $k['ty_le_thuc']; ?>%</td>
            </tr>
          <?php endforeach; ?>
          </tbody>
          <?php if ($rows): ?><tfoot><tr><th colspan="2">Tổng</th><th><?php echo gn_money($ds); ?></th>
            <th colspan="2"></th><th><?php echo gn_money($tra); ?></th><th><?php echo $ds > 0 ? round($tra / $ds * 100, 2) : 0; ?>%</th></tr></tfoot><?php endif; ?>
        </table>
      </div>

      <div class="card">
        <h2>Đơn hôm nay</h2>
        <table class="wp-list-table widefat striped">
          <thead><tr><th>Mã</th><th>Khách</th><th>SĐT</th><th>Khách</th><th>Nguồn</th><th>Doanh số</th><th>Trạng thái</th></tr></thead>
          <tbody>
          <?php
          $bs = $wpdb->get_results($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . " WHERE booking_date=%s ORDER BY id DESC LIMIT 50", $today));
          if (!$bs) echo '<tr><td colspan="7">Chưa có đơn nào hôm nay.</td></tr>';
          foreach ($bs as $b):
            $cls = $b->booking_status === 'served' ? 'ok' : ($b->booking_status === 'pending' ? 'wait' : 'off'); ?>
            <tr><td><code><?php echo esc_html($b->booking_code); ?></code></td>
              <td><?php echo esc_html($b->customer_name); ?></td>
              <td><?php echo esc_html($b->customer_phone); ?></td>
              <td><?php echo (int) $b->guests; ?></td>
              <td><?php echo $b->ref_code ? '<code>' . esc_html($b->ref_code) . '</code>' : 'Trực tiếp'; ?></td>
              <td><?php echo $b->revenue > 0 ? gn_money($b->revenue) : '<span style="color:#B45309">chưa chốt</span>'; ?></td>
              <td><span class="tag <?php echo $cls; ?>"><?php echo esc_html($b->booking_status); ?></span></td></tr>
          <?php endforeach; ?>
          </tbody>
        </table>
        <p class="sub">Đơn chưa chốt doanh số thì hoa hồng đối tác vẫn bằng 0. Chốt ở tab <b>Tại quầy</b>.</p>
      </div>
    </div><?php
}

/** Quản lý đối tác: duyệt, tạm dừng, lấy link cổng và mã QR. */
function gn_admin_partners() {
    if (!current_user_can(GN_CAP)) wp_die('Không có quyền');
    global $wpdb; gn_admin_css();
    $T = gn_tbl('partners');

    if (isset($_POST['gn_action']) && check_admin_referer('gn_partner_act')) {
        $id = (int) $_POST['pid'];
        $act = sanitize_text_field($_POST['gn_action']);
        if ($act === 'active' || $act === 'paused') {
            $wpdb->update($T, ['status' => $act], ['id' => $id]);
            echo '<div class="notice notice-success"><p>Đã đổi trạng thái đối tác #' . $id . ' sang <b>' . esc_html($act) . '</b>.</p></div>';
        } elseif ($act === 'delete') {
            $wpdb->delete($T, ['id' => $id]);
            echo '<div class="notice notice-success"><p>Đã xoá đối tác #' . $id . '.</p></div>';
        } elseif ($act === 'token') {
            $wpdb->update($T, ['portal_token' => wp_generate_password(32, false, false)], ['id' => $id]);
            echo '<div class="notice notice-success"><p>Đã cấp token mới cho đối tác #' . $id . '. Link cũ hết hiệu lực.</p></div>';
        }
    }

    // Thêm đối tác tay — phần lớn đối tác ký trực tiếp tại quán, không điền form web.
    if (isset($_POST['gn_them_doi_tac']) && check_admin_referer('gn_partner_new')) {
        $ten   = sanitize_text_field($_POST['ten'] ?? '');
        $phone = sanitize_text_field($_POST['phone'] ?? '');
        $email = sanitize_email($_POST['email'] ?? '');
        $type  = sanitize_text_field($_POST['type'] ?? 'khac');
        $area  = sanitize_text_field($_POST['area'] ?? '');
        $bank  = sanitize_text_field($_POST['bank_info'] ?? '');

        if ($ten === '' || $phone === '') {
            echo '<div class="notice notice-error"><p>Thiếu tên hoặc số điện thoại.</p></div>';
        } elseif ($wpdb->get_var($wpdb->prepare("SELECT id FROM {$T} WHERE phone = %s", $phone))) {
            echo '<div class="notice notice-error"><p>Số điện thoại này đã có đối tác.</p></div>';
        } else {
            $max = (int) $wpdb->get_var("SELECT COALESCE(MAX(CAST(SUBSTRING(ref_code, 5) AS UNSIGNED)), 0)
                                         FROM {$T} WHERE ref_code REGEXP '^GN-P[0-9]+$'");
            $ref   = gn_format_ref_code($max + 1);
            $token = wp_generate_password(32, false, false);
            $hand = [
                'company' => $ten, 'contact' => $ten, 'email' => $email, 'phone' => $phone,
                'type' => $type, 'ref_code' => $ref, 'status' => 'active',   // thêm tay là duyệt luôn
                'portal_token' => $token, 'area' => $area, 'bank_info' => $bank,
            ];
            if (gn_column_exists($T, 'role')) $hand['role'] = gn_normalize_partner_role($type);
            $wpdb->insert($T, $hand);
            if ($wpdb->insert_id) {
                echo '<div class="notice notice-success"><p>Đã thêm <b>' . esc_html($ref) . ' · ' . esc_html($ten)
                   . '</b> ở trạng thái <b>active</b>. Mã QR dùng được ngay.</p></div>';
                if ($email && !empty($_POST['gui_mail'])) {
                    $portal = home_url('/cong-doi-tac/?t=' . $token);
                    @wp_mail($email, "Mã đối tác Gánh Ngon của bạn: $ref",
                        "Chào $ten,\n\nGánh Ngon đã tạo hồ sơ đối tác cho bạn.\n\nMã của bạn: $ref\n"
                      . "Link QR đưa khách quét: " . home_url('/p/' . $ref) . "\n"
                      . "Cổng theo dõi doanh số riêng: $portal\n"
                      . "Giữ link cổng này riêng — ai có link là xem được số liệu của bạn.\n\n"
                      . "Hoa hồng luỹ tiến theo doanh số từng ngày: 5 triệu đầu 10%, phần 5–10 triệu 12%, "
                      . "phần vượt 10 triệu 15%. Tháng đạt 100 triệu được cộng thêm 2% tổng doanh số tháng.\n"
                      . "Chốt sổ ngày 1, đối soát 3 ngày, chuyển khoản ngày 5 hàng tháng.\n\n"
                      . "Hotline/Zalo: 0979 232 233\n— Gánh Ngon Phú Quốc",
                        ['Content-Type: text/plain; charset=UTF-8']);
                    echo '<div class="notice notice-info"><p>Đã gửi mã và link cổng tới ' . esc_html($email) . '.</p></div>';
                }
            } else {
                echo '<div class="notice notice-error"><p>Không lưu được. Kiểm tra lại database.</p></div>';
            }
        }
    }

    // Dọn dữ liệu kiểm thử. Marker: đối tác/khách/lô có dấu ZZ TEST hoặc note TEST.
    // Dọn TRƯỚC khi xoá đối tác để còn tìm được lô và hoa hồng theo partner_id.
    // Chạy lại nhiều lần vẫn an toàn.
    if (isset($_POST['gn_don_test']) && check_admin_referer('gn_don_test')) {
        $B = gn_tbl('bookings'); $V = gn_tbl('vouchers'); $X = gn_tbl('voucher_txn');
        $S = gn_tbl('scans'); $BT = gn_tbl('voucher_batches'); $CM = gn_tbl('commissions');
        $ids = $wpdb->get_col("SELECT id FROM {$T} WHERE contact LIKE 'ZZ TEST%' OR company LIKE 'ZZ TEST%'");
        $idIn = $ids ? implode(',', array_map('intval', $ids)) : '0';
        $n = [];

        // 1. lô voucher: của đối tác test HOẶC ghi chú TEST
        $bids = $wpdb->get_col("SELECT id FROM {$BT} WHERE partner_id IN ($idIn) OR note LIKE 'TEST%'");
        $bIn = $bids ? implode(',', array_map('intval', $bids)) : '0';
        // voucher thuộc lô đó + voucher lẻ mua thử
        $vids = $wpdb->get_col("SELECT id FROM {$V} WHERE buyer_name LIKE 'ZZ TEST%' OR batch_id IN ($bIn) OR partner_id IN ($idIn)");
        if ($vids) {
            $vIn = implode(',', array_map('intval', $vids));
            $n['giao dịch voucher'] = (int) $wpdb->query("DELETE FROM {$X} WHERE voucher_id IN ($vIn)");
            $n['voucher'] = (int) $wpdb->query("DELETE FROM {$V} WHERE id IN ($vIn)");
        }
        if ($bids) $n['lô voucher'] = (int) $wpdb->query("DELETE FROM {$BT} WHERE id IN ($bIn)");
        // sổ hoa hồng phẳng của đối tác test hoặc của các lô test
        $n['hoa hồng lô'] = (int) $wpdb->query("DELETE FROM {$CM} WHERE partner_id IN ($idIn) OR ref_id IN ($bIn)");
        $n['đơn đặt bàn'] = (int) $wpdb->query("DELETE FROM {$B} WHERE customer_name LIKE 'ZZ TEST%' OR partner_id IN ($idIn)");
        $n['lượt quét'] = (int) $wpdb->query("DELETE FROM {$S} WHERE partner_id IN ($idIn)");
        if ($ids) $n['đối tác'] = (int) $wpdb->query("DELETE FROM {$T} WHERE id IN ($idIn)");

        $mo = [];
        foreach ($n as $k => $v) if ($v > 0) $mo[] = "$v $k";
        echo '<div class="notice notice-success"><p>' . ($mo
            ? 'Đã xoá ' . esc_html(implode(' · ', $mo)) . '.'
            : 'Không còn dữ liệu thử nào.') . '</p></div>';
    }

    $per = 25;
    $paged = max(1, (int) ($_GET['paged'] ?? 1));
    $q = isset($_GET['q']) ? sanitize_text_field(wp_unslash($_GET['q'])) : '';
    $role_f = isset($_GET['role']) ? sanitize_key(wp_unslash($_GET['role'])) : '';
    $where = '1=1';
    $args = [];
    if ($q !== '') {
        $like = '%' . $wpdb->esc_like($q) . '%';
        $where .= ' AND (contact LIKE %s OR company LIKE %s OR phone LIKE %s OR ref_code LIKE %s OR email LIKE %s)';
        array_push($args, $like, $like, $like, $like, $like);
    }
    if ($role_f !== '' && in_array($role_f, ['partner', 'affiliate', 'koc', 'kol'], true) && gn_column_exists($T, 'role')) {
        $where .= ' AND role = %s';
        $args[] = $role_f;
    }
    $count_sql = "SELECT COUNT(*) FROM {$T} WHERE {$where}";
    $total = (int) ($args ? $wpdb->get_var($wpdb->prepare($count_sql, ...$args)) : $wpdb->get_var($count_sql));
    $pages = max(1, (int) ceil($total / $per));
    if ($paged > $pages) $paged = $pages;
    $off = ($paged - 1) * $per;
    $list_sql = "SELECT * FROM {$T} WHERE {$where} ORDER BY FIELD(status,'pending','active','paused'), id DESC LIMIT %d OFFSET %d";
    $list_args = array_merge($args, [$per, $off]);
    $ps = $wpdb->get_results($wpdb->prepare($list_sql, ...$list_args));
    $ym = current_time('Y-m');
    $pending_n = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$T} WHERE status='pending'");
    ?>
    <div class="wrap gnw">
      <h1>Đối tác & hoa hồng</h1>
      <p class="sub"><?php echo (int) $total; ?> hồ sơ<?php echo $pending_n ? ' · ' . (int) $pending_n . ' chờ duyệt' : ''; ?>.
        Danh sách 25 người một trang, đủ cho chương trình tới 300 đại lý. Không có dữ liệu mẫu.
        Hồ sơ từ <code>/doi-tac/</code> ở trạng thái <b>pending</b> — bấm Duyệt thì mã QR mới gán đơn.</p>
      <form method="get" class="inline" style="margin-bottom:12px">
        <input type="hidden" name="page" value="gn-partners">
        <label>Tìm<input type="search" name="q" value="<?php echo esc_attr($q); ?>" placeholder="Tên, mã, điện thoại"></label>
        <label>Vai trò<select name="role">
          <option value="">Tất cả</option>
          <?php foreach (['partner','affiliate','koc','kol'] as $rr): ?>
            <option value="<?php echo esc_attr($rr); ?>" <?php selected($role_f, $rr); ?>><?php echo esc_html(gn_partner_role_label($rr)); ?></option>
          <?php endforeach; ?>
        </select></label>
        <button class="button">Lọc</button>
      </form>

      <div class="card">
        <h2>Thêm đối tác</h2>
        <form method="post"><?php wp_nonce_field('gn_partner_new'); ?>
          <div class="grid3">
            <div><label>Tên đối tác *</label>
              <input name="ten" class="regular-text" placeholder="Nguyễn Văn A / Công ty Vietravel" required style="width:100%"></div>
            <div><label>Số điện thoại / Zalo *</label>
              <input name="phone" class="regular-text" placeholder="09xx xxx xxx" required style="width:100%"></div>
            <div><label>Email <small style="font-weight:400;color:#646970">— để gửi mã và link cổng</small></label>
              <input name="email" type="email" class="regular-text" placeholder="ban@email.com" style="width:100%"></div>
            <div><label>Loại</label>
              <select name="type" style="width:100%">
                <option value="huong-dan-vien">Hướng dẫn viên</option>
                <option value="cong-ty-du-lich">Công ty du lịch / Lữ hành</option>
                <option value="khach-san">Khách sạn / Resort</option>
                <option value="tai-xe">Tài xế / Grab</option>
                <option value="kol">KOL</option>
                <option value="koc">KOC</option>
                <option value="affiliate">Affiliate</option>
                <option value="hiep-hoi">Hiệp hội du lịch / MICE</option>
                <option value="khac">Khác</option>
              </select></div>
            <div><label>Khu vực</label>
              <input name="area" class="regular-text" placeholder="Dương Đông, Phú Quốc" style="width:100%"></div>
            <div><label>Tài khoản nhận hoa hồng</label>
              <input name="bank_info" class="regular-text" placeholder="Vietcombank · 0071000xxx · NGUYEN VAN A" style="width:100%"></div>
          </div>
          <p style="margin-top:12px">
            <label style="font-weight:400"><input type="checkbox" name="gui_mail" value="1" checked>
              Gửi email kèm mã, link QR và link cổng theo dõi cho đối tác</label>
          </p>
          <p><button class="button button-primary" name="gn_them_doi_tac" value="1">Thêm và duyệt luôn</button></p>
        </form>
      </div>
      <table class="wp-list-table widefat striped">
        <thead><tr><th>Mã</th><th>Tên / Loại</th><th>Liên hệ</th><th>Doanh số kỳ này</th>
          <th>Phải trả</th><th>Trạng thái</th><th>Link & mã QR</th><th>Thao tác</th></tr></thead>
        <tbody>
        <?php if (!$ps) echo '<tr><td colspan="8">Chưa có đối tác nào.</td></tr>';
        foreach ($ps as $p):
          $k = gn_partner_period($p->id, $ym);
          $qr_target = home_url('/p/' . $p->ref_code);
          $portal = home_url('/cong-doi-tac/?t=' . $p->portal_token);
          $cls = $p->status === 'active' ? 'ok' : ($p->status === 'pending' ? 'wait' : 'off'); ?>
          <tr>
            <td><code><?php echo esc_html($p->ref_code); ?></code></td>
            <td><b><?php echo esc_html($p->contact ?: $p->company); ?></b><br><small><?php
              $role_show = !empty($p->role) ? $p->role : gn_normalize_partner_role($p->type);
              echo esc_html(gn_partner_role_label($role_show) . ' · ' . $p->type . ' · ' . $p->area);
            ?></small></td>
            <td><?php echo esc_html($p->phone); ?><br><small><?php echo esc_html($p->email); ?></small></td>
            <td><?php echo gn_money($k['doanh_so']); ?></td>
            <td><b><?php echo gn_money($k['phai_tra']); ?></b><?php if ($k['thuong_2pt']) echo '<br><small>gồm thưởng ' . gn_money($k['thuong_2pt']) . '</small>'; ?></td>
            <td><span class="tag <?php echo $cls; ?>"><?php echo esc_html($p->status); ?></span></td>
            <td style="max-width:240px">
              <a href="<?php echo esc_url($qr_target); ?>" target="_blank"><?php echo esc_html($qr_target); ?></a><br>
              <a href="<?php echo esc_url(gn_qr_url($qr_target, 600)); ?>" target="_blank">Tải mã QR PNG 600px</a><br>
              <a href="<?php echo esc_url(home_url('/p/' . $p->ref_code . '/lau-ga')); ?>" target="_blank">Link lẩu gà sầu riêng</a><br>
              <?php if ($p->portal_token): ?><a href="<?php echo esc_url($portal); ?>" target="_blank">Cổng theo dõi của đối tác</a><?php endif; ?>
            </td>
            <td>
              <form method="post" style="display:inline"><?php wp_nonce_field('gn_partner_act'); ?>
                <input type="hidden" name="pid" value="<?php echo (int) $p->id; ?>">
                <?php if ($p->status !== 'active'): ?>
                  <button class="button button-primary" name="gn_action" value="active">Duyệt</button>
                <?php else: ?>
                  <button class="button" name="gn_action" value="paused">Tạm dừng</button>
                <?php endif; ?>
                <button class="button" name="gn_action" value="token">Cấp token mới</button>
                <button class="button" name="gn_action" value="delete"
                  onclick="return confirm('Xoá hẳn đối tác này? Đơn đã gán vẫn giữ mã cũ nhưng sẽ không tính hoa hồng nữa.')">Xoá</button>
              </form>
            </td>
          </tr>
        <?php endforeach; ?>
        </tbody>
      </table>
      <?php if ($pages > 1): ?>
        <p class="sub">Trang <?php echo (int) $paged; ?> / <?php echo (int) $pages; ?>
          <?php if ($paged > 1): ?> · <a href="<?php echo esc_url(add_query_arg(['paged' => $paged - 1])); ?>">Trước</a><?php endif; ?>
          <?php if ($paged < $pages): ?> · <a href="<?php echo esc_url(add_query_arg(['paged' => $paged + 1])); ?>">Sau</a><?php endif; ?>
        </p>
      <?php endif; ?>
      <?php
      $co_test = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$T} WHERE contact LIKE 'ZZ TEST%' OR company LIKE 'ZZ TEST%'")
               + (int) $wpdb->get_var("SELECT COUNT(*) FROM " . gn_tbl('bookings') . " WHERE customer_name LIKE 'ZZ TEST%'")
               + (int) $wpdb->get_var("SELECT COUNT(*) FROM " . gn_tbl('vouchers') . " WHERE buyer_name LIKE 'ZZ TEST%'")
               + (int) $wpdb->get_var("SELECT COUNT(*) FROM " . gn_tbl('voucher_batches') . " WHERE note LIKE 'TEST%'");
      if ($co_test): ?>
        <div class="card" style="border-color:#B45309;background:#FCEEDC">
          <h2 style="color:#B45309">Còn <?php echo (int) $co_test; ?> bản ghi kiểm thử</h2>
          <p class="sub" style="margin-bottom:10px">Dữ liệu do kiểm thử tự động tạo, tên bắt đầu bằng
            <code>ZZ TEST</code>. Chúng đang cộng vào doanh thu và hoa hồng trên màn Tổng quan nên số
            hiển thị chưa phải số thật. Xoá trước khi mở bán.</p>
          <form method="post"><?php wp_nonce_field('gn_don_test'); ?>
            <button class="button" name="gn_don_test" value="1"
              onclick="return confirm('Xoá toàn bộ đối tác, đơn đặt bàn và voucher có tên bắt đầu bằng ZZ TEST?')">
              Dọn dữ liệu thử</button>
          </form>
        </div>
      <?php endif; ?>

      <div class="note"><b>Bộ vật phẩm in.</b> Mã QR trỏ tới <code>/p/{mã}</code>.
        Thêm <code>?m=standee</code>, <code>?m=the</code>, <code>?m=poster</code>, <code>?m=sticker</code>
        vào cuối để biết vật phẩm nào ra khách. In tối thiểu 25×25mm, chừa viền trắng 4mm, không cán bóng.</div>
    </div><?php
}

/** Công cụ tại quầy: chốt doanh số, thu tiền voucher, quét trừ voucher. */
function gn_admin_counter() {
    if (!current_user_can(GN_CAP)) wp_die('Không có quyền');
    global $wpdb; gn_admin_css();
    $msg = '';

    if (isset($_POST['gn_do']) && check_admin_referer('gn_counter')) {
        $do = sanitize_text_field($_POST['gn_do']);
        if ($do === 'settle') {
            $code = sanitize_text_field($_POST['code']); $rev = (float) $_POST['revenue'];
            $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . " WHERE booking_code=%s", $code));
            if (!$b) $msg = ['err', 'Không tìm thấy đơn ' . $code];
            else {
                $wpdb->update(gn_tbl('bookings'), ['revenue' => $rev, 'served_on' => current_time('Y-m-d'),
                    'booking_status' => 'served', 'payment_status' => 'paid'], ['id' => $b->id]);
                do_action('gn_booking_settled', $b->id, $rev);   // hoá đơn cảm ơn + báo hoa hồng
                $extra = '';
                if ($b->partner_id) {
                    $day = (float) $wpdb->get_var($wpdb->prepare("SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . "
                        WHERE partner_id=%d AND served_on=%s AND booking_status IN ('served','checked_in','completed')",
                        $b->partner_id, current_time('Y-m-d')));
                    $extra = ' Đối tác ' . $b->ref_code . ': doanh số hôm nay ' . gn_money($day)
                           . ', hoa hồng ' . gn_money(gn_commission_for_day($day)) . '.';
                }
                $msg = ['ok', 'Đã chốt ' . gn_money($rev) . ' cho đơn ' . $code . '.' . $extra];
            }
        } elseif ($do === 'vpay') {
            $c = sanitize_text_field($_POST['vcode']);
            $v = $wpdb->get_row($wpdb->prepare("SELECT id,price FROM " . gn_tbl('vouchers') . " WHERE code=%s", $c));
            if (!$v) $msg = ['err', 'Không tìm thấy voucher ' . $c];
            elseif (gn_voucher_mark_paid($v->id)) $msg = ['ok', 'Đã thu ' . gn_money($v->price) . ' cho voucher ' . $c . '. Voucher có hiệu lực ngay, email đã gửi lại cho khách.'];
            else $msg = ['err', 'Voucher ' . $c . ' không ở trạng thái chờ thanh toán.'];
        } elseif ($do === 'vredeem') {
            $r = gn_voucher_redeem(sanitize_text_field($_POST['vcode2']), (float) $_POST['vamount']);
            $msg = $r['ok'] ? ['ok', 'Đã trừ ' . gn_money($r['da_dung']) . ', số dư còn ' . gn_money($r['con_lai']) . '.'] : ['err', $r['msg']];
        }
    }
    ?>
    <div class="wrap gnw">
      <h1>Công cụ tại quầy</h1>
      <p class="sub">Ba việc nhân viên làm hằng ngày. Chốt doanh số là mắt xích quan trọng nhất — không chốt thì hoa hồng đối tác mãi bằng 0.</p>
      <?php if ($msg): ?><div class="notice notice-<?php echo $msg[0] === 'ok' ? 'success' : 'error'; ?>"><p><?php echo esc_html($msg[1]); ?></p></div><?php endif; ?>

      <div class="grid3">
        <div class="card">
          <h2>1. Chốt doanh số sau khi khách ăn xong</h2>
          <form method="post"><?php wp_nonce_field('gn_counter'); ?>
            <label>Mã đơn</label><input name="code" class="regular-text" placeholder="GN20260809ABCD" required>
            <label style="margin-top:8px">Tiền khách thực trả (sau giảm giá)</label>
            <input name="revenue" type="number" min="0" step="1000" class="regular-text" placeholder="1640000" required>
            <p><button class="button button-primary" name="gn_do" value="settle">Chốt doanh số</button></p>
          </form>
          <p class="sub">Nhập số tiền <b>thực trả</b>, không phải giá niêm yết. Hoa hồng tính trên số này.</p>
        </div>

        <div class="card">
          <h2>2. Thu tiền voucher giữ chỗ</h2>
          <form method="post"><?php wp_nonce_field('gn_counter'); ?>
            <label>Mã voucher</label><input name="vcode" class="regular-text" placeholder="GN-V-XXXX-XXXX" required>
            <p><button class="button button-primary" name="gn_do" value="vpay">Xác nhận đã thu tiền</button></p>
          </form>
          <p class="sub">Voucher <b>CHƯA THANH TOÁN</b> chưa có giá trị. Thu tiền xong mới nạp số dư và mới tính doanh số cho người giới thiệu.</p>
        </div>

        <div class="card">
          <h2>3. Quét voucher trừ hoá đơn</h2>
          <form method="post"><?php wp_nonce_field('gn_counter'); ?>
            <label>Mã voucher</label><input name="vcode2" class="regular-text" placeholder="GN-V-XXXX-XXXX" required>
            <label style="margin-top:8px">Số tiền cần trừ</label>
            <input name="vamount" type="number" min="0" step="1000" class="regular-text" required>
            <p><button class="button button-primary" name="gn_do" value="vredeem">Trừ vào hoá đơn</button></p>
          </form>
          <p class="sub">Trừ tối đa bằng số dư. Hết số dư thì voucher chuyển sang <b>đã dùng</b>.</p>
        </div>
      </div>

      <div class="card">
        <h2>Đơn chờ chốt doanh số</h2>
        <table class="wp-list-table widefat striped">
          <thead><tr><th>Mã đơn</th><th>Ngày</th><th>Khách</th><th>SĐT</th><th>Số khách</th><th>Nguồn</th></tr></thead>
          <tbody><?php
          $ws = $wpdb->get_results("SELECT * FROM " . gn_tbl('bookings') . "
              WHERE (revenue IS NULL OR revenue=0) AND booking_status NOT IN ('cancelled','no_show')
              ORDER BY booking_date DESC, id DESC LIMIT 40");
          if (!$ws) echo '<tr><td colspan="6">Không còn đơn nào chờ chốt.</td></tr>';
          foreach ($ws as $b): ?>
            <tr><td><code><?php echo esc_html($b->booking_code); ?></code></td>
              <td><?php echo esc_html($b->booking_date); ?></td>
              <td><?php echo esc_html($b->customer_name); ?></td>
              <td><?php echo esc_html($b->customer_phone); ?></td>
              <td><?php echo (int) $b->guests; ?></td>
              <td><?php
                echo $b->ref_code ? '<code>' . esc_html($b->ref_code) . '</code>' : 'Trực tiếp';
                if (!empty($b->signature_dish)) echo '<br><small>lẩu gà sầu riêng</small>';
                if (!empty($b->lead_class)) echo '<br><small>' . esc_html($b->lead_class) . '</small>';
              ?></td></tr>
          <?php endforeach; ?></tbody>
        </table>
      </div>
    </div><?php
}

/* --------------------------------------------------------------------------
   2. /cong-doi-tac/?t=TOKEN — đối tác tự xem doanh số
   -------------------------------------------------------------------------- */
function gn_portal_html() {
    global $wpdb;
    $token = isset($_GET['t']) ? sanitize_text_field($_GET['t']) : '';
    if (strlen($token) < 20) {
        return '<div class="gnp"><section class="gnp-sec"><div class="gnp-head">'
             . '<h3>Cần link riêng của bạn</h3><p class="gnp-sub">Cổng này mở bằng link riêng gửi trong email lúc duyệt hồ sơ, không dùng mật khẩu. '
             . 'Mất link thì nhắn Zalo 0979 232 233 để được gửi lại.</p></div></section></div>';
    }
    $p = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('partners') . " WHERE portal_token=%s", $token));
    if (!$p) return '<div class="gnp"><section class="gnp-sec"><div class="gnp-head"><h3>Link không đúng</h3>'
                  . '<p class="gnp-sub">Có thể link đã được cấp lại. Nhắn Zalo 0979 232 233 để lấy link mới.</p></div></section></div>';

    $ym = isset($_GET['ky']) ? sanitize_text_field($_GET['ky']) : current_time('Y-m');
    $today = current_time('Y-m-d');
    $k = gn_partner_period($p->id, $ym);
    $scans = (int) $wpdb->get_var($wpdb->prepare("SELECT COUNT(*) FROM " . gn_tbl('scans') . " WHERE partner_id=%d AND scanned_on=%s", $p->id, $today));
    $rev_today = (float) $wpdb->get_var($wpdb->prepare("SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . "
        WHERE partner_id=%d AND served_on=%s AND booking_status IN ('served','checked_in','completed')", $p->id, $today));
    $bd = gn_commission_breakdown($rev_today);
    $rows = $wpdb->get_results($wpdb->prepare("SELECT * FROM " . gn_tbl('bookings') . "
        WHERE partner_id=%d ORDER BY booking_date DESC, id DESC LIMIT 25", $p->id));

    ob_start(); ?>
    <div class="gnp">
      <section class="gnp-hero">
        <span class="gnp-rule"></span>
        <p class="gnp-eyebrow">Cổng đối tác · <?php echo esc_html($p->ref_code); ?> · <?php
          $role = !empty($p->role) ? $p->role : gn_normalize_partner_role($p->type ?? '');
          echo esc_html(gn_partner_role_label($role));
        ?></p>
        <h2><?php echo esc_html($p->contact ?: $p->company); ?></h2>
        <?php if ($p->status !== 'active'): ?>
          <p class="gnp-lead">Hồ sơ đang <b><?php echo esc_html($p->status); ?></b>. Mã QR chỉ gán đơn sau khi nhà hàng duyệt.</p>
        <?php endif; ?>
        <p class="gnp-lead">Hoa hồng luỹ tiến theo doanh số từng ngày: 5 triệu đầu 10%, phần 5–10 triệu 12%,
          phần vượt 10 triệu 15%. Tháng đạt 100 triệu được cộng thêm 2% tổng doanh số tháng.</p>
      </section>

      <section class="gnp-sec">
        <div class="gnp-portal">
          <div class="gnp-kpis">
            <div><span>Lượt quét QR hôm nay</span><b><?php echo $scans; ?></b><small><?php echo esc_html($today); ?></small></div>
            <div><span>Doanh số hôm nay</span><b><?php echo gn_money($rev_today); ?></b><small>chỉ tính khách đã đến</small></div>
            <div class="is-gold"><span>Hoa hồng hôm nay</span><b><?php echo gn_money(gn_commission_for_day($rev_today)); ?></b>
              <small><?php echo $rev_today > 0 ? round(gn_commission_for_day($rev_today) / $rev_today * 100, 1) . '% doanh số' : 'chưa có đơn'; ?></small></div>
            <div><span>Kỳ <?php echo esc_html($ym); ?></span><b><?php echo gn_money($k['phai_tra']); ?></b>
              <small><?php echo $k['dat_moc_thuong'] ? 'đã gồm thưởng 2%: ' . gn_money($k['thuong_2pt'])
                    : 'còn ' . gn_money($k['con_thieu']) . ' để đạt thưởng 2%'; ?></small></div>
          </div>

          <?php if ($rev_today > 0): ?>
          <div class="gnp-ladder" style="margin-bottom:16px">
            <?php foreach ($bd as $b): if ($b['doanh_so'] <= 0) continue; ?>
              <div style="flex:<?php echo (int) $b['doanh_so']; ?> 1 0">
                <span><?php echo gn_money($b['doanh_so']); ?> × <?php echo $b['ty_le']; ?>%</span>
                <b><?php echo gn_money($b['hoa_hong']); ?></b></div>
            <?php endforeach; ?>
          </div>
          <?php endif; ?>

          <div class="gnp-tablewrap">
            <table>
              <thead><tr><th>Ngày</th><th>Mã đơn</th><th>Khách</th><th>Số khách</th><th>Doanh số</th><th>Trạng thái</th></tr></thead>
              <tbody>
              <?php if (!$rows) echo '<tr><td colspan="6">Chưa có đơn nào từ mã của bạn.</td></tr>';
              foreach ($rows as $b):
                $served = in_array($b->booking_status, ['served', 'checked_in', 'completed'], true); ?>
                <tr><td><?php echo esc_html($b->booking_date); ?></td>
                  <td><?php echo esc_html($b->booking_code); ?></td>
                  <td><?php echo esc_html($b->customer_name); ?></td>
                  <td><?php echo (int) $b->guests; ?></td>
                  <td><?php echo $b->revenue > 0 ? '<b>' . gn_money($b->revenue) . '</b>' : '—'; ?></td>
                  <td><span class="gnp-tag <?php echo $served ? 'is-ok' : 'is-warn'; ?>">
                    <?php echo $served ? 'Đã đến' : 'Chờ đến'; ?></span></td></tr>
              <?php endforeach; ?>
              </tbody>
            </table>
          </div>
          <p class="gnp-note gnp-note--left">Hoa hồng chỉ chốt khi khách <b>đã đến và đã thanh toán</b>.
            Đơn còn "Chờ đến" chưa tính. Thấy số sai thì báo trong 3 ngày đầu tháng, nhắn Zalo 0979 232 233.</p>
        </div>
      </section>

      <section class="gnp-sec gnp-sec--sand">
        <div class="gnp-head"><span class="gnp-rule"></span><p class="gnp-eyebrow">Mã QR của bạn</p>
          <h3>In ra, đưa cho khách quét</h3></div>
        <div class="gnp-split" style="margin-bottom:28px">
          <div>
            <h3>Bàn thường hôm nay</h3>
            <p class="gnp-sub"><code><?php echo esc_html(home_url('/p/' . $p->ref_code)); ?></code></p>
            <img src="<?php echo esc_url(gn_qr_url(home_url('/p/' . $p->ref_code), 220)); ?>" alt="QR bàn thường <?php echo esc_attr($p->ref_code); ?>" width="180" height="180" style="background:#fff;border-radius:12px;padding:8px">
          </div>
          <div>
            <h3>Lẩu gà sầu riêng</h3>
            <p class="gnp-sub"><code><?php echo esc_html(home_url('/p/' . $p->ref_code . '/lau-ga')); ?></code></p>
            <img src="<?php echo esc_url(gn_qr_url(home_url('/p/' . $p->ref_code . '/lau-ga'), 220)); ?>" alt="QR lẩu gà sầu riêng <?php echo esc_attr($p->ref_code); ?>" width="180" height="180" style="background:#fff;border-radius:12px;padding:8px">
          </div>
        </div>
        <p class="gnp-sub">Thêm <code>?m=standee</code>, <code>?m=the</code>, <code>?m=poster</code> hoặc
          <code>?m=sticker</code> vào cuối link để biết vật phẩm nào ra khách. Giữ link cổng này riêng.</p>
      </section>
    </div><?php
    return ob_get_clean();
}

