// Schema injection — per master brief §21
// ============================================================
function gn_schema_all() {
    $schemas = [];
    $org_base = [
        '@type'     => 'Restaurant',
        '@id'       => home_url('/') . '#restaurant',
        'name'      => 'Gánh Ngon',
        'alternateName' => 'Gánh Ngon Phú Quốc',
        'url'       => home_url('/'),
        'telephone' => gn_phone_raw(),
        'email'     => 'contact@ganhngon.com',
        'image'     => home_url('/wp-content/uploads/2026/09/ganhngon-khong-gian-quan.webp'),
        'priceRange' => 'Liên hệ tư vấn',
        'servesCuisine' => ['Vietnamese', 'Asian'],
        'openingHours' => 'Mo-Su 06:30-02:00',
        'openingHoursSpecification' => [[
            '@type'     => 'OpeningHoursSpecification',
            'dayOfWeek' => ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
            'opens'     => '06:30',
            'closes'    => '02:00',
        ]],
        'address'   => [
            '@type'           => 'PostalAddress',
            'streetAddress'   => '113 Trần Hưng Đạo',
            'addressLocality' => 'Dương Đông',
            'addressRegion'   => 'Phú Quốc, Kiên Giang',
            'addressCountry'  => 'VN',
        ],
        'geo' => [
            '@type'     => 'GeoCoordinates',
            'latitude'  => 10.2167,
            'longitude' => 103.9667,
        ],
        'description' => 'Lẩu gà sầu riêng tại Gánh Ngon, 113 Trần Hưng Đạo, Dương Đông, Phú Quốc. Bàn thường trong ngày. Mở cửa 6:30–2:00. Giá báo tại nhà hàng.',
        'sameAs' => [gn_facebook(), gn_instagram(), gn_telegram(), 'https://saophuquoc.com/'],
    ];

    if (is_front_page()) {
        $schemas[] = $org_base + ['@context' => 'https://schema.org'];
        $schemas[] = [
            '@context' => 'https://schema.org',
            '@type'    => 'LocalBusiness',
            '@id'      => home_url('/') . '#localbusiness',
            'name'     => 'Gánh Ngon',
            'image'    => home_url('/wp-content/uploads/2026/09/ganhngon-khong-gian-quan.webp'),
            'telephone' => gn_phone_raw(),
            'address'  => $org_base['address'],
            'url'      => home_url('/'),
        ];
        $schemas[] = [
            '@context' => 'https://schema.org',
            '@type'    => 'Organization',
            '@id'      => home_url('/') . '#organization',
            'name'     => 'Gánh Ngon',
            'logo'     => home_url('/wp-content/themes/ganhngon-restaurant/screenshot.png'),
            'url'      => home_url('/'),
            'sameAs'   => array_values(array_filter([gn_facebook(), gn_instagram(), gn_telegram(), gn_tiktok(), gn_youtube()])),
            'parentOrganization' => ['@type'=>'Organization','name'=>'SAO PHU QUOC','url'=>'https://saophuquoc.com/'],
        ];
        $faqs = gn_faqs_i18n();
        if ($faqs) {
            $schemas[] = [
                '@context' => 'https://schema.org',
                '@type'    => 'FAQPage',
                'mainEntity' => array_map(function($f){
                    return ['@type' => 'Question','name'  => $f['q'],'acceptedAnswer' => ['@type'=>'Answer','text'=>$f['a']]];
                }, $faqs),
            ];
        }
    }
    if (is_page('thuc-don')) {
        $schemas[] = [
            '@context' => 'https://schema.org',
            '@type'    => 'Menu',
            'name'     => 'Thực đơn Gánh Ngon',
            'description' => '220+ món đặc sản Việt Nam ba miền tại Phú Quốc',
            'inLanguage' => ['vi','en','zh','ru'],
        ];
    }
    if (is_page('khach-doan-tiec-rieng')) {
        $schemas[] = [
            '@context' => 'https://schema.org',
            '@type'    => 'Event',
            'name'     => 'Sự kiện & Tiệc riêng tại Gánh Ngon',
            'description' => 'Đặt tiệc sinh nhật, tiệc công ty, gala dinner, họp mặt gia đình, khách đoàn du lịch và phòng VIP riêng tư',
            'location' => $org_base,
            'eventStatus' => 'https://schema.org/EventScheduled',
            'eventAttendanceMode' => 'https://schema.org/OfflineEventAttendanceMode',
        ];
    }
    foreach ($schemas as $s) {
        echo '<script type="application/ld+json">' . wp_json_encode($s, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "</script>\n";
    }
}
add_action('wp_head', 'gn_schema_all', 30);

/**
 * Open Graph dự phòng — CHỈ chạy khi không có plugin SEO nào lo phần này.
 *
 * Bản cũ in og:title và og:description vô điều kiện, trong khi Yoast cũng in,
 * nên mỗi trang có HAI thẻ og:title với nội dung khác nhau. Đa số trình đọc lấy
 * thẻ sau, nên khi chia sẻ link ra Facebook/Zalo hiện mô tả sai — trang đối tác
 * lại hiện mô tả nhà hàng chung.
 *
 * og:image cũ trỏ vào ảnh stock Unsplash của người khác. Ảnh chia sẻ của thương
 * hiệu mà mượn ảnh bên thứ ba là hỏng cả nhận diện lẫn quyền dùng, nên bỏ. Khi
 * có ảnh thật, đặt Logo trong Tuỳ biến giao diện là hàm này tự lấy.
 */
function gn_og_image() {
    if (defined('WPSEO_VERSION') || defined('RANK_MATH_VERSION')) return;   // plugin SEO đã lo

    if (function_exists('gn_t')) {
        echo '<meta property="og:title" content="' . esc_attr(wp_get_document_title()) . '" />' . "\n";
        echo '<meta property="og:description" content="' . esc_attr(gn_t('hero_lead')) . '" />' . "\n";
    }

    // ưu tiên ảnh đại diện bài viết, rồi logo, rồi icon site — không dùng ảnh stock
    $img = '';
    if (is_singular() && has_post_thumbnail()) {
        $img = get_the_post_thumbnail_url(get_queried_object_id(), 'full');
    }
    if (!$img) {
        $logo_id = (int) get_theme_mod('custom_logo');
        if ($logo_id) $img = wp_get_attachment_image_url($logo_id, 'full');
    }
    if (!$img && function_exists('get_site_icon_url')) $img = get_site_icon_url(512);
    if (!$img) return;

    echo '<meta property="og:image" content="' . esc_url($img) . '" />' . "\n";
    echo '<meta name="twitter:image" content="' . esc_url($img) . '" />' . "\n";
}
add_action('wp_head', 'gn_og_image', 6);

/**
 * Số điện thoại lọt vào tiêu đề/mô tả SEO không khớp số công bố.
 * Đo được: meta description ghi 0932154266 trong khi toàn site dùng 0979 232 233.
 */
function gn_fix_seo_phone($text) {
    if (!is_string($text) || $text === '') return $text;
    return preg_replace('/0\d{2}[\s.\-]?\d{3}[\s.\-]?\d{3,4}/', '0979 232 233', $text);
}
add_filter('wpseo_metadesc', 'gn_fix_seo_phone', 30);
add_filter('wpseo_title', 'gn_fix_seo_phone', 30);
add_filter('wpseo_opengraph_desc', 'gn_fix_seo_phone', 30);
add_filter('wpseo_twitter_description', 'gn_fix_seo_phone', 30);

