add_action('gn_voucher_paid', function ($voucher_id, $paid) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('vouchers') . " WHERE id=%d", $voucher_id));
    if (!$v) return;
    $dich_vu = 'Voucher tiền mặt ' . gn_money($v->face_value);
    gn_send_customer_invoice([
        'email'      => $v->buyer_email,
        'ten_khach'  => $v->buyer_name ?: 'Quý khách',
        'ma_don'     => $v->code,
        'dich_vu'    => $dich_vu,
        'ngay'       => date('d/m/Y', current_time('timestamp')),
        'tong'       => gn_money($paid),
        'ma_hoa_don' => gn_invoice_no('GNV', $v->id),
        'link'       => home_url('/voucher/?c=' . $v->code),
    ]);
    gn_partner_notice_for($v->partner_id, $paid, [
        'ma_don'    => $v->code,
        'ten_khach' => $v->buyer_name ?: 'Khách lẻ',
        'dich_vu'   => $dich_vu,
        'ngay'      => date('d/m/Y', current_time('timestamp')),
    ]);
}, 10, 2);

