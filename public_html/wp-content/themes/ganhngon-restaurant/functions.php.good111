/* ==========================================================================
   GN — HOÁ ĐƠN TỰ ĐỘNG CHO KHÁCH + THÔNG BÁO ĐỐI SOÁT CHO ĐỐI TÁC
   --------------------------------------------------------------------------
   Nội dung thư theo đúng mẫu chủ nhà hàng duyệt.

   Điểm cần chú ý về con số gửi cho đối tác: hoa hồng tính LUỸ TIẾN trên doanh số
   CẢ NGÀY (5tr đầu 10%, 5–10tr 12%, vượt 10tr 15%), nên một đơn lẻ không có tỷ lệ
   cố định. Số tiền của riêng đơn đó = hoa hồng cả ngày SAU đơn trừ hoa hồng cả
   ngày TRƯỚC đơn. Cộng các phần chênh này lại đúng bằng tổng hoa hồng ngày, nên
   đối tác cộng tay cũng khớp.

   Ba mốc kích hoạt:
     gn_voucher_paid       khách trả tiền voucher  -> hoá đơn khách + báo đối tác
     gn_voucher_topped_up  khách nạp thêm          -> hoá đơn khách + báo đối tác
     gn_voucher_redeemed   khách dùng voucher      -> hoá đơn khách (hoa hồng đã chốt lúc trả tiền)
     gn_booking_settled    chốt doanh số bữa ăn    -> hoá đơn khách + báo đối tác
   ========================================================================== */

define('GN_HOTLINE',       '0979 232 233');
define('GN_EMAIL_HOTRO',   'contact@ganhngon.com');
define('GN_EMAIL_DOITAC',  'partner@ganhngon.com');

function gn_mail_shell($than, $mau_dai, $chu_dai) {
    return '<div style="background:#F0E9DC;padding:24px 12px">
  <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;width:100%;background:#fff;border-radius:12px;overflow:hidden">
    <tr><td style="background:#2C1810;padding:26px 24px;text-align:center">
      <div style="font:600 26px/1.2 Georgia,serif;letter-spacing:.05em;color:#D4AF37">GÁNH NGON</div>
      <div style="font:600 9px/1.4 Arial,sans-serif;letter-spacing:.08em;color:#C9B79E;margin-top:4px">ĐẶC SẢN VIỆT NAM · PHÚ QUỐC</div>
    </td></tr>
    <tr><td style="background:' . $mau_dai . ';color:#fff;padding:11px 24px;font:700 12px/1.5 Arial,sans-serif;letter-spacing:.04em">' . esc_html($chu_dai) . '</td></tr>
    <tr><td style="padding:28px 24px;font:400 15px/1.75 Arial,sans-serif;color:#3D3128">' . $than . '</td></tr>
    <tr><td style="background:#1A0E07;padding:20px 24px;text-align:center;font:400 12px/1.7 Arial,sans-serif;color:#C9B79E">
      Gánh Ngon · 113 Trần Hưng Đạo, Dương Đông, Phú Quốc<br>
      ' . esc_html(GN_HOTLINE) . ' · Zalo · WhatsApp · ' . esc_html(GN_EMAIL_HOTRO) . '
    </td></tr>
  </table></div>';
}

/** Danh sách gạch đầu dòng, khoá in thường, giá trị in đậm. */
function gn_mail_list($rows) {
    $out = '<ul style="margin:0 0 18px;padding-left:20px">';
    foreach ($rows as $k => $v) {
        $dam = str_starts_with((string) $k, '*');
        $k = ltrim((string) $k, '*');
        $out .= '<li style="margin-bottom:7px">' . esc_html($k) . ': '
              . ($dam ? '<b style="color:#7A5A12;font-size:16px">' : '<b>')
              . esc_html($v) . '</b></li>';
    }
    return $out . '</ul>';
}

function gn_invoice_no($prefix, $id) {
    return $prefix . date('Ymd') . '-' . str_pad((string) $id, 5, '0', STR_PAD_LEFT);
}

/** Ngày chuyển khoản của kỳ: ngày 5 tháng kế tiếp. */
function gn_payout_date() {
    return date('d/m/Y', strtotime('first day of next month +4 days', strtotime(current_time('Y-m-d'))));
}

/* ==========================================================================
   HOÁ ĐƠN CHO KHÁCH — theo mẫu đã duyệt
   ========================================================================== */
function gn_send_customer_invoice($args) {
    if (empty($args['email'])) return;
    $than =
      '<p style="margin:0 0 16px">Kính chào <b>' . esc_html($args['ten_khach']) . '</b>,</p>'
    . '<p style="margin:0 0 16px">Cảm ơn Quý khách đã tin tưởng và sử dụng dịch vụ của <b>Gánh Ngon</b>.</p>'
    . '<p style="margin:0 0 12px">Gánh Ngon xin gửi thông tin hóa đơn cho dịch vụ Quý khách vừa sử dụng:</p>'
    . gn_mail_list([
        'Mã đơn hàng'        => $args['ma_don'],
        'Dịch vụ'            => $args['dich_vu'],
        'Ngày sử dụng'       => $args['ngay'],
        '*Tổng thanh toán'   => $args['tong'],
        'Mã hóa đơn'         => $args['ma_hoa_don'],
      ])
    . '<p style="margin:0 0 16px">Hóa đơn điện tử có thể xem tại: '
    . '<a href="' . esc_url($args['link']) . '" style="color:#7A5A12">' . esc_html($args['link']) . '</a></p>'
    . '<p style="margin:0 0 16px">Nếu cần hỗ trợ về hóa đơn hoặc dịch vụ, Quý khách vui lòng liên hệ với Gánh Ngon qua '
    . '<b>' . esc_html(GN_HOTLINE) . '</b> hoặc <a href="mailto:' . esc_attr(GN_EMAIL_HOTRO) . '" style="color:#7A5A12">'
    . esc_html(GN_EMAIL_HOTRO) . '</a>.</p>'
    . '<p style="margin:0 0 20px">Cảm ơn Quý khách và hẹn gặp lại trong những trải nghiệm tiếp theo cùng <b>Gánh Ngon</b>.</p>'
    . '<p style="margin:0;color:#6E5D4E">Trân trọng,<br><b style="color:#1F1710">Gánh Ngon</b><br>'
    . '<a href="https://ganhngon.com" style="color:#7A5A12">ganhngon.com</a></p>';

    @wp_mail($args['email'],
        'Hóa đơn Gánh Ngon · ' . $args['ma_don'],
        gn_mail_shell($than, '#1E7A4C', 'ĐÃ THANH TOÁN ' . $args['tong']),
        ['Content-Type: text/html; charset=UTF-8']);
}

/* ==========================================================================
   THÔNG BÁO ĐỐI SOÁT CHO ĐỐI TÁC — theo mẫu đã duyệt
   ========================================================================== */
function gn_send_partner_notice($partner_id, $args) {
    if (!$partner_id) return;
    global $wpdb;
    $p = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('partners') . " WHERE id=%d", $partner_id));
    if (!$p || empty($p->email)) return;

    $ten_dt   = $p->contact ?: $p->company;
    $gia_tri  = (float) $args['gia_tri'];
    $nhan     = (float) $args['doi_tac_nhan'];
    $phi      = max(0, $gia_tri - $nhan);
    $link     = $p->portal_token ? home_url('/cong-doi-tac/?t=' . $p->portal_token) : home_url('/doi-tac/');

    $than =
      '<p style="margin:0 0 16px">Kính chào <b>' . esc_html($ten_dt) . '</b>,</p>'
    . '<p style="margin:0 0 16px">Gánh Ngon xin thông báo khách hàng đã hoàn tất sử dụng dịch vụ thuộc đơn hàng '
    . '<b>#' . esc_html($args['ma_don']) . '</b> giới thiệu bởi <b>' . esc_html($ten_dt)
    . ' (' . esc_html($p->ref_code) . ')</b>.</p>'
    . '<p style="margin:0 0 12px">Thông tin giao dịch:</p>'
    . gn_mail_list([
        'Khách hàng'                     => $args['ten_khach'],
        'Dịch vụ'                        => $args['dich_vu'],
        'Ngày sử dụng'                   => $args['ngay'],
        'Giá trị đơn hàng'               => gn_money($gia_tri),
        'Phí dịch vụ Gánh Ngon giữ lại'  => gn_money($phi),
        '*Số tiền đối tác được nhận'     => gn_money($nhan),
        'Dự kiến thanh toán'             => gn_payout_date(),
      ])
    . '<div style="background:#FAF7F0;border-left:3px solid #D4AF37;padding:12px 16px;margin:0 0 18px;font-size:13px;line-height:1.7;color:#5A4B3E">'
    . 'Hoa hồng tính luỹ tiến trên doanh số <b>cả ngày</b>: 5 triệu đầu 10%, phần 5–10 triệu 12%, phần vượt 10 triệu 15%. '
    . 'Số tiền của riêng đơn này là phần chênh khi doanh số ngày tăng từ ' . gn_money($args['ngay_truoc'])
    . ' lên ' . gn_money($args['ngay_sau']) . '. Cộng các đơn trong ngày lại sẽ khớp đúng tổng hoa hồng ngày là '
    . '<b>' . gn_money($args['hoa_hong_ngay']) . '</b>.'
    . '</div>'
    . '<p style="margin:0 0 16px">Khoản tiền trên sẽ được Gánh Ngon đối soát và thanh toán theo chính sách hợp tác hiện hành.</p>'
    . '<p style="margin:0 0 16px">Quý Đối tác có thể xem chi tiết giao dịch và lịch sử đối soát tại: '
    . '<a href="' . esc_url($link) . '" style="color:#7A5A12">' . esc_html($link) . '</a></p>'
    . '<p style="margin:0 0 16px">Nếu có thắc mắc về giao dịch hoặc số tiền đối soát, vui lòng liên hệ '
    . '<a href="mailto:' . esc_attr(GN_EMAIL_DOITAC) . '" style="color:#7A5A12">' . esc_html(GN_EMAIL_DOITAC) . '</a>.</p>'
    . '<p style="margin:0 0 20px">Cảm ơn Quý Đối tác đã đồng hành cùng <b>Gánh Ngon</b>.</p>'
    . '<p style="margin:0;color:#6E5D4E">Trân trọng,<br><b style="color:#1F1710">Gánh Ngon – Bộ phận Đối tác</b><br>'
    . '<a href="https://ganhngon.com" style="color:#7A5A12">ganhngon.com</a></p>';

    @wp_mail($p->email,
        'Đối soát Gánh Ngon · đơn #' . $args['ma_don'] . ' · nhận ' . gn_money($nhan),
        gn_mail_shell($than, '#7A5A12', 'ĐỐI TÁC NHẬN ' . gn_money($nhan)),
        ['Content-Type: text/html; charset=UTF-8']);

    if (function_exists('gn_send_telegram')) {
        gn_send_telegram('💰 <b>' . $p->ref_code . '</b> đơn ' . esc_html($args['ma_don'])
            . ' ' . gn_money($gia_tri) . ' · đối tác nhận ' . gn_money($nhan));
    }
}

/**
 * Doanh số hợp lệ trong ngày của một đối tác, tính đến thời điểm gọi.
 * Dùng để lấy phần chênh hoa hồng của riêng giao dịch vừa phát sinh.
 */
function gn_partner_day_revenue($partner_id, $date = null) {
    global $wpdb;
    $date = $date ?: current_time('Y-m-d');
    $r = (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(revenue),0) FROM " . gn_tbl('bookings') . "
         WHERE partner_id=%d AND served_on=%s AND booking_status IN ('served','checked_in','completed')",
        $partner_id, $date));
    $r += (float) $wpdb->get_var($wpdb->prepare(
        "SELECT COALESCE(SUM(CASE WHEN kind IN ('pay','topup') THEN amount ELSE -amount END),0)
         FROM " . gn_tbl('voucher_txn') . "
         WHERE partner_id=%d AND happened_on=%s AND kind IN ('pay','topup','refund')",
        $partner_id, $date));
    return max(0, $r);
}

/** Gói chung: tính phần chênh rồi gửi thư cho đối tác. */
function gn_partner_notice_for($partner_id, $gia_tri, $meta) {
    if (!$partner_id) return;
    $sau    = gn_partner_day_revenue($partner_id);          // đã gồm giao dịch vừa ghi
    $truoc  = max(0, $sau - (float) $gia_tri);
    $chenh  = gn_commission_for_day($sau) - gn_commission_for_day($truoc);
    gn_send_partner_notice($partner_id, array_merge($meta, [
        'gia_tri'       => $gia_tri,
        'doi_tac_nhan'  => max(0, $chenh),
        'ngay_truoc'    => $truoc,
        'ngay_sau'      => $sau,
        'hoa_hong_ngay' => gn_commission_for_day($sau),
    ]));
}

