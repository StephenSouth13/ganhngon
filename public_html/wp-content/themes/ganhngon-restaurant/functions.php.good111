/**
 * Link tel: không nhất quán: nội dung trang dùng tel:0979232233, chân trang dùng
 * tel:+84979232233. Bản không có mã quốc gia hỏng với khách quốc tế — đúng nhóm
 * khách trang đối tác và trang đoàn nhắm tới. Chuẩn hoá hết về +84.
 */
function gn_normalize_tel_links($html) {
    if (!is_string($html) || strpos($html, 'tel:') === false) return $html;
    return preg_replace_callback(
        '/href=(["\'])tel:([^"\']+)\1/i',
        function ($m) {
            $d = preg_replace('/[^\d+]/', '', $m[2]);
            if (str_starts_with($d, '0'))      $d = '+84' . substr($d, 1);
            elseif (str_starts_with($d, '84')) $d = '+' . $d;
            return 'href=' . $m[1] . 'tel:' . $d . $m[1];
        },
        $html
    );
}
add_filter('the_content', 'gn_normalize_tel_links', 98);
add_filter('widget_text', 'gn_normalize_tel_links', 98);
add_filter('render_block', 'gn_normalize_tel_links', 98);

/**
 * <input type="date"> hiển thị theo locale TRÌNH DUYỆT của khách, HTML không ép
 * được. Máy đặt en-US sẽ thấy mm/dd/yyyy trên trang tiếng Việt — đo được trên
 * trang chủ, /dat-ban/ và /khach-doan-tiec-rieng/.
 *
 * Không thay bằng ô chữ tự viết vì sẽ mất bộ chọn ngày gốc của điện thoại, vốn
 * dùng tốt hơn hẳn. Thay vào đó hiện thêm dòng ngày dạng dd/mm/yyyy ngay dưới ô,
 * cập nhật theo lựa chọn, để khách không bao giờ hiểu nhầm tháng với ngày.
 * Đồng thời chặn chọn ngày quá khứ và giới hạn 12 tháng.
 */
function gn_date_input_helper() {
    if (is_admin()) return; ?>
<script>
(function () {
  function vn(d) {
    if (!d) return '';
    var p = d.split('-');
    return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : '';
  }
  function setup(inp) {
    if (inp.dataset.gnDate) return;
    inp.dataset.gnDate = '1';
    // Ghép ngày theo GIỜ ĐỊA PHƯƠNG, KHÔNG dùng toISOString — nó đổi sang UTC
    // nên nửa đêm giờ Việt Nam thành 17h hôm trước, min lùi một ngày, khách đặt
    // được bàn hôm qua. Nhà hàng lại mở tới 2 giờ sáng nên lỗi này rất dễ lọt.
    var iso = function (dt) {
      var m = dt.getMonth() + 1, d = dt.getDate();
      return dt.getFullYear() + '-' + (m < 10 ? '0' + m : m) + '-' + (d < 10 ? '0' + d : d);
    };
    var today = new Date();
    if (!inp.min) inp.min = iso(today);
    if (!inp.max) { var mx = new Date(today); mx.setFullYear(mx.getFullYear() + 1); inp.max = iso(mx); }

    var hint = document.createElement('small');
    hint.className = 'gn-date-hint';
    hint.style.cssText = 'display:block;margin-top:4px;font:500 12px/1.5 inherit;color:#6E5D4E';
    inp.insertAdjacentElement('afterend', hint);

    var show = function () {
      hint.textContent = inp.value
        ? 'Đã chọn: ' + vn(inp.value) + ' (ngày/tháng/năm)'
        : 'Định dạng ngày/tháng/năm';
      hint.style.color = inp.value ? '#1E7A4C' : '#6E5D4E';
    };
    inp.addEventListener('change', show);
    inp.addEventListener('input', show);
    show();
  }
  function scan() { document.querySelectorAll('input[type=date]').forEach(setup); }

  // ── Nút hamburger cho menu mobile ──
  // Theme ẩn .gn-nav ở <=860px mà không có nút thay thế. Bơm một nút ba gạch vào
  // header, bấm là bật/tắt class trên body để CSS xổ menu xuống.
  function nav() {
    var header = document.querySelector('.gn-header, header.gn-header') || document.querySelector('.gn-nav') && document.querySelector('.gn-nav').parentElement;
    var navEl = document.querySelector('.gn-nav');
    if (!navEl || document.querySelector('.gn-nav-toggle')) return;
    var host = navEl.parentElement || header;
    if (!host) return;
    var btn = document.createElement('button');
    btn.className = 'gn-nav-toggle';
    btn.setAttribute('aria-label', 'Mở menu');
    btn.setAttribute('aria-expanded', 'false');
    btn.innerHTML = '<span></span>';
    btn.addEventListener('click', function () {
      var open = document.body.classList.toggle('gn-nav-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
    });
    host.appendChild(btn);
    // bấm một mục là đóng lại
    navEl.addEventListener('click', function (e) {
      if (e.target.closest('a')) document.body.classList.remove('gn-nav-open');
    });
  }

  // ── Chặn submit form đặt bàn ──
  // Form /dat-ban/ và /doi-tac/ POST thẳng tới admin-ajax, bấm gửi là khách rơi
  // vào trang trắng in JSON trần. Chặn submit, fetch, hiện kết quả ngay trên trang.
  function bindForms() {
    var forms = document.querySelectorAll('form[action*="admin-ajax.php"]');
    forms.forEach(function (f) {
      if (f.dataset.gnAjax) return;
      f.dataset.gnAjax = '1';
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = f.querySelector('[type=submit], button:not([type])');
        var oldTxt = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Đang gửi…'; }
        var box = f.querySelector('.gn-form-result');
        if (!box) {
          box = document.createElement('div');
          box.className = 'gn-form-result';
          box.style.cssText = 'margin-top:14px;padding:14px 16px;border-radius:12px;font:500 15px/1.5 inherit;display:none';
          f.appendChild(box);
        }
        fetch(f.action, { method: 'POST', credentials: 'include', body: new FormData(f) })
          .then(function (r) { return r.json().catch(function () { return { success: true }; }); })
          .then(function (j) {
            box.style.display = 'block';
            var ok = j && (j.success === true || (j.data && !j.data.message) || false);
            if (ok || (j && j.success)) {
              box.style.background = '#E4F2EA'; box.style.color = '#1E7A4C';
              box.textContent = (j.data && j.data.message) || 'Đã nhận yêu cầu. Nhân viên Gánh Ngon sẽ liên hệ xác nhận trong ít phút.';
              f.reset();
            } else {
              box.style.background = '#FBE9E7'; box.style.color = '#B42318';
              box.textContent = (j && j.data && j.data.message) || 'Có lỗi, vui lòng gọi 0979 232 233 giúp.';
            }
            if (btn) { btn.disabled = false; btn.textContent = oldTxt; }
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
          })
          .catch(function () {
            box.style.display = 'block'; box.style.background = '#FBE9E7'; box.style.color = '#B42318';
            box.textContent = 'Mạng trục trặc, thử lại hoặc gọi 0979 232 233.';
            if (btn) { btn.disabled = false; btn.textContent = oldTxt; }
          });
      });
    });
  }

  function all() { scan(); nav(); bindForms(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all);
  else all();
  new MutationObserver(all).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<?php }
add_action('wp_footer', 'gn_date_input_helper', 30);

/* GN — SỬA NỐT LỖI END */

/* ===== KẾT NỐI WCC — MCP SERVER (nối vào functions.php) ===== */

/**
 * Token MCP đang dùng. Ưu tiên hằng số trong wp-config.php (không đi vào database,
 * an toàn nhất); nếu không có thì lấy token do nút "Bật kết nối" sinh ra và lưu
 * trong option. Nhờ vậy chủ nhà hàng chỉ cần bấm một nút, không phải sửa file.
 */
function gn_wcc_token() {
    if (defined('GN_MCP_TOKEN') && GN_MCP_TOKEN !== '') return (string) GN_MCP_TOKEN;
    return (string) get_option('gn_wcc_token', '');
}

const GN_MCP_NS       = 'gn-mcp/v1';
const GN_MCP_PROTO    = '2024-11-05';
const GN_MCP_TZ       = 'Asia/Ho_Chi_Minh';
const GN_MCP_IDEM_TTL = 7 * DAY_IN_SECONDS;

/* ═══════════════════════════════════════════════════════════════════════════
   TIỆN ÍCH
   ═══════════════════════════════════════════════════════════════════════════ */

/** Ngày hôm nay theo giờ Việt Nam, không phụ thuộc múi giờ máy chủ. */
function gn_mcp_today() {
    return (new DateTime('now', new DateTimeZone(GN_MCP_TZ)))->format('Y-m-d');
}

/** Ép về số nguyên đồng. Mọi số tiền ra khỏi tệp này đều đi qua đây. */
function gn_mcp_vnd($n) { return (int) round((float) $n); }

/** Chuẩn hoá ngày người gọi đưa vào; rỗng thì lấy hôm nay. */
function gn_mcp_ngay($s, $mac_dinh = null) {
    $s = trim((string) $s);
    if ($s === '') { return $mac_dinh ?: gn_mcp_today(); }
    $d = DateTime::createFromFormat('Y-m-d', $s, new DateTimeZone(GN_MCP_TZ));
    return ($d && $d->format('Y-m-d') === $s) ? $s : ($mac_dinh ?: gn_mcp_today());
}

function gn_mcp_tbl($ten) {
    if (function_exists('gn_tbl')) { return gn_tbl($ten); }
    global $wpdb;
    return $wpdb->prefix . 'sao_' . $ten;   // dự phòng khi theme chưa nạp
}

/** Theme đã nạp đủ hàm nghiệp vụ chưa. */
function gn_mcp_san_sang() {
    return function_exists('gn_commission_for_day')
        && function_exists('gn_partner_period')
        && function_exists('gn_tbl');
}

/**
 * Chống gọi trùng. Khách bấm hai lần, mạng chập chờn, WCC gửi lại — đều tạo bản
 * ghi trùng nếu không chặn. Lưu kết quả theo khoá, gọi lại trả nguyên kết quả cũ.
 */
function gn_mcp_idem_doc($key) {
    if ($key === '') { return null; }
    $v = get_transient('gn_mcp_idem_' . md5($key));
    return is_array($v) ? $v : null;
}
function gn_mcp_idem_ghi($key, $ket_qua) {
    if ($key === '') { return $ket_qua; }
    set_transient('gn_mcp_idem_' . md5($key), $ket_qua, GN_MCP_IDEM_TTL);
    return $ket_qua;
}

/* ═══════════════════════════════════════════════════════════════════════════
   ĐỊNH NGHĨA TOOL
   Ba nhóm theo mức rủi ro. Người vận hành WCC gán risk_level khi dò lần đầu:
     đọc     -> risk 0, AI gọi thẳng
     ghi nhẹ -> risk 1, nhắc rồi chạy
     tiền    -> để NULL hoặc L3, BẮT BUỘC người duyệt
   ═══════════════════════════════════════════════════════════════════════════ */

