}, 20);

/* GN — MÀN QUẢN TRỊ END */

/* ==========================================================================
   GN — VIETQR + TRANG TRA CỨU VOUCHER ĐẦY ĐỦ
   --------------------------------------------------------------------------
   Vì sao QR không nhét dữ liệu vào trong: số dư đổi mỗi lần nạp thêm và mỗi lần
   quét trừ. Nhét vào mã là đóng băng số liệu tại lúc in, hôm sau đã sai. QR trỏ
   tới trang tra cứu, quét ra thấy số HIỆN TẠI, và mã in một lần dùng mãi.
   ========================================================================== */

define('GN_BANK_BIN',   '970425');            // ABBANK — Ngân hàng TMCP An Bình
define('GN_BANK_NAME',  'ABBANK');
define('GN_BANK_ACC',   '2020333333');
define('GN_BANK_OWNER', 'NHA HANG GANH NGON');

/** Ảnh VietQR quét bằng app ngân hàng là ra sẵn số tiền và nội dung. */
function gn_vietqr_url($amount, $content, $template = 'compact2') {
    return 'https://img.vietqr.io/image/' . GN_BANK_BIN . '-' . GN_BANK_ACC . '-' . $template . '.png'
         . '?amount=' . (int) $amount
         . '&addInfo=' . rawurlencode($content)
         . '&accountName=' . rawurlencode(GN_BANK_OWNER);
}

/** Che bớt số điện thoại cho người lạ cầm mã: 0912345678 -> 0912***678 */
function gn_mask_phone($p) {
    $p = preg_replace('/\s+/', '', (string) $p);
    if (strlen($p) < 7) return $p;
    return substr($p, 0, 4) . str_repeat('*', max(0, strlen($p) - 7)) . substr($p, -3);
}
function gn_mask_email($e) {
    if (!$e || strpos($e, '@') === false) return $e;
    [$a, $b] = explode('@', $e, 2);
    return substr($a, 0, 2) . str_repeat('*', max(1, strlen($a) - 2)) . '@' . $b;
}

function gn_voucher_status_label($s) {
    return [
        'unpaid'   => ['CHƯA THANH TOÁN', 'is-warn'],
        'paid'     => ['CÒN HIỆU LỰC',    'is-ok'],
        'used'     => ['ĐÃ DÙNG HẾT',     'is-off'],
        'expired'  => ['HẾT HẠN',         'is-err'],
        'refunded' => ['ĐÃ HOÀN TIỀN',    'is-err'],
    ][$s] ?? [strtoupper($s), 'is-off'];
}

/**
 * Trang tra cứu voucher — quét mã QR là ra đây.
 * Khách thấy đủ thông tin của chính mình, số điện thoại và email che bớt.
 * Nhân viên đăng nhập thấy thêm thông tin đầy đủ và nút thao tác.
 */
function gn_voucher_view_html($v) {
    global $wpdb;
    $staff  = current_user_can(GN_CAP);
    $unpaid = ($v->status === 'unpaid');
    [$lbl, $cls] = gn_voucher_status_label($v->status);

    $partner = $v->partner_id
        ? $wpdb->get_row($wpdb->prepare("SELECT ref_code, contact, company, type FROM " . gn_tbl('partners') . " WHERE id=%d", $v->partner_id))
        : null;
    $txn = $wpdb->get_results($wpdb->prepare(
        "SELECT * FROM " . gn_tbl('voucher_txn') . " WHERE voucher_id=%d ORDER BY id ASC", $v->id));

    $topup_total = 0; $used_total = 0;
    foreach ($txn as $t) {
        if ($t->kind === 'topup')  $topup_total += (float) $t->amount;
