// Floating chat launcher — AI concierge + multi-channel
// ============================================================
function gn_chat_widget() {
    if (is_admin()) return;
    $zalo = 'https://zalo.me/' . esc_attr(gn_zalo_raw());
    $wa   = 'https://wa.me/' . esc_attr(gn_whatsapp_raw());
    $mes  = esc_url(gn_facebook());
    $tg   = esc_url(gn_telegram());
    $tel  = 'tel:' . esc_attr(gn_phone_raw());
    $ajax = esc_url(admin_url('admin-ajax.php'));
    $nonce = wp_create_nonce('gn_ai');
    ?>
    <button class="gn-chat-fab" id="gnChatFab" aria-label="Chat với Gánh Ngon" aria-expanded="false" onclick="gnChatToggle()">
      <span class="gn-chat-badge"></span>
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.4 1.3 4.5 3.4 6-.1 1-.6 2.4-1.2 3.4-.2.3.1.7.5.6 1.9-.5 3.5-1.3 4.5-2 .9.2 1.8.3 2.8.3 5.5 0 10-3.6 10-8.3S17.5 3 12 3zm-4 9a1.2 1.2 0 1 1 0-2.4A1.2 1.2 0 0 1 8 12zm4 0a1.2 1.2 0 1 1 0-2.4A1.2 1.2 0 0 1 12 12zm4 0a1.2 1.2 0 1 1 0-2.4A1.2 1.2 0 0 1 16 12z"/></svg>
    </button>
    <div class="gn-chat-panel" id="gnChatPanel" role="dialog" aria-label="Chat">
      <div class="gn-chat-head">
        <strong><?php echo esc_html(gn_t('adv_title')); ?></strong>
        <span><?php echo esc_html(gn_t('hours_clock')); ?> · <?php echo esc_html(gn_phone_display()); ?></span>
      </div>
      <div class="gn-chat-log" id="gnChatLog">
        <div class="gn-msg gn-msg-bot"><?php echo esc_html(gn_advisor_reply('xin chao', gn_cur_lang())); ?></div>
      </div>
      <form class="gn-chat-input" id="gnChatForm" onsubmit="return gnAiSend(event)">
        <input type="text" id="gnChatText" autocomplete="off" placeholder="Nhập câu hỏi của anh/chị…" aria-label="Nhập tin nhắn">
        <button type="submit" aria-label="Gửi"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.4 20.4 21 12 3.4 3.6 3 10l12 2-12 2z"/></svg></button>
      </form>
      <div class="gn-chat-channels">
        <span class="gn-chat-ch-label">Hoặc chat qua:</span>
        <a href="<?php echo $zalo; ?>" target="_blank" rel="noopener" title="Zalo" style="background:#0068FF"><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.5 2 2 5.9 2 10.7c0 2.7 1.5 5.2 3.7 6.8-.1 1-.5 2.3-1 3.1-.1.2 0 .5.3.4 1.8-.4 3.2-1.1 4.1-1.7.9.2 1.9.3 2.9.3 5.5 0 10-3.9 10-8.7S17.5 2 12 2z"/></svg></a>
        <a href="<?php echo $wa; ?>" target="_blank" rel="noopener" title="WhatsApp" style="background:#25D366"><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-2.8.9.9-2.7-.2-.3A8 8 0 0 1 12 4z"/></svg></a>
        <a href="<?php echo $mes; ?>" target="_blank" rel="noopener" title="Messenger" style="background:#0084FF"><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.3 2 2 6.2 2 11.6c0 2.9 1.3 5.4 3.4 7.1V22l3.1-1.7c.8.2 1.6.3 2.5.3 5.7 0 10-4.2 10-9.6S17.7 2 12 2zm1 12.4-2.6-2.7-4.9 2.7 5.4-5.7 2.6 2.7 4.8-2.7-5.3 5.7z"/></svg></a>
        <a href="<?php echo $tg; ?>" target="_blank" rel="noopener" title="Telegram" style="background:#0088CC"><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.9 6.9-1.6 7.7c-.1.5-.4.7-.9.4l-2.5-1.8-1.2 1.2c-.1.1-.3.2-.5.2l.2-2.5 4.6-4.2c.2-.2 0-.3-.3-.1L9 13.2l-2.5-.8c-.5-.2-.5-.5.1-.8l9.6-3.7c.4-.2.8.1.7.8z"/></svg></a>
        <a href="<?php echo $tel; ?>" title="Gọi điện" style="background:#2C1810"><svg viewBox="0 0 24 24" fill="#fff"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.25 1l-2.2 2.3z"/></svg></a>
      </div>
    </div>
    <script>
    (function(){
      window.gnAiCfg = {url:"<?php echo $ajax; ?>", nonce:"<?php echo $nonce; ?>", lang:"<?php echo esc_js(gn_cur_lang()); ?>", hist:[]};
    })();
    function gnChatToggle(){var p=document.getElementById('gnChatPanel');var f=document.getElementById('gnChatFab');var o=p.classList.toggle('open');f.setAttribute('aria-expanded',o);if(o){setTimeout(function(){var t=document.getElementById('gnChatText');if(t)t.focus();},120);}}
    document.addEventListener('click',function(e){if(!e.target.closest('#gnChatPanel')&&!e.target.closest('#gnChatFab')){var p=document.getElementById('gnChatPanel');if(p)p.classList.remove('open');}});
    function gnAddMsg(text,who){var log=document.getElementById('gnChatLog');var d=document.createElement('div');d.className='gn-msg gn-msg-'+who;d.textContent=text;log.appendChild(d);log.scrollTop=log.scrollHeight;return d;}
    function gnAiSend(e){
      e.preventDefault();
      var inp=document.getElementById('gnChatText');var msg=(inp.value||'').trim();if(!msg)return false;
      gnAddMsg(msg,'user');gnAiCfg.hist.push({role:'user',content:msg});inp.value='';
      var typing=gnAddMsg('Đang soạn…','bot');typing.classList.add('gn-typing');
      var fd=new FormData();fd.append('action','gn_ai_chat');fd.append('nonce',gnAiCfg.nonce);fd.append('lang',gnAiCfg.lang||'vi');fd.append('message',msg);fd.append('history',JSON.stringify(gnAiCfg.hist.slice(-8)));
      fetch(gnAiCfg.url,{method:'POST',body:fd,credentials:'same-origin'})
        .then(function(r){return r.json();})
        .then(function(j){typing.remove();var rep=(j&&j.data&&j.data.reply)?j.data.reply:'Xin lỗi, em chưa trả lời được. Anh/chị chat Zalo/WhatsApp giúp em nhé.';gnAddMsg(rep,'bot');gnAiCfg.hist.push({role:'assistant',content:rep});})
        .catch(function(){typing.remove();gnAddMsg('Kết nối gián đoạn. Anh/chị vui lòng chat Zalo/WhatsApp 0979 232 233 ạ.','bot');});
      return false;
    }
    </script>
    <?php
}
add_action('wp_footer', 'gn_chat_widget', 6);

