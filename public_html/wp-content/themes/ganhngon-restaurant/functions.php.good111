// ============================================================
// AI Chatbot backend — Ollama (MiniMax M3) primary, DeepSeek fallback
// Config stored in wp_options: gn_ai_ollama_url / gn_ai_ollama_model
//   / gn_ai_deepseek_key / gn_ai_deepseek_model
// ============================================================
function gn_ai_system_prompt() {
    return "Bạn là trợ lý ảo của nhà hàng GÁNH NGON — nhà hàng đặc sản Việt Nam tại 113 Trần Hưng Đạo, Dương Đông, Phú Quốc, Kiên Giang. "
      . "Nhiệm vụ: tư vấn món ăn đặc sản, không gian (bàn thường, phòng VIP, khu gia đình, khu đoàn, tiệc riêng), hỗ trợ đặt bàn, giải đáp giờ mở cửa & dịch vụ. "
      . "QUY TẮC BẮT BUỘC: TUYỆT ĐỐI KHÔNG báo giá món/set menu/phí phòng VIP. Nếu khách hỏi giá, lịch sự mời khách để lại SĐT/Zalo hoặc đặt bàn để tư vấn viên báo giá riêng. "
      . "Hướng khách đặt bàn tại trang /dat-ban/, hoặc Zalo/WhatsApp 0979 232 233, hotline 0979 232 233. "
      . "THÔNG TIN THẬT (chỉ dùng các dữ kiện này, KHÔNG bịa thêm): Giờ mở cửa 6h30 sáng đến 2h sáng hôm sau, tất cả các ngày trong tuần. Có chỗ đậu xe. "
      . "Nếu khách hỏi thông tin chưa được cung cấp (sức chứa cụ thể, món/giá, sự kiện...), KHÔNG tự bịa — lịch sự mời khách liên hệ Zalo/hotline để được tư vấn chính xác. "
      . "Trả lời NGẮN GỌN, thân thiện, đúng ngôn ngữ khách đang dùng (Việt/Anh/Trung/Hàn/Nga/Ả Rập). Nếu không chắc, mời khách liên hệ trực tiếp.";
}
function gn_ai_call_ollama($messages) {
    $url   = trim(get_option('gn_ai_ollama_url', ''));
    $model = trim(get_option('gn_ai_ollama_model', '')) ?: 'minimax-m3';
    if ($url === '') return null;
    $res = wp_remote_post(rtrim($url, '/') . '/api/chat', [
        'timeout' => 25,
        'headers' => ['Content-Type' => 'application/json'],
        'body'    => wp_json_encode(['model' => $model, 'messages' => $messages, 'stream' => false]),
    ]);
    if (is_wp_error($res) || wp_remote_retrieve_response_code($res) !== 200) return null;
    $j = json_decode(wp_remote_retrieve_body($res), true);
    $txt = $j['message']['content'] ?? '';
    return ($txt !== '') ? $txt : null;
}
function gn_ai_call_deepseek($messages) {
    $key   = trim(get_option('gn_ai_deepseek_key', ''));
    $model = trim(get_option('gn_ai_deepseek_model', '')) ?: 'deepseek-chat';
    if ($key === '') return null;
    $res = wp_remote_post('https://api.deepseek.com/chat/completions', [
        'timeout' => 30,
        'headers' => ['Content-Type' => 'application/json', 'Authorization' => 'Bearer ' . $key],
        'body'    => wp_json_encode(['model' => $model, 'messages' => $messages, 'stream' => false, 'temperature' => 0.6]),
    ]);
    if (is_wp_error($res) || wp_remote_retrieve_response_code($res) !== 200) return null;
    $j = json_decode(wp_remote_retrieve_body($res), true);
    return $j['choices'][0]['message']['content'] ?? null;
}
function gn_ai_chat_handler() {
    check_ajax_referer('gn_ai', 'nonce');
    $msg = isset($_POST['message']) ? sanitize_textarea_field(wp_unslash($_POST['message'])) : '';
    if ($msg === '') wp_send_json_error(['reply' => 'Anh/chị vui lòng nhập câu hỏi.']);

    $rk  = 'gn_ai_rl_' . md5($_SERVER['REMOTE_ADDR'] ?? 'x');
    $cnt = (int) get_transient($rk);
    if ($cnt > 30) {
        wp_send_json_success(['reply' => gn_advisor_reply('phone zalo whatsapp', gn_cur_lang()), 'source' => 'rl']);
    }
    set_transient($rk, $cnt + 1, 300);

    $lang = isset($_POST['lang']) ? sanitize_key(wp_unslash($_POST['lang'])) : gn_cur_lang();
    wp_send_json_success(['reply' => gn_advisor_reply($msg, $lang), 'source' => 'advisor']);
}
add_action('wp_ajax_gn_ai_chat', 'gn_ai_chat_handler');
add_action('wp_ajax_nopriv_gn_ai_chat', 'gn_ai_chat_handler');

