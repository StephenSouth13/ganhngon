// Redirects
add_action('template_redirect', function() {
    $req = trim($_SERVER['REQUEST_URI'] ?? '', '/');
    if ($req === 'phong-vip') { wp_redirect(home_url('/khach-doan-tiec-rieng/#phong-vip'), 301); exit; }
    if ($req === 'partner')   { wp_redirect(home_url('/doi-tac/'), 301); exit; }
});

// === Hotline fix (2026-06-20): vá số placeholder hardcode trong post_content (DB) → hotline thật, không cần migrate DB ===
function gn_fix_legacy_phone($html) {
    if (strpos($html, '842971234567') !== false || strpos($html, '297 123 4567') !== false) {
        $html = strtr($html, array(
            '842971234567'     => '84979232233',
            '+84 297 123 4567' => '0979 232 233',
            '0297 123 4567'    => '0979 232 233',
        ));
    }
    // VNPay đang ở chế độ sandbox (chưa thanh toán thật) → bỏ lời hứa "qua VNPay" để không sai với khách
    if (stripos($html, 'qua VNPay') !== false) {
        $html = str_ireplace(' qua VNPay', '', $html);
    }
    return $html;
}
add_filter('the_content', 'gn_fix_legacy_phone', 99);
add_filter('widget_text', 'gn_fix_legacy_phone', 99);
add_filter('render_block', 'gn_fix_legacy_phone', 99);

/* ==========================================================================
   GANH NGON REDESIGN 2026 — BEGIN
   Ba việc sửa ở tầng theme, không đụng nội dung lưu trong database:
     1. Bỏ nhãn quy trình nội bộ trên trang Đặt bàn
     2. Hạ <h1> trong nội dung xuống <h2> — page.php đã in <h1> tiêu đề rồi
     3. Meta description dự phòng cho trang chưa đặt
   HOÀN TÁC: xoá khối giữa BEGIN và END, hoặc tải lại
   ganhngon/backup-theme-2026-08-08/functions.php
   ========================================================================== */

/**
 * Trang /dat-ban/ đang phơi quy trình nội bộ ra cho khách: "Form đặt bàn — 9 bước",
 * "Bước 1–3:", và cả khối "Trạng thái đặt bàn (11 trạng thái)". Khách chỉ cần
 * điền form, không cần biết pipeline vận hành của nhà hàng.
 */
function gn_strip_internal_steps($content) {
    if (is_admin() || !in_the_loop() || !is_main_query()) return $content;

    // "Form đặt bàn — 9 bước" -> "Form đặt bàn"
    $content = preg_replace('/(Form đặt bàn)\s*[—–-]\s*\d+\s*bước/u', '$1', $content);

    // "Bước 1–3: Ngày, giờ..." -> "Ngày, giờ..."  (áp cho cả nhãn lẫn nút submit)
    $content = preg_replace('/Bước\s*\d+(?:\s*[–—-]\s*\d+)?\s*:\s*/u', '', $content);

    // Bỏ trọn khối "Trạng thái đặt bàn (N trạng thái)" và đoạn liệt kê ngay sau nó
    $content = preg_replace('/<h3[^>]*>\s*Trạng thái đặt bàn.*?<\/h3>\s*<p[^>]*>.*?<\/p>/us', '', $content);

    return $content;
}
add_filter('the_content', 'gn_strip_internal_steps', 20);

/**
 * page.php và single.php đã in <h1> tiêu đề. Nội dung trang lưu trong database
 * in thêm <h1> nữa -> hai thẻ h1 trên cùng một trang, sai cấu trúc heading.
 */
function gn_demote_content_h1($content) {
    if (is_admin() || !in_the_loop() || !is_main_query()) return $content;
    if (function_exists('gn_is_advisor_page') && gn_is_advisor_page()) return $content;
    $content = preg_replace('/<h1(\s[^>]*)?>/i', '<h2$1>', $content);
    $content = preg_replace('/<\/h1>/i', '</h2>', $content);
    return $content;
}
add_filter('the_content', 'gn_demote_content_h1', 21);

/**
 * Meta description dự phòng. Nếu Yoast hoặc Rank Math đang chạy thì đưa qua
 * filter của plugin để không in trùng thẻ; không có plugin thì tự in ở wp_head.
 */
function gn_fallback_metadesc_text() {
    if (is_front_page()) {
        return 'Lẩu gà sầu riêng — món đặc trưng của Gánh Ngon, 113 Trần Hưng Đạo, Dương Đông, Phú Quốc. Bàn thường nhận trong ngày, mở cửa 6:30–2:00. Zalo 0979 232 233. Giá báo tại nhà hàng.';
    }
    if (!is_singular()) return '';
    $post = get_queried_object();
    if (!$post || empty($post->post_content)) return '';
    $txt = wp_strip_all_tags(strip_shortcodes($post->post_content));
    $txt = trim(preg_replace('/\s+/u', ' ', $txt));
    if ($txt === '') return '';
    if (function_exists('mb_strlen') && mb_strlen($txt, 'UTF-8') > 155) {
        $txt = mb_substr($txt, 0, 152, 'UTF-8');
        $cut = mb_strrpos($txt, ' ', 0, 'UTF-8');
        if ($cut !== false && $cut > 90) $txt = mb_substr($txt, 0, $cut, 'UTF-8');
        $txt .= '…';
    }
    return $txt;
}

add_filter('wpseo_metadesc', 'gn_fallback_metadesc_filter', 20);
function gn_fallback_metadesc_filter($desc) {
    return ($desc === '' || $desc === null) ? gn_fallback_metadesc_text() : $desc;
}

function gn_print_fallback_metadesc() {
    if (defined('WPSEO_VERSION')) return;                    // Yoast lo phần này
    if (defined('RANK_MATH_VERSION')) return;                // Rank Math lo phần này
    $d = gn_fallback_metadesc_text();
    if ($d !== '') echo '<meta name="description" content="' . esc_attr($d) . '">' . "\n";
}
add_action('wp_head', 'gn_print_fallback_metadesc', 2);

