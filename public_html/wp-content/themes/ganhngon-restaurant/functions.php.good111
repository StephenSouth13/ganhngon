<?php
if (!defined('ABSPATH')) exit;

require_once get_template_directory() . '/inc/i18n.php';
require_once get_template_directory() . '/inc/ops.php';
require_once get_template_directory() . '/inc/advisor.php';

function gn_theme_setup() {
    add_theme_support('post-thumbnails');
    add_theme_support('title-tag');
    add_theme_support('custom-logo');
    add_theme_support('automatic-feed-links');
    add_theme_support('html5', ['search-form','comment-form','comment-list','gallery','caption']);
    register_nav_menus([
        'primary' => __('Primary Menu', 'ganhngon-restaurant'),
        'footer'  => __('Footer Menu', 'ganhngon-restaurant'),
    ]);
}
add_action('after_setup_theme', 'gn_theme_setup');

function gn_theme_scripts() {
    wp_enqueue_style('gn-fonts', 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Open+Sans:wght@400;500;600;700&display=swap', [], null);
    wp_enqueue_style('gn-style', get_stylesheet_uri(), [], '4.7.0');
    wp_enqueue_script('gn-main', get_template_directory_uri() . '/assets/main.js', [], '4.7.0', true);
}
add_action('wp_enqueue_scripts', 'gn_theme_scripts');

// Render homepage sections on language-root URLs (/en/ /zh/ ...) which Polylang
// shows as blog-home. Forces the translated front-page layout for all languages.
add_action('template_redirect', function () {
    if (is_admin()) return;
    if (gn_cur_lang() === 'vi') return;          // VI uses normal front-page.php
    if (!is_home() && !is_front_page()) return;  // only the language root
    // Avoid intercepting real blog archives (paged, category, etc.)
    if (is_paged() || is_archive() || is_search() || is_singular()) return;

    status_header(200);
    get_header();
    foreach (['hero','menu','location','reservation','about','customer-types','gallery','testimonials','faq'] as $s) {
        get_template_part('template-parts/section-' . $s);
    }
    get_footer();
    exit;
}, 1);

// Force front-page template for translated home-* pages (if accessed directly)
add_filter('template_include', function ($t) {
    if (is_page() && preg_match('/^home-(en|zh|ko|ru|ar)$/', get_post_field('post_name', get_the_ID()))) {
        $fp = locate_template('front-page.php');
        if ($fp) return $fp;
    }
    return $t;
}, 99);

// Disable wpautop on pages whose content is hand-built HTML (grids/forms).
// wpautop injects <br>/<p> that become extra CSS-grid items and break layout.
add_action('wp', function () {
    $raw_html_pages = ['dat-ban', 'khach-doan-tiec-rieng', 'ai-tu-van', 'doi-tac', 'cong-doi-tac'];
    if (is_page($raw_html_pages) || (function_exists('gn_is_advisor_page') && gn_is_advisor_page())) {
        remove_filter('the_content', 'wpautop');
        remove_filter('the_content', 'shortcode_unautop');
    }
});

// Polylang-aware: get translated page URL by Vietnamese slug
function gn_page_url($vi_slug) {
    if ($vi_slug === '') return gn_home('/');
    $lang = gn_cur_lang();
    $vi_post = get_page_by_path($vi_slug);
    if ($vi_post && $lang !== 'vi' && function_exists('pll_get_post')) {
        $tid = pll_get_post($vi_post->ID, $lang);
        if ($tid) return get_permalink($tid);
    }
    if ($vi_post) return get_permalink($vi_post->ID);
    return gn_home('/' . $vi_slug . '/');
}

function gn_default_menu() {
    $items = [
        ''                        => gn_t('nav_home'),
        've-ganh-ngon'            => gn_t('nav_about'),
        'thuc-don'                => gn_t('nav_menu'),
        'dat-ban'                 => gn_t('nav_book'),
        'khach-doan-tiec-rieng'   => gn_t('nav_groups'),
        'lien-he'                 => gn_t('nav_contact'),
    ];
    $current = rtrim($_SERVER['REQUEST_URI'] ?? '/', '/');
    foreach ($items as $slug => $label) {
        $url = gn_page_url($slug);
        $path = rtrim(parse_url($url, PHP_URL_PATH), '/');
        $active = ($current === $path) ? ' active' : '';
        echo '<a class="' . esc_attr(trim($active)) . '" href="' . esc_url($url) . '">' . esc_html($label) . '</a>';
    }
}

// Language switcher — clean dropdown (closed by default, JS toggle)
function gn_lang_switcher() {
    $flags = ['vi'=>'🇻🇳','en'=>'🇬🇧','zh'=>'🇨🇳','ko'=>'🇰🇷','ru'=>'🇷🇺','ar'=>'🇸🇦'];
    $names = ['vi'=>'Tiếng Việt','en'=>'English','zh'=>'中文','ko'=>'한국어','ru'=>'Русский','ar'=>'العربية'];
    $cur = gn_cur_lang();

    // Build language list (Polylang if available, else static)
    $items = [];
    if (function_exists('pll_the_languages')) {
        $langs = pll_the_languages(['raw' => 1, 'hide_if_empty' => 0]);
        foreach ($langs as $l) {
            $items[$l['slug']] = $l['url'];
        }
    }
    if (empty($items)) {
        foreach (['vi'=>'/','en'=>'/en/','zh'=>'/zh/','ko'=>'/ko/','ru'=>'/ru/','ar'=>'/ar/'] as $s=>$u) $items[$s] = home_url($u);
    }

    echo '<div class="gn-lang-switch">';
    echo '<button class="gn-lang-current" type="button" aria-haspopup="true" aria-expanded="false" onclick="gnToggleLang(this)">';
    echo '<span class="flag">' . ($flags[$cur] ?? '🌐') . '</span><span class="code">' . strtoupper($cur) . '</span><span class="caret">▾</span></button>';
    echo '<ul class="gn-lang-dropdown" role="menu">';
    foreach ($items as $slug => $url) {
        $active = ($slug === $cur) ? ' aria-current="true"' : '';
        $cls = ($slug === $cur) ? ' class="active"' : '';
        echo '<li role="none"><a role="menuitem"' . $active . $cls . ' href="' . esc_url($url) . '">';
        echo '<span class="flag">' . ($flags[$slug] ?? '🌐') . '</span> ' . esc_html($names[$slug] ?? strtoupper($slug)) . '</a></li>';
    }
    echo '</ul></div>';
}

