/* GN — VIETQR + TRA CỨU VOUCHER END */

/* ==========================================================================
   GN — PHÁT HÀNH VOUCHER THEO LÔ CHO ĐỐI TÁC (bán sỉ)
   --------------------------------------------------------------------------
   Khác hẳn voucher lẻ khách tự mua qua QR:

     Voucher lẻ         : khách trả từng cái, hoa hồng LUỸ TIẾN theo doanh số ngày.
     Voucher lô (ở đây) : nhà hàng phát cả ngàn cái cho một đối tác, đối tác trả
                          MỘT CỤC, hoa hồng PHẲNG một tỷ lệ (mặc định 10%).

   Ví dụ chủ nhà hàng đưa ra:
     Phát 1000 voucher, mỗi cái 50.000đ  -> tổng mệnh giá 50.000.000đ
     Hoa hồng 10%                        -> 5.000.000đ cho đối tác
     Đối tác trả nhà hàng một cục        -> 50.000.000 - 5.000.000 = 45.000.000đ
     Khách dùng, có ai nạp thêm 8.000.000đ -> hoa hồng thêm 10% = 800.000đ

   Vì hoa hồng lô là PHẲNG, không đi qua công thức luỹ tiến, phải ghi vào một sổ
   riêng (sao_commissions) rồi cộng vào "phải trả" của đối tác. Tách bạch để không
   lẫn hai loại hoa hồng — đối tác nào cũng có thể vừa bán lô vừa dẫn khách lẻ.

   Kế toán:
     Tiền đối tác trả (45tr)     = doanh thu bán voucher sỉ (tiền vào thật).
     Tổng mệnh giá lưu hành (50tr) = NỢ PHẢI TRẢ, nghĩa vụ phục vụ khi khách dùng.
     Chênh 5tr                    = chiết khấu/hoa hồng, chi phí bán hàng.
   ========================================================================== */

if (!defined('ABSPATH')) exit;

define('GN_BATCH_RATE_DEFAULT', 10);   // phần trăm hoa hồng phẳng mặc định

/* ---------- lược đồ ---------- */
function gn_batch_migrate() {
    global $wpdb;
    $charset = $wpdb->get_charset_collate();
    require_once ABSPATH . 'wp-admin/includes/upgrade.php';

    // Lô phát hành
    dbDelta("CREATE TABLE " . gn_tbl('voucher_batches') . " (
        id INT AUTO_INCREMENT PRIMARY KEY,
        batch_code VARCHAR(24) NOT NULL,
        partner_id INT NOT NULL,
        ref_code VARCHAR(50) NULL,
        quantity INT NOT NULL DEFAULT 0,
        face_value DECIMAL(12,2) NOT NULL DEFAULT 0,
        total_face DECIMAL(14,2) NOT NULL DEFAULT 0,
        commission_rate DECIMAL(5,2) NOT NULL DEFAULT 10,
        commission_amount DECIMAL(14,2) NOT NULL DEFAULT 0,
        amount_due DECIMAL(14,2) NOT NULL DEFAULT 0,
        status VARCHAR(20) NOT NULL DEFAULT 'draft',
        expires_on DATE NULL,
        settled_on DATE NULL,
        note VARCHAR(255) NULL,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        UNIQUE KEY batch_code (batch_code),
        KEY partner (partner_id, status)
    ) $charset");

    // Sổ hoa hồng phẳng (lô + nạp thêm vào voucher lô). Tách khỏi luỹ tiến.
    dbDelta("CREATE TABLE " . gn_tbl('commissions') . " (
        id INT AUTO_INCREMENT PRIMARY KEY,
        partner_id INT NOT NULL,
        ref_code VARCHAR(50) NULL,
        kind VARCHAR(20) NOT NULL,
        base_amount DECIMAL(14,2) NOT NULL DEFAULT 0,
        rate DECIMAL(5,2) NOT NULL DEFAULT 0,
        amount DECIMAL(14,2) NOT NULL DEFAULT 0,
        ref_id INT NULL,
        note VARCHAR(255) NULL,
        happened_on DATE NOT NULL,
        paid TINYINT NOT NULL DEFAULT 0,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        KEY partner_month (partner_id, happened_on)
    ) $charset");

    // Voucher cần biết mình thuộc lô nào
    if (!gn_column_exists(gn_tbl('vouchers'), 'batch_id')) {
        $wpdb->query("ALTER TABLE " . gn_tbl('vouchers') . " ADD COLUMN batch_id INT NULL DEFAULT NULL");
        $wpdb->query("ALTER TABLE " . gn_tbl('vouchers') . " ADD INDEX gn_batch (batch_id)");
    }
    update_option('gn_batch_version', '1.0.1');
}
add_action('init', function () {
    if (get_option('gn_batch_version') !== '1.0.1') gn_batch_migrate();
}, 6);

function gn_batch_ghi_hoa_hong($partner_id, $ref_code, $kind, $base, $rate, $ref_id, $note) {
    global $wpdb;
    $amount = round((float) $base * (float) $rate / 100);
    $wpdb->insert(gn_tbl('commissions'), [
        'partner_id'  => (int) $partner_id,
        'ref_code'    => $ref_code,
        'kind'        => $kind,
        'base_amount' => (float) $base,
        'rate'        => (float) $rate,
        'amount'      => $amount,
        'ref_id'      => $ref_id ? (int) $ref_id : null,
        'note'        => $note,
        'happened_on' => current_time('Y-m-d'),
    ]);
    return $amount;
}

/** Tổng hoa hồng phẳng của một đối tác trong một kỳ YYYY-MM. */
function gn_batch_commission_period($partner_id, $ym) {
    global $wpdb;
    $from = $ym . '-01';
    $to   = date('Y-m-t', strtotime($from));
    $rows = $wpdb->get_results($wpdb->prepare(
        "SELECT kind, SUM(amount) amt, COUNT(*) so FROM " . gn_tbl('commissions') . "
         WHERE partner_id = %d AND happened_on BETWEEN %s AND %s
         GROUP BY kind", $partner_id, $from, $to));
    $out = ['tong' => 0, 'lo' => 0, 'topup' => 0, 'chi_tiet' => []];
    foreach ($rows as $r) {
        $out['tong'] += (float) $r->amt;
        if ($r->kind === 'batch') $out['lo'] += (float) $r->amt;
        if ($r->kind === 'batch_topup') $out['topup'] += (float) $r->amt;
        $out['chi_tiet'][$r->kind] = ['tien' => round($r->amt), 'so' => (int) $r->so];
    }
    $out['tong'] = round($out['tong']);
    return $out;
}

/**
 * Phát hành một lô. Sinh N voucher ở trạng thái 'unpaid' cho tới khi đối tác
 * trả tiền một cục; lúc đó cả lô mới thành 'paid' và dùng được.
 */
function gn_batch_issue($partner_id, $quantity, $face_value, $rate, $note = '', $months = 12) {
    global $wpdb;
    $p = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('partners') . " WHERE id = %d", $partner_id));
    if (!$p) return ['loi' => 'Không tìm thấy đối tác'];
    if ($p->status !== 'active') return ['loi' => 'Đối tác chưa được duyệt (đang ' . $p->status . ')'];

    $quantity = max(1, (int) $quantity);
    $face_value = round((float) $face_value);
    $rate = (float) $rate;
    if ($quantity > 5000) return ['loi' => 'Một lô tối đa 5000 voucher, chia nhỏ ra'];
    if ($face_value <= 0) return ['loi' => 'Mệnh giá phải lớn hơn 0'];
    if ($rate < 0 || $rate > 50) return ['loi' => 'Tỷ lệ hoa hồng phải từ 0 đến 50%'];

    $total_face = $face_value * $quantity;
    $commission = round($total_face * $rate / 100);
    $amount_due = $total_face - $commission;
    $code = 'GN-B-' . strtoupper(substr(md5(uniqid('', true)), 0, 8));
    $expires = date('Y-m-d', strtotime("+$months months"));

    $wpdb->insert(gn_tbl('voucher_batches'), [
        'batch_code' => $code, 'partner_id' => $p->id, 'ref_code' => $p->ref_code,
        'quantity' => $quantity, 'face_value' => $face_value, 'total_face' => $total_face,
        'commission_rate' => $rate, 'commission_amount' => $commission, 'amount_due' => $amount_due,
        'status' => 'issued', 'expires_on' => $expires, 'note' => sanitize_text_field($note),
    ]);
    $batch_id = $wpdb->insert_id;
    if (!$batch_id) return ['loi' => 'Không tạo được lô'];

    // Sinh voucher. Chèn theo mẻ để không quá tải một câu lệnh.
    $abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    $vtbl = gn_tbl('vouchers');
    $now = current_time('mysql');
    $made = 0;
    $batch_rows = [];
    for ($i = 0; $i < $quantity; $i++) {
        $s = '';
        for ($j = 0; $j < 8; $j++) $s .= $abc[random_int(0, strlen($abc) - 1)];
        $vc = 'GN-V-' . substr($s, 0, 4) . '-' . substr($s, 4, 4);
        $batch_rows[] = $wpdb->prepare("(%s,%d,%s,%d,%f,%f,%f,%s,%s,%s)",
            $vc, $p->id, $p->ref_code, $batch_id, $face_value, $face_value, 0, 'unpaid', $expires, $now);
        if (count($batch_rows) >= 200) {
            $wpdb->query("INSERT INTO {$vtbl}
                (code,partner_id,ref_code,batch_id,face_value,price,balance,status,expires_on,created_at)
                VALUES " . implode(',', $batch_rows));
            $made += count($batch_rows); $batch_rows = [];
        }
    }
    if ($batch_rows) {
        $wpdb->query("INSERT INTO {$vtbl}
            (code,partner_id,ref_code,batch_id,face_value,price,balance,status,expires_on,created_at)
            VALUES " . implode(',', $batch_rows));
        $made += count($batch_rows);
    }

    return [
        'batch_code' => $code, 'batch_id' => $batch_id, 'da_tao' => $made,
        'tong_menh_gia' => round($total_face), 'hoa_hong' => $commission,
        'doi_tac_phai_tra' => round($amount_due), 'ty_le' => $rate,
    ];
}

/**
 * Đối tác trả tiền một cục. Cả lô chuyển sang dùng được, ghi hoa hồng phẳng vào sổ.
 * Chạy lại lần hai không cộng đôi (kiểm status trước).
 */
function gn_batch_settle($batch_id) {
    global $wpdb;
    $b = $wpdb->get_row($wpdb->prepare("SELECT * FROM " . gn_tbl('voucher_batches') . " WHERE id = %d", $batch_id));
    if (!$b) return ['loi' => 'Không tìm thấy lô'];
    if ($b->status === 'settled') return ['loi' => 'Lô này đã thu tiền rồi'];

    // Voucher trong lô: unpaid -> paid, nạp số dư
    $wpdb->query($wpdb->prepare(
        "UPDATE " . gn_tbl('vouchers') . " SET status = 'paid', balance = face_value, paid_on = %s
         WHERE batch_id = %d AND status = 'unpaid'", current_time('Y-m-d'), $batch_id));

    $wpdb->update(gn_tbl('voucher_batches'),
        ['status' => 'settled', 'settled_on' => current_time('Y-m-d')], ['id' => $batch_id]);

    // Hoa hồng phẳng cho đối tác, ghi trên TỔNG MỆNH GIÁ
    $hh = gn_batch_ghi_hoa_hong($b->partner_id, $b->ref_code, 'batch',
        $b->total_face, $b->commission_rate, $batch_id,
        'Lô ' . $b->batch_code . ' · ' . (int) $b->quantity . ' voucher');

    return [
        'batch_code' => $b->batch_code, 'trang_thai' => 'settled',
        'da_thu_tu_doi_tac' => round($b->amount_due),
        'hoa_hong_ghi_so' => $hh,
        'voucher_dung_duoc' => (int) $b->quantity,
    ];
}

/**
 * Khi nạp thêm vào một voucher THUỘC LÔ, đối tác của lô ăn hoa hồng phẳng trên
 * tiền nạp. Móc vào hook gn_voucher_topped_up nếu theme bắn ra; nếu không thì
 * gọi trực tiếp từ chỗ nạp thêm.
 */
function gn_batch_on_topup($voucher_id, $add_amount) {
    global $wpdb;
    $v = $wpdb->get_row($wpdb->prepare(
        "SELECT batch_id, partner_id, ref_code FROM " . gn_tbl('vouchers') . " WHERE id = %d", $voucher_id));
    if (!$v || !$v->batch_id || !$v->partner_id) return;   // chỉ voucher thuộc lô
    $b = $wpdb->get_row($wpdb->prepare(
        "SELECT commission_rate, batch_code FROM " . gn_tbl('voucher_batches') . " WHERE id = %d", $v->batch_id));
    if (!$b) return;
    gn_batch_ghi_hoa_hong($v->partner_id, $v->ref_code, 'batch_topup',
        $add_amount, $b->commission_rate, $v->batch_id,
        'Nạp thêm vào voucher lô ' . $b->batch_code);
}
add_action('gn_voucher_topped_up', 'gn_batch_on_topup', 10, 2);

/* ==========================================================================
   MÀN QUẢN TRỊ — wp-admin → Gánh Ngon → Voucher lô
   ========================================================================== */

add_action('admin_menu', function () {
    add_submenu_page('gn-home', 'Voucher lô cho đối tác', 'Voucher lô', GN_CAP,
        'gn-batch', 'gn_batch_admin');
}, 15);

function gn_batch_admin() {
    if (!current_user_can(GN_CAP)) wp_die('Không có quyền');
    global $wpdb; gn_admin_css();
    $BT = gn_tbl('voucher_batches');

    if (isset($_POST['gn_phat_lo']) && check_admin_referer('gn_batch_new')) {
        $r = gn_batch_issue(
            (int) $_POST['partner_id'], (int) $_POST['quantity'],
            (float) $_POST['face_value'], (float) $_POST['rate'],
            sanitize_text_field($_POST['note'] ?? ''));
        if (isset($r['loi'])) {
            echo '<div class="notice notice-error"><p>' . esc_html($r['loi']) . '</p></div>';
        } else {
            echo '<div class="notice notice-success"><p>Đã phát lô <b>' . esc_html($r['batch_code']) . '</b>: '
               . number_format($r['da_tao']) . ' voucher · tổng mệnh giá ' . gn_money($r['tong_menh_gia'])
               . ' · hoa hồng ' . gn_money($r['hoa_hong']) . ' · đối tác phải trả <b>'
               . gn_money($r['doi_tac_phai_tra']) . '</b>. Lô đang chờ đối tác thanh toán một cục.</p></div>';
        }
    }
    if (isset($_POST['gn_thu_lo']) && check_admin_referer('gn_batch_settle')) {
        $r = gn_batch_settle((int) $_POST['batch_id']);
        echo isset($r['loi'])
            ? '<div class="notice notice-error"><p>' . esc_html($r['loi']) . '</p></div>'
            : '<div class="notice notice-success"><p>Đã thu ' . gn_money($r['da_thu_tu_doi_tac'])
              . ' cho lô <b>' . esc_html($r['batch_code']) . '</b>. ' . number_format($r['voucher_dung_duoc'])
              . ' voucher có hiệu lực. Ghi hoa hồng ' . gn_money($r['hoa_hong_ghi_so']) . ' vào sổ.</p></div>';
    }

    $partners = $wpdb->get_results("SELECT id, ref_code, contact, company FROM " . gn_tbl('partners') . " WHERE status = 'active' ORDER BY ref_code");
    $batches = $wpdb->get_results("SELECT b.*, p.contact, p.company FROM {$BT} b
        LEFT JOIN " . gn_tbl('partners') . " p ON p.id = b.partner_id ORDER BY b.id DESC LIMIT 50");
    ?>
    <div class="wrap gnw">
      <h1>Voucher lô cho đối tác</h1>
      <p class="sub">Bán sỉ cho đối tác: phát cả lô, đối tác trả một cục, hoa hồng phẳng.
        Khác với voucher lẻ khách tự mua qua QR (hoa hồng luỹ tiến theo ngày).</p>

      <?php if (!$partners): ?>
        <div class="notice notice-warning"><p>Chưa có đối tác nào ở trạng thái <b>active</b>.
          Vào <a href="?page=gn-partners">Đối tác</a> thêm và duyệt trước.</p></div>
      <?php else: ?>
      <div class="card">
        <h2>Phát lô mới</h2>
        <form method="post"><?php wp_nonce_field('gn_batch_new'); ?>
          <div class="grid3">
            <div><label>Đối tác *</label>
              <select name="partner_id" required style="width:100%">
                <?php foreach ($partners as $p): ?>
                  <option value="<?php echo (int) $p->id; ?>"><?php echo esc_html($p->ref_code . ' · ' . ($p->contact ?: $p->company)); ?></option>
                <?php endforeach; ?>
              </select></div>
            <div><label>Số lượng voucher *</label>
              <input type="number" name="quantity" min="1" max="5000" value="1000" required style="width:100%" id="gnb_qty"></div>
            <div><label>Mệnh giá mỗi voucher (đồng) *</label>
              <input type="number" name="face_value" min="1000" step="1000" value="50000" required style="width:100%" id="gnb_face"></div>
            <div><label>Hoa hồng (%) *</label>
              <input type="number" name="rate" min="0" max="50" step="0.5" value="10" required style="width:100%" id="gnb_rate"></div>
            <div style="grid-column:span 2"><label>Ghi chú</label>
              <input name="note" placeholder="Ví dụ: lô Tết 2027, in kèm bao lì xì" style="width:100%"></div>
          </div>
          <div class="note" id="gnb_preview" style="margin:14px 0">Nhập số liệu để xem trước.</div>
          <p><button class="button button-primary" name="gn_phat_lo" value="1">Phát lô</button></p>
        </form>
      </div>
      <script>
      (function(){
        var q=document.getElementById('gnb_qty'),f=document.getElementById('gnb_face'),
            r=document.getElementById('gnb_rate'),out=document.getElementById('gnb_preview');
        function vnd(n){return new Intl.NumberFormat('vi-VN').format(Math.round(n))+'đ';}
        function up(){
          var total=(+q.value||0)*(+f.value||0), hh=total*(+r.value||0)/100;
          out.innerHTML='<b>'+new Intl.NumberFormat('vi-VN').format(+q.value||0)+'</b> voucher × '+vnd(+f.value||0)
            +' = tổng mệnh giá <b>'+vnd(total)+'</b><br>Hoa hồng '+(+r.value||0)+'% = <b>'+vnd(hh)
            +'</b> · Đối tác trả một cục <b style="color:#7A5A12">'+vnd(total-hh)+'</b>';
        }
        [q,f,r].forEach(function(el){el.addEventListener('input',up);}); up();
      })();
      </script>
      <?php endif; ?>

      <div class="card">
        <h2>Các lô đã phát</h2>
        <div class="gnp-tablewrap" style="overflow-x:auto">
        <table class="wp-list-table widefat striped">
          <thead><tr><th>Mã lô</th><th>Đối tác</th><th>SL</th><th>Mệnh giá</th><th>Tổng</th>
            <th>HH %</th><th>Hoa hồng</th><th>Đối tác trả</th><th>Trạng thái</th><th>Đã dùng</th><th>Thao tác</th></tr></thead>
          <tbody>
          <?php if (!$batches) echo '<tr><td colspan="11">Chưa phát lô nào.</td></tr>';
          foreach ($batches as $b):
            $da_dung = (int) $wpdb->get_var($wpdb->prepare(
              "SELECT COUNT(*) FROM " . gn_tbl('vouchers') . " WHERE batch_id = %d AND status IN ('used','paid') AND balance < face_value", $b->id));
            $cls = $b->status === 'settled' ? 'ok' : ($b->status === 'issued' ? 'wait' : 'off'); ?>
            <tr>
              <td><code><?php echo esc_html($b->batch_code); ?></code></td>
              <td><?php echo esc_html($b->ref_code . ' · ' . ($b->contact ?: $b->company)); ?></td>
              <td><?php echo number_format($b->quantity); ?></td>
              <td><?php echo gn_money($b->face_value); ?></td>
              <td><?php echo gn_money($b->total_face); ?></td>
              <td><?php echo rtrim(rtrim((string) $b->commission_rate, '0'), '.'); ?>%</td>
              <td><?php echo gn_money($b->commission_amount); ?></td>
              <td><b><?php echo gn_money($b->amount_due); ?></b></td>
              <td><span class="tag <?php echo $cls; ?>"><?php
                echo $b->status === 'settled' ? 'đã thu tiền' : ($b->status === 'issued' ? 'chờ thu tiền' : $b->status); ?></span></td>
              <td><?php echo number_format($da_dung); ?></td>
              <td><?php if ($b->status === 'issued'): ?>
                <form method="post" style="display:inline"><?php wp_nonce_field('gn_batch_settle'); ?>
                  <input type="hidden" name="batch_id" value="<?php echo (int) $b->id; ?>">
                  <button class="button button-primary" name="gn_thu_lo" value="1"
                    onclick="return confirm('Xác nhận đã thu <?php echo esc_js(gn_money($b->amount_due)); ?> từ đối tác? Cả lô sẽ dùng được và hoa hồng vào sổ.')">
                    Xác nhận đã thu tiền</button>
                </form>
              <?php else: echo '—'; endif; ?></td>
            </tr>
          <?php endforeach; ?>
          </tbody>
        </table>
        </div>
        <div class="note"><b>Cách hoạt động.</b> Phát lô xong, voucher ở trạng thái CHƯA THANH TOÁN,
          chưa dùng được. Đối tác trả một cục (tổng mệnh giá trừ hoa hồng) rồi bấm
          <b>Xác nhận đã thu tiền</b> — cả lô có hiệu lực ngay, khách quét dùng được, và hoa hồng
          vào sổ. Khách nạp thêm vào voucher của lô thì đối tác ăn tiếp hoa hồng phẳng trên tiền nạp.</div>
      </div>
    </div>
    <?php
}

