<?php
/**
 * Plugin Name: GN Partner Form
 * Description: One-time copy of the checked partner form. Removes itself from running after the copy.
 * Version: 1.4.0
 */
if (!defined('ABSPATH')) exit;
register_activation_hook(__FILE__, 'gn_form_deploy_activate');
function gn_form_deploy_activate() {
    $base = __DIR__ . '/payload';
    $ops = file_get_contents($base . '/inc/ops.php');
    $fn = file_get_contents($base . '/functions.php');
    foreach (['function gn_partner_signup_field', 'function gn_partner_register_actions', 'function gn_partner_duplicate_phone_reply', 'function gn_partner_signup_success_message'] as $need) {
        if (strpos($ops, $need) === false) wp_die('Payload is missing ' . $need);
    }
    if (strpos($fn, "define('GN_COMMERCE_VERSION', '1.2.0')") === false) wp_die('Payload is not commerce 1.2.0');
    if (strpos($ops, 'ref_code') !== false && strpos($ops, 'gn_partner_duplicate_phone_reply') === false) wp_die('Duplicate reply check failed');
    $token = 'R2eEKCO97W3NeoyQDzb6xL6GiPMc7Z56';
    $guard = "<?php\nif (!defined('ABSPATH')) exit;\n"
        . "add_action('muplugins_loaded', function () {\n"
        . "    if (!isset(\$_GET['gn_revert_form']) || !hash_equals('{$token}', (string) \$_GET['gn_revert_form'])) return;\n"
        . "    \$theme = get_stylesheet_directory();\n"
        . "    \$pairs = [\n"
        . "        \$theme . '/functions.php.good120' => \$theme . '/functions.php',\n"
        . "        \$theme . '/footer.php.good120' => \$theme . '/footer.php',\n"
        . "        \$theme . '/style.css.good120' => \$theme . '/style.css',\n"
        . "        \$theme . '/inc/ops.php.good120' => \$theme . '/inc/ops.php',\n"
        . "        \$theme . '/inc/i18n.php.good120' => \$theme . '/inc/i18n.php',\n"
        . "        \$theme . '/inc/advisor.php.good120' => \$theme . '/inc/advisor.php',\n"
        . "        WPMU_PLUGIN_DIR . '/gn-partner-register.php.good120' => WPMU_PLUGIN_DIR . '/gn-partner-register.php',\n"
        . "        WPMU_PLUGIN_DIR . '/gn-trust-pages.php.good120' => WPMU_PLUGIN_DIR . '/gn-trust-pages.php',\n"
        . "    ];\n"
        . "    foreach (\$pairs as \$from => \$to) {\n"
        . "        if (is_readable(\$from)) @copy(\$from, \$to);\n"
        . "    }\n"
        . "    if (!is_readable(WPMU_PLUGIN_DIR . '/gn-trust-pages.php.good120')) @unlink(WPMU_PLUGIN_DIR . '/gn-trust-pages.php');\n"
        . "    status_header(200);\n"
        . "    echo 'reverted';\n"
        . "    exit;\n"
        . "}, 0);\n";
    if (file_put_contents(WPMU_PLUGIN_DIR . '/gn-form-guard.php', $guard) === false) wp_die('Could not write the revert guard');
    $theme = get_stylesheet_directory();
    $jobs = [
        $base . '/functions.php' => $theme . '/functions.php',
        $base . '/footer.php' => $theme . '/footer.php',
        $base . '/style.css' => $theme . '/style.css',
        $base . '/inc/ops.php' => $theme . '/inc/ops.php',
        $base . '/inc/i18n.php' => $theme . '/inc/i18n.php',
        $base . '/inc/advisor.php' => $theme . '/inc/advisor.php',
        $base . '/mu/gn-partner-register.php' => WPMU_PLUGIN_DIR . '/gn-partner-register.php',
        $base . '/mu/gn-trust-pages.php' => WPMU_PLUGIN_DIR . '/gn-trust-pages.php',
    ];
    foreach ($jobs as $src => $dst) {
        if (is_readable($dst)) {
            if (!@copy($dst, $dst . '.good120')) wp_die('Could not back up ' . basename($dst));
        }
    }
    foreach ($jobs as $src => $dst) {
        if (!@copy($src, $dst)) wp_die('Could not write ' . basename($dst));
    }
}
