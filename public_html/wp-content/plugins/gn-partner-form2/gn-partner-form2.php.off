<?php
/**
 * Plugin Name: GN Partner Form 2
 * Description: Copies the checked partner form and records a fatal error if the next request breaks.
 * Version: 1.4.2
 */
if (!defined('ABSPATH')) exit;
register_activation_hook(__FILE__, 'gn_form2_activate');
function gn_form2_activate() {
    $base = __DIR__ . '/payload';
    $ops = file_get_contents($base . '/inc/ops.php');
    $fn = file_get_contents($base . '/functions.php');
    if (!is_string($ops) || strpos($ops, 'function gn_partner_signup_field') === false) wp_die('Payload ops is incomplete');
    if (!is_string($fn) || strpos($fn, "define('GN_COMMERCE_VERSION', '1.2.0')") === false) wp_die('Payload is not commerce 1.2.0');
    $token = 'R2eEKCO97W3NeoyQDzb6xL6GiPMc7Z56';
    $guard = <<<'GUARD'
<?php
if (!defined('ABSPATH')) exit;
register_shutdown_function(function () {
    $e = error_get_last();
    if (!$e || !in_array($e['type'], array(E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR, E_USER_ERROR), true)) return;
    $msg = $e['message'] . ' in ' . $e['file'] . ':' . $e['line'];
    $dir = WP_CONTENT_DIR . '/uploads';
    if (!is_dir($dir)) @mkdir($dir, 0755, true);
    @file_put_contents($dir . '/gn-last-error.txt', $msg);
    $theme = get_stylesheet_directory();
    $pairs = array(
        $theme . '/functions.php.good120' => $theme . '/functions.php',
        $theme . '/footer.php.good120' => $theme . '/footer.php',
        $theme . '/style.css.good120' => $theme . '/style.css',
        $theme . '/inc/ops.php.good120' => $theme . '/inc/ops.php',
        $theme . '/inc/i18n.php.good120' => $theme . '/inc/i18n.php',
        $theme . '/inc/advisor.php.good120' => $theme . '/inc/advisor.php',
        WPMU_PLUGIN_DIR . '/gn-partner-register.php.good120' => WPMU_PLUGIN_DIR . '/gn-partner-register.php',
        WPMU_PLUGIN_DIR . '/gn-trust-pages.php.good120' => WPMU_PLUGIN_DIR . '/gn-trust-pages.php',
    );
    foreach ($pairs as $from => $to) {
        if (is_readable($from)) @copy($from, $to);
    }
});
add_action('muplugins_loaded', function () {
    if (!isset($_GET['gn_revert_form']) || !hash_equals('TOKEN', (string) $_GET['gn_revert_form'])) return;
    $theme = get_stylesheet_directory();
    $pairs = array(
        $theme . '/functions.php.good120' => $theme . '/functions.php',
        $theme . '/footer.php.good120' => $theme . '/footer.php',
        $theme . '/style.css.good120' => $theme . '/style.css',
        $theme . '/inc/ops.php.good120' => $theme . '/inc/ops.php',
        $theme . '/inc/i18n.php.good120' => $theme . '/inc/i18n.php',
        $theme . '/inc/advisor.php.good120' => $theme . '/inc/advisor.php',
        WPMU_PLUGIN_DIR . '/gn-partner-register.php.good120' => WPMU_PLUGIN_DIR . '/gn-partner-register.php',
        WPMU_PLUGIN_DIR . '/gn-trust-pages.php.good120' => WPMU_PLUGIN_DIR . '/gn-trust-pages.php',
    );
    foreach ($pairs as $from => $to) {
        if (is_readable($from)) @copy($from, $to);
    }
    status_header(200);
    echo 'reverted';
    exit;
}, 0);
GUARD;
    $guard = str_replace('TOKEN', $token, $guard);
    if (file_put_contents(WPMU_PLUGIN_DIR . '/gn-form-guard.php', $guard) === false) wp_die('Could not write the guard');
    $theme = get_stylesheet_directory();
    $jobs = array(
        $base . '/functions.php' => $theme . '/functions.php',
        $base . '/footer.php' => $theme . '/footer.php',
        $base . '/style.css' => $theme . '/style.css',
        $base . '/inc/ops.php' => $theme . '/inc/ops.php',
        $base . '/inc/i18n.php' => $theme . '/inc/i18n.php',
        $base . '/inc/advisor.php' => $theme . '/inc/advisor.php',
        $base . '/mu/gn-partner-register.php' => WPMU_PLUGIN_DIR . '/gn-partner-register.php',
        $base . '/mu/gn-trust-pages.php' => WPMU_PLUGIN_DIR . '/gn-trust-pages.php',
    );
    foreach ($jobs as $dst) {
        if (is_readable($dst) && !@copy($dst, $dst . '.good120')) wp_die('Could not back up ' . basename($dst));
    }
    foreach ($jobs as $srcf => $dst) {
        if (!@copy($srcf, $dst)) wp_die('Could not write ' . basename($dst));
    }
}
