<?php
/**
 * Plugin Name: Ganh Ngon Theme Deploy
 * Description: One-time copy of the updated ganhngon-restaurant theme files and MU plugins. Safe to delete after it runs.
 * Version: 1.3.0
 */
if (!defined('ABSPATH')) {
    exit;
}

register_activation_hook(__FILE__, 'gn_theme_deploy_run');

function gn_theme_deploy_copy_tree($src, $dest, &$count, $label) {
    if (!is_dir($src)) {
        update_option('gn_theme_deploy_status', 'missing-dir:' . $label);
        return false;
    }
    if (!is_dir($dest) && !mkdir($dest, 0755, true)) {
        update_option('gn_theme_deploy_status', 'mkdir-failed:' . $label);
        return false;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS)
    );
    foreach ($iterator as $file) {
        if (!$file->isFile()) {
            continue;
        }
        $rel = substr($file->getPathname(), strlen($src) + 1);
        $target = $dest . '/' . $rel;
        $dir = dirname($target);
        if (!is_dir($dir) && !mkdir($dir, 0755, true)) {
            update_option('gn_theme_deploy_status', 'mkdir-failed:' . $label . '/' . $rel);
            return false;
        }
        if (!copy($file->getPathname(), $target)) {
            update_option('gn_theme_deploy_status', 'copy-failed:' . $label . '/' . $rel);
            return false;
        }
        $count++;
    }
    return true;
}

function gn_theme_deploy_run() {
    $base = plugin_dir_path(__FILE__);
    $theme_count = 0;
    $mu_count = 0;

    if (!gn_theme_deploy_copy_tree(
        $base . 'payload',
        get_theme_root() . '/ganhngon-restaurant',
        $theme_count,
        'theme'
    )) {
        return;
    }

    if (!defined('WPMU_PLUGIN_DIR')) {
        update_option('gn_theme_deploy_status', 'missing-dir:mu');
        return;
    }
    if (!gn_theme_deploy_copy_tree(
        $base . 'mu',
        WPMU_PLUGIN_DIR,
        $mu_count,
        'mu'
    )) {
        return;
    }

    update_option('gn_theme_deploy_status', 'ok:' . $theme_count . '+mu:' . $mu_count);
}
